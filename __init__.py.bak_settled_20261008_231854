# O1 (t_d552a09f): explicit filemem_supersede + (b) validity window.
#
# The LLM face of O1 = ONE tool schema + ONE dispatch, both of which the host
# main-model invokes through the EXISTING shared host channel (零 new provider /
# model config / api key / task key). The tool handler itself is a deterministic
# write-side stamp (ZERO LLM): it creates the new (correcting) row + marks the
# old row superseded, BYPASSING EP-1's 0.5 Jaccard gate (the author's intent IS
# the authoritative lineage link — the one delta vs automatic stamping). The pair
# then walks the EXISTING EP-2 confirm flow (candidate -> confirmed); O1 does not
# re-build that face, it feeds it.
#
# (b) validity: a correcting row can carry a short-term authority window
# (validity_scope in {session, day, permanent} + a concrete valid_until, both in
# MemoryItem.metadata). The read-side lapse check is ONE pure predicate shared by
# the auto-inject face; legacy rows (no validity keys) never lapse and never
# KeyError. The auto face folds out superseded (①) + lapsed rows; the explicit
# search face keeps both readable (audit). Everything here is pure stdlib, zero
# LLM, zero new model/API/key.
# ---------------------------------------------------------------------------

# (b) validity scopes (minimal set, owner 钉): permanent = no expiry; session /
# day = a short-term authority that lapses by the end of the row's creating UTC
# day. Both short-term scopes resolve to ONE concrete valid_until so the read-side
# lapse check is a single pure predicate regardless of which scope set it.
_O1_VALIDITY_SCOPES = ("session", "day", "permanent")


def _o1_valid_until_for_scope(scope: Optional[str], created_at_iso: str) -> Optional[str]:
    """Resolve a validity scope to an absolute UTC valid_until ISO string at
    write time (deterministic, derived from the row's created_at so two
    processes diff identically). permanent -> None (never lapses); session/day
    -> end-of-day (23:59:59) of the creating UTC calendar day. An unknown scope
    degrades to 'day' (a finite short horizon, never infinite — fail-safe)."""
    scope = str(scope or "permanent").strip()
    if scope not in _O1_VALIDITY_SCOPES:
        scope = "day"
    if scope == "permanent":
        return None
    try:
        d = datetime.fromisoformat(str(created_at_iso)).date()
    except (TypeError, ValueError):
        d = _utcnow().date()  # corrupt/absent created_at -> fall back to today
    return datetime(d.year, d.month, d.day, 23, 59, 59).isoformat()


def _row_is_lapsed(row: Dict[str, Any], now: Optional["datetime"] = None) -> bool:
    """(b) read-side validity-lapse predicate (pure, zero LLM, fail-open).

    A row lapses iff it carries a CONCRETE valid_until AND now > valid_until.
    A 'permanent' scope / a missing or corrupt valid_until / a legacy row with
    NO validity keys -> not lapsed (backward compat, never KeyError, never
    drops recall on a shape hiccup)."""
    if not isinstance(row, dict):
        return False
    meta = row.get("metadata")
    if not isinstance(meta, dict):
        return False
    if meta.get("validity_scope") == "permanent":
        return False
    valid_until = meta.get("valid_until")
    if not valid_until:
        return False  # no concrete horizon (legacy / permanent) -> still active
    now = now or _utcnow()
    try:
        return now > datetime.fromisoformat(str(valid_until))
    except (TypeError, ValueError):
        return False  # fail-open: a corrupt valid_until never drops a row


def _o1_fold_out_of_auto(row: Dict[str, Any], now: Optional["datetime"] = None) -> bool:
    """O1 ① auto-face fold-out predicate (pure, zero LLM, no I/O).

    TRUE iff the row must be folded OUT of the auto-inject face — and NEVER
    out of the explicit search face or the audit:

      * superseded — ``metadata.superseded`` truthy (the EP-1 save-door, the
        O1 explicit supersede, OR an EP-2-confirmed row all write this key;
        the read side keys only on it, so a superseded row leaves the
        auto-inject pool once, regardless of which face stamped it).
      * lapsed — a (b) validity window whose concrete ``valid_until`` is
        already past (``_row_is_lapsed``); a short-term override has expired.

    Legacy rows carry NEITHER key -> ``False`` (no fold, byte-identical
    auto-inject behavior, the EP-1 regression gate). A non-dict row or a
    shape hiccup fails OPEN (no fold) — a fold bug must never drop recall.
    """
    try:
        if not isinstance(row, dict):
            return False
        if (row.get("metadata") or {}).get("superseded"):
            return True
        # settled（半自动 confirm 确认态）折出 auto-inject：该条已定案、结论落定，
        # 生命周期到头——不再作为有效上下文被反复回喂，但内容留在盘可 audit。
        # settled_candidate【不折出】（owner 拍的①）：纯自动提名只标记，等 confirm
        # 拍板转 settled 才真正折出，防误杀半程卡。
        if (row.get("metadata") or {}).get("settled"):
            return True
        return _row_is_lapsed(row, now)
    except Exception:  # pragma: no cover - fail-open
        return False


# ---------------------------------------------------------------------------
# SEC-1-2: injection-face trust gate (T1: pure function, zero LLM, no I/O).
#
# 语义（specs/SEC-1-2-impl-notes.md 裁决 1）:
#   * 存储面（SEC-1-1，不动）: 缺/坏 origin = unknown/low = 不信任（写侧保守）.
#   * 注入面（本 gate）: 缺 metadata.origin = "未标记"，默认放行 — episodic
#     池行不带 metadata（155 条活数据），按 unknown/low drop 会大面积回归.
#     只有明确 stamped trust="low" 才 drop 出自动注入；drop_unknown_trust
#     （默认 False）锁死这个消歧，防未来误收紧.
#   * 命中 directive_patterns（config 驱动多语言表 en/zh，改表不改码，代码
#     零硬编码中文）的 content 不 drop：标 directive-quote，由宿主渲染成
#     引用块（quote_delims）按"引用"而非"指令"解读.
# 脏 shape（item/metadata/origin 非 dict、trust/content 非 str、cfg 缺失、
# 表里坏正则）在本函数内全部防御为缺省放行，绝不炸；调用方（T2 接线）再
# 套一层 try/except -> ("allow", None) 兜底（规则 6，fail-soft 不锁宿主）.
# ---------------------------------------------------------------------------


def injection_gate_decision(item, injection_cfg) -> "tuple[str, Optional[str]]":
    """SEC-1-2: pure trust/directive verdict for one pool row.

    Returns (action, mark): action in {"drop", "allow"}, mark in
    {None, "untrusted-origin", "directive-quote"}.  Rules, in order
    (pure ``re`` + dict reads, zero LLM):

      1. trust = ((item.get("metadata") or {}).get("origin") or {}).get("trust")
      2. trust == "low" and NOT low_trust_auto_inject
            -> ("drop", "untrusted-origin")
      3. trust is None (unmarked) and drop_unknown_trust
            -> ("drop", "untrusted-origin")
         (default False -> unmarked passes; locks the 155-row episodic
         pool regression out)
      4. content matches any directive_patterns entry (re.search, re.I)
            -> ("allow", "directive-quote")
      5. otherwise -> ("allow", None)
      6. this function is exception-guarded internally (dirty shape
         degrades to rule 5); callers still wrap in try/except as the
         final fail-soft (T2).
    """
    cfg = injection_cfg if isinstance(injection_cfg, dict) else {}
    low_trust_auto_inject = bool(cfg.get("low_trust_auto_inject", False))
    drop_unknown_trust = bool(cfg.get("drop_unknown_trust", False))

    # Rule 1: read trust defensively (non-dict metadata/origin -> None).
    item_meta = item.get("metadata") if isinstance(item, dict) else None
    trust = None
    if isinstance(item_meta, dict):
        origin = item_meta.get("origin")
        if isinstance(origin, dict):
            trust = origin.get("trust")

    # Rule 2: explicit low stamp (the only drop by default).
    if trust == "low" and not low_trust_auto_inject:
        return ("drop", "untrusted-origin")

    # Rule 3: unmarked — 缺省放行（裁决 1），除非开关收紧.
    if trust is None and drop_unknown_trust:
        return ("drop", "untrusted-origin")

    # Rule 4: directive pattern hit (config-driven table; per-entry
    # re.error guard so one bad pattern can't crash the gate).
    content = item.get("content") if isinstance(item, dict) else None
    if isinstance(content, str) and content:
        patterns = cfg.get("directive_patterns")
        if isinstance(patterns, dict):
            for _lang, _pats in patterns.items():
                if not isinstance(_pats, (list, tuple)):
                    continue
                for pat in _pats:
                    if not isinstance(pat, str) or not pat:
                        continue
                    try:
                        if re.search(pat, content, re.I):
                            return ("allow", "directive-quote")
                    except re.error:
                        continue  # bad regex in config: skip entry, never raise
    # Rule 5: default pass-through.
    return ("allow", None)


class MemoryItem:
    """A single memory item with tiered storage.

    EP-1 data contract (lineage): `supersedes`/`related_to` are stored in
    `metadata` (not new top-level columns — legacy rows load via from_dict
    with the key simply absent = empty list, backward compatible).
    """

    def __init__(
        self,
        id: str,
        type: str,
        content: str,
        category: Optional[str] = None,
        level: str = "L0",
        metadata: Optional[Dict[str, Any]] = None,
        created_at: str = "",
        updated_at: str = "",
        occurred_at: Optional[str] = None,
        source: str = "",
        reference_count: int = 0,
        last_referenced: str = "",
        ttl_days: Optional[int] = None,
        salience: float = 0.5,
        origin: Optional[Dict[str, str]] = None,
        supersedes: Optional[List[str]] = None,
        related_to: Optional[List[str]] = None,
    ):
        self.id = id
        self.type = type
        self.content = content
        self.category = category
        self.level = level
        self.metadata = metadata or {}
        # SEC-1-1: deterministic origin trust stamp {kind, trust} — stored in
        # metadata (not a new column: 72+155 live rows load via from_dict,
        # a top-level column would just add surface area); default
        # unknown/low (fail-safe lowest trust, never guess high).
        self.origin = origin or UNKNOWN_TRUST_STAMP
        self.created_at = created_at
        self.updated_at = updated_at
        # SA2-1: event date (when the record's EVENT happened), naive-UTC ISO
        # same convention as created_at; None = undetectable -> consumers
        # fall back to created_at.
        self.occurred_at = occurred_at
        self.source = source
        self.salience = salience
        self.reference_count = reference_count
        self.last_referenced = last_referenced
        self.ttl_days = ttl_days or TTL_CONFIG.get(level, {}).get("ttl_days")
        # EP-1: lineage fields (supersedes / related_to) live in `metadata` —
        # the same region as the SEC-1-1 origin stamp; no new top-level column
        # (legacy rows load via from_dict with the key simply absent = empty
        # list, 向后兼容). The constructor args are a write convenience: the
        # canonical storage is self.metadata, which to_dict/from_dict carry.
        self.supersedes = list(supersedes or [])
        self.related_to = list(related_to or [])
        if self.supersedes:
            self.metadata.setdefault("supersedes", self.supersedes)
        if self.related_to:
            self.metadata.setdefault("related_to", self.related_to)

    def to_dict(self) -> Dict[str, Any]:
        return {
            "id": self.id,
            "type": self.type,
            "content": self.content,
            "category": self.category,
            "level": self.level,
            "metadata": self.metadata,
            "created_at": self.created_at,
            "updated_at": self.updated_at,
            "occurred_at": self.occurred_at,
            "source": self.source,
            "reference_count": self.reference_count,
            "salience": self.salience,
            "last_referenced": self.last_referenced,
            "ttl_days": self.ttl_days,
        }

    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> "MemoryItem":
        # SEC-1-1: legacy rows (pre-backfill) carry NO metadata.origin key —
        # normalize it on read with the SAME deterministic source mapping the
        # backfill uses (never a crash; unmappable source -> unknown/low
        # fail-safe, 不猜高 / never guess high). A malformed stored origin is
        # re-stamped the same way; a well-formed one is kept verbatim. The
        # input dict is never mutated (a copy is normalized).
        _meta = dict(data.get("metadata") or {})
        _stamp_origin_in_meta(_meta, data.get("source", ""))
        # EP-1: lineage keys read back from the SAME normalized metadata copy —
        # absent (legacy row) -> empty lists, 向后兼容 / never KeyError.
        return cls(
            id=data.get("id", ""),
            type=data.get("type", ""),
            content=data.get("content", ""),
            category=data.get("category"),
            level=data.get("level", "L0"),
            metadata=_meta,
            created_at=data.get("created_at", ""),
            updated_at=data.get("updated_at", ""),
            # SA2-1: key absent on pre-backfill rows -> None (backward compat,
            # same fall-back-to-created_at semantics as new misses).
            occurred_at=data.get("occurred_at"),
            source=data.get("source", ""),
            reference_count=data.get("reference_count", 0),
            salience=data.get("salience", 0.5),
            last_referenced=data.get("last_referenced", ""),
            ttl_days=data.get("ttl_days"),
            origin=_meta.get("origin"),
            supersedes=list(_meta.get("supersedes") or []),
            related_to=list(_meta.get("related_to") or []),
        )

    def is_expired(self) -> bool:
        """Check if memory has exceeded its TTL."""
        if not self.ttl_days:
            return False
        try:
            created = datetime.fromisoformat(self.created_at)
            return _utcnow() > created + timedelta(days=self.ttl_days)
        except:
            return False

    def is_stale(self) -> bool:
        """Check if memory is stale (not referenced for long time)."""
        if not self.last_referenced or not self.ttl_days:
            return False
        try:
            last_ref = datetime.fromisoformat(self.last_referenced)
            warning_days = TTL_CONFIG.get(self.level, {}).get("warning_threshold_days", 14)
            return _utcnow() > last_ref + timedelta(days=warning_days)
        except:
            return False


def _load_llm_caller():
    """Load consolidation/llm_caller.py by path (plugin loads outside package context)."""
    import importlib.util
    p = Path(__file__).parent / "consolidation" / "llm_caller.py"
    spec = importlib.util.spec_from_file_location("_fm_llm_caller", p)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

class MemoryTriggerRouter:
    """Multi-language trigger router for memory classification."""

    def __init__(self):
        self.patterns = TRIGGER_PATTERNS
        self._compiled_patterns: Dict[str, Dict[str, re.Pattern]] = {}
        self._build_patterns()

    def _build_patterns(self):
        """Pre-compile regex patterns for all languages."""
        for level, categories in self.patterns.items():
            self._compiled_patterns[level] = {}
            for cat_name, cat_config in categories.items():
                # Extract patterns dict and config separately
                if "patterns" in cat_config:
                    lang_patterns = cat_config["patterns"]
                    # Store config separately
                    self._compiled_patterns[level][f"{cat_name}_config"] = {k: v for k, v in cat_config.items() if k != "patterns"}
                    # Compile patterns for each language
                    for lang, words in lang_patterns.items():
                        # Use different patterns for CJK vs Latin
                        if lang in ['zh', 'ja']:
                            # CJK languages: no word boundaries
                            pattern_str = "(" + "|".join(re.escape(w) for w in words) + ")"
                        else:
                            # Latin languages: use word boundaries
                            pattern_str = r"\b(" + "|".join(re.escape(w) for w in words) + r")\b"
                        self._compiled_patterns[level][f"{lang}_{cat_name}"] = re.compile(
                            pattern_str, re.IGNORECASE
                        )

    def detect_and_route(self, message: str) -> Dict[str, Any]:
        """Detect language and route to appropriate memory level."""
        detected_lang = self._detect_language(message)

        for level in MEMORY_LEVELS:
            config = self.patterns[level]
            for cat_name, cat_config in config.items():
                # Check if this category has patterns for the detected language
                pattern_key = f"{detected_lang}_{cat_name}"
                if pattern_key in self._compiled_patterns[level]:
                    match = self._compiled_patterns[level][pattern_key].search(message)
                    if match:
                        # Get config from the stored config
                        config_key = f"{cat_name}_config"
                        stored_config = self._compiled_patterns[level].get(config_key, {})
                        return {
                            "level": level,
                            "language": detected_lang,
                            "matched_keywords": [match.group(1)],
                            "auto_save": stored_config.get("auto_save", False),
                            "confirm_at_end": stored_config.get("confirm_at_end", False),
                            "confirm_explicit": stored_config.get("confirm_explicit", False),
                            "confidence_threshold": stored_config.get("confidence_threshold", 0.8),
                        }

        return {"level": None}

    def _detect_language(self, text: str) -> str:
        """Simple language detection based on character ranges."""
        has_katakana = any("\u30a0" <= c <= "\u30ff" for c in text)
        has_hiragana = any("\u3040" <= c <= "\u309f" for c in text)
        has_chinese = any("\u4e00" <= c <= "\u9fff" for c in text)
        has_spanish = any(c in "áéíóúñü" for c in text.lower())

        # Japanese has katakana/hiragana
        if has_katakana or has_hiragana:
            return "ja"
        # Chinese has CJK unified ideographs (and may have some overlap)
        if has_chinese:
            return "zh"
        # Spanish has accented characters
        if has_spanish:
            return "es"
        return "en"


# ── Negative-example detection (v1, mechanical, zero LLM) ─────────────────────
# Borrowed from the retired demo-intent idea, rebuilt local-first: mark tool
# failures on the trace line + auto-saved memory metadata, and surface a
# one-line negative lesson on recall. No new consumer file, no external deps.
_UNTRUSTED_WRAP_RE = re.compile(
    r"<untrusted_tool_result[^>]*>\n?(.*?)</untrusted_tool_result>",
    re.DOTALL | re.IGNORECASE,
)
_TOOL_ERROR_MARKERS = (
    re.compile(r"Traceback\s*[\(:]"),
    re.compile(r'"exit_code"\s*:\s*([1-9]\d*)'),
    re.compile(r"HTTP\s+[45]\d\d"),
    re.compile(r"\bStatus[:=]?\s*[45]\d\d\b"),
    re.compile(r'"error"\s*:\s*"([^"]+)"'),
)


def _untrusted_inner(content):
    """Strip the <untrusted_tool_result> framing + elision notice so the
    wrapper text is never mistaken for an error signal (framing has none,
    but truncation can hide the real marker — scan the inner body only)."""
    if not isinstance(content, str):
        return "" if content is None else str(content)
    m = _UNTRUSTED_WRAP_RE.search(content)
    return m.group(1) if m else content


def _tool_result_is_error(content) -> bool:
    body = _untrusted_inner(content)
    if not isinstance(body, str) or not body:
        return False
    for rx in _TOOL_ERROR_MARKERS:
        m = rx.search(body)
        if not m:
            continue
        return True
    return False


def _error_ctx(tool: str, content, limit: int = 200) -> str:
    body = _untrusted_inner(content)
    if not isinstance(body, str):
        body = str(content)
    m = re.search(
        r'Traceback[^\n]*|"exit_code"\s*:\s*\d+|HTTP\s+[45]\d\d[^\n]*|"error"\s*:\s*[^,\n]+',
        body,
    )
    snippet = (m.group(0) if m else body).strip()
    return f"{tool}: {snippet}"[:limit]


def _tool_args_key(tc) -> str:
    """Stable key for a tool call: name + canonical argument JSON."""
    fn = (tc or {}).get("function") or {}
    name = fn.get("name") or (tc or {}).get("name") or ""
    a = fn.get("arguments")
    if a is None:
        return name
    if isinstance(a, str):
        try:
            a = json.loads(a)
        except Exception:
            return f"{name}:{a[:64]}"
    return f"{name}:{json.dumps(a, sort_keys=True)[:64]}"


def detect_turn_failures(history, recent):
    """Mechanical negative-example detection over a delta of conversation.

    Flags ``tool_error`` (a tool result that carries an error marker) and
    ``retry_loop`` (re-issuing a previously-failed key that fails again —
    the prior-error-narrowed form, so legal re-reads/polls stay silent).
    ``recent`` is a bounded per-session deque of previously-failed keys; it
    is mutated in place so a later successful retry clears the prior error.

    Pure: no provider state, no LLM, no I/O. Callers pass only the turn's
    delta (Reviewer gate ⑥ — not the whole session).
    """
    if recent is None:
        recent = deque(maxlen=20)
    failures = []
    if not isinstance(history, (list, tuple)) or not history:
        return failures
    # Map tool_call_id -> args key from the assistant tool_calls so each tool
    # result can be keyed by (tool + arguments), not just tool name.
    args_by_cid: Dict[str, str] = {}
    for m in history:
        if isinstance(m, dict) and m.get("role") == "assistant":
            for tc in (m.get("tool_calls") or []):
                cid = tc.get("id")
                if cid:
                    args_by_cid[cid] = _tool_args_key(tc)
    for msg in history:
        if not isinstance(msg, dict) or msg.get("role") != "tool":
            continue
        name = msg.get("tool_name") or msg.get("name") or ""
        cid = msg.get("tool_call_id")
        key = args_by_cid.get(cid) or f"{name}:?"
        content = msg.get("content", "")
        is_err = _tool_result_is_error(content)
        ctx = _error_ctx(name, content)
        if is_err:
            failures.append({"type": "tool_error", "tool": name, "key": key, "ctx": ctx})
        if is_err and key in recent:
            failures.append({"type": "retry_loop", "tool": name, "key": key, "ctx": ctx})
        if is_err:
            if key in recent:
                recent.remove(key)
            recent.append(key)
        elif key in recent:
            recent.remove(key)  # a successful retry clears the prior failure
    return failures


class FileMemProvider(MemoryProvider):
    """File-based memory provider with keyword-overlap search and tiered storage."""

    name = "filemem"
    pre_compress_checkpoint_api_version = 2

    def __init__(self):
        self.hermetis_home: Optional[Path] = None
        self.session_id: Optional[str] = None
        self.storage_dir: Path = DEFAULT_MEMORY_DIR
        self.memories_dir: Path = DEFAULT_MEMORIES_DIR

        # Config
        self.auto_extract = True
        self.min_search_score = 0.3  # Relevance gate for keyword-overlap × decay scores (range [0,1]).
                                     # 0.3 filters ~23% of multi-word queries (data: M4 gate probe).
        self._last_save_time: float = 0  # Rate limiting for saves
        self._save_interval = 30  # Minimum seconds between saves
        self._session_save_count: int = 0  # Track saves per session
        # M2: per-batch cap on *new* entries per memory-type through the extraction
        # choke-point, so a single flush can't flood the lake (matches the single
        # path's 20-cap in spirit; kept deliberately tight).
        self._session_save_count_max: int = 5

        # Components
        self._decay: Dict[str, Any] = {}
        # LLM pass: write-side distillation budget.
        self._distill_call_limit: int = 5
        self._distill_budget: Dict[str, int] = {}

        # t_090d6f3d: type-classification fallback budget. The LLM reclassify
        # face only fires on a regex `fact`-miss (a content that matched no
        # en/zh strong-signal type row), upgrades that item's shard type, and
        # rewrites the row to the LLM-chosen shard at the save door. Per-
        # session cap (default 5, tunable via decay.json memory_type.llm_per_
        # session; 0 or a missing/invalid budget = feature off -> regex-only,
        # the exact legacy behavior = a clean rollback). Runs OUTSIDE the
        # write lock (a host LLM call must not sit inside a held flock);
        # fail-soft: no main_runtime / over-cap / any host failure keeps the
        # regex `fact` verdict.
        self._type_classify_limit: int = 5
        self._type_classify_budget: Dict[str, int] = {}

        self._llm_ctx = None
        # LLM 显式化◎ (t_32980f71): the host main_runtime snapshot (dict
        # {model, provider, base_url, api_key, api_mode} captured at
        # register() time, or None in standalone / non-host environments —
        # the LLM faces keep today's exact skip semantics in that case).
        # Epic card 2's 5 LLM call sites pass this to the host LLM facade
        # instead of relying on the implicit _RUNTIME_MAIN_CONTEXT.
        self._main_runtime = None
        # S1b F1/F4: consolidation-tick throttle state (per provider
        # instance — the interval gate is "at most one tick per
        # consolidation_interval_min per instance"; _last_skip_audit_ts is
        # the SEPARATE throttle for the tick_skip audit rows themselves,
        # so a skipped tick never floods consolidation_log every turn).
        # Both default to 0.0 = "never ran" -> first boundary spawns.

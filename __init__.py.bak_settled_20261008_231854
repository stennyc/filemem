# ── P0-1 write-side ingress gate (shared-store 清染, 防再染) ─────────────────
# The shared neutral store (~/.hermes/filemem) aggregates every profile + cron.
# Three content classes have been proven to leak into memories/*.json and later
# re-inject stale task content via the pre_llm_call auto-recall (the 20261005
# default-session 4d-crawler anchoring incident):
#   (a) host / cron instruction-block prefixes
#       ([CONTEXT COMPACTION …], [IMPORTANT: You are running as a scheduled
#        cron job …]) — the compact/cron scaffolding, not a durable fact
#   (b) raw tool output (<untrusted_tool_result …> framing, or a bare JSON
#       tool dump via the _looks_like_tool_dump single source of truth)
#   (c) whole task prompts (>=1000 chars AND step-numbered / step-listed
#       task-type text)
# Reject = NOT written to the memory pool; the raw data is quarantined
# (rollback-able on disk) + a rejection_reason stamp + an audit row. Pure rule
# + stdlib re/len, zero LLM.
_HOST_INSTRUCTION_PREFIXES = (
    "[CONTEXT COMPACTION",
    "[IMPORTANT: You are running as a scheduled cron job",
)
_HOST_INSTRUCTION_WINDOW = 200          # match the block's OPENING only
_TOOL_OUTPUT_PREFIX = "<untrusted_tool_result"
_TASK_PROMPT_MIN_CHARS = 1000
_TASK_PROMPT_MIN_STEPS = 3

# ── settled 机制（"已定案"独立状态位，与 superseded/stale 语义分离）───────

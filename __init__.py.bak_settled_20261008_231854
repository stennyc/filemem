def _utcnow() -> "datetime":
    """Current UTC time, naive — the exact semantics of ``_utcnow()``.

    ``utcnow()`` is deprecated since py3.12 (and its 39 DeprecationWarnings
    pollute the 117 py3.14 runtime); but stored timestamps are naive-UTC ISO
    strings, so this stays naive (NOT ``now(timezone.utc)``) to keep every
    legacy comparison valid. One source of truth for all call sites.
    """
    return datetime.now(timezone.utc).replace(tzinfo=None)


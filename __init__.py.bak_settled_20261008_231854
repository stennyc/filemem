# M1/M3 single source of truth: structural markers of a *room/group transcript*
# (or system scaffolding) that must never be stored as a durable fact/preference.
# A's ingress predicate (current-turn aperture) and M1's batch-extract gate both
# reference THIS table so two reject-lists can't drift apart. `Group chat:` is the
# stored-text anchor WITHOUT the leading `[` — note that fact rows actually land
# as `**[**Group chat:` (bracketed), so M3's destructive predicate keys on the
# bracketed prefix, not this bare string.
META_MARKERS = (
    "Rules for this room", "Group chat:", "[System note", "new messages in the room",
    "[OUT-OF-BAND USER MESSAGE", "You are @", "(pass)", "One entry per",
)

# M1 ingress + M3 purge shared structural-opener class (single source of truth):
# a *string* that opens with { or [ is a JSON-dump, a room-transcript block, a
# quoted system/interruption note, or a member-quoted prior-context / compaction
# marker — never a durable user fact. The predicate is `lstrip()[:1] in {...}`,
# not a fixed marker list, so *all* bracket/brace openers (incl. `[member-quoted
# …]`, `[ERROR] log`, `[1,2,3]` lists) are caught in one primitive. A real fact
# may quote `[`/`{` mid-sentence (kept); only lines that OPEN with them are
# structural. This is deliberately the SAME test M3's destructive purge uses.
_NONPROSE_OPENERS = frozenset("{[")


# v2 (P2 self-test incremental gate, DE option 1 — surgical cut): room meta
# turn detection + room-marker item predicate, module-level so the ingress
# stamping path (sync_turn -> _save_memory/_add_draft/_save_memories), the
# egress filter (prefetch) and the external tagging script all reference ONE
# predicate table — the same single-source-of-truth rule META_MARKERS set up.
# A turn whose user_content OPENS with the room meta skeleton is a room meta
# turn (the observed shape of every stored self-referential item is
# `[Group chat: ...` after lstrip). A real user message may *quote* "[Group
# chat" mid-text — that stays saved; only the skeleton opener stamps.
def is_room_meta_turn(content: Optional[str]) -> bool:
    """v2 ingress: True iff this turn's user_content is a room/group meta
    skeleton. Single opener test (same shape as M3's destructive predicate on
    stored rows), no marker substring here — mid-text mentions must not
    over-stamp ordinary user content."""
    return bool(content) and content.lstrip().startswith("[Group chat")


def is_room_marker_item(content: str, metadata: Optional[Dict[str, Any]] = None) -> bool:
    """v2 G2 negative leg + G3 tagging-set selector (manifest `anchor_rules`):
    a STORED item is a room marker when its content opens the structural way
    ({/[ non-prose opener or `[Group chat` skeleton) OR carries any META_MARKERS
    substring OR the ⚠️ warn marker. `metadata.failure_type` is a SEPARATE
    selector in the manifest (the production negative examples — whitelisted
    ids are excluded by the caller, never by this predicate)."""
    t = (content or "").strip()
    if t[:1] in _NONPROSE_OPENERS:
        return True
    if any(m in t for m in META_MARKERS):
        return True
    if "⚠️" in t:
        return True
    if metadata and metadata.get("failure_type"):
        return True
    return False

# G pass: tool-dump 三键指纹({output}/{content}/{error} 顶层起始)单源谓词。

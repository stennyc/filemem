    def handle_tool_call(self, tool_name: str, args: Dict[str, Any], **kwargs) -> str:
        """Handle tool calls."""
        try:
            if tool_name == "filemem_read":
                return self._tool_read(args)
            elif tool_name == "filemem_write":
                return self._tool_write(args)
            elif tool_name == "filemem_search":
                return self._tool_search(args)
            elif tool_name == "filemem_delete":
                return self._tool_delete(args)
            elif tool_name == "filemem_supersede":
                return self._tool_supersede(args)
            elif tool_name == "filemem_review_drafts":
                return self._tool_review_drafts(args)
            else:
                return json.dumps({"error": f"Unknown tool: {tool_name}"})
        except Exception as e:
            logger.error(f"Error handling tool {tool_name}: {e}")
            return json.dumps({"error": str(e)})

    def _tool_read(self, args: Dict) -> str:
        """Read memories."""
        mem_type = args.get("type", "all")
        limit = args.get("limit", 10)

        if mem_type == "all":
            all_memories = []
            for t in MEMORY_TYPES:
                mem_file = self.memories_dir / f"{t}.json"
                if mem_file.exists():
                    with open(mem_file, "r", encoding="utf-8") as f:
                        items = json.load(f)
                        # Filter expired
                        valid = [item for item in items if not MemoryItem.from_dict(item).is_expired()]
                        all_memories.extend(valid)
            result = sorted(all_memories, key=lambda x: x.get("updated_at", x.get("created_at", "")), reverse=True)[:limit]
        else:
            mem_file = self.memories_dir / f"{mem_type}.json"
            if mem_file.exists():
                with open(mem_file, "r", encoding="utf-8") as f:
                    items = json.load(f)
                    valid = [item for item in items if not MemoryItem.from_dict(item).is_expired()]
                    result = valid[-limit:]
            else:
                result = []

        return json.dumps(result, ensure_ascii=False, indent=2)

    def _tool_write(self, args: Dict) -> str:
        """Write a memory."""
        mem_type = args.get("type")
        content = args.get("content")
        category = args.get("category")
        level = args.get("level", "L0")
        # Option C (t_de0df8b7): the write-side scope param. Default "session"
        # (a short-term row that lapses out of the auto-inject pool at the end
        # of the creating UTC day). Explicit "day" = same horizon; "permanent"
        # = a standing fact that never lapses. Threaded into _save_memory,
        # which stamps validity_scope + a derived valid_until ONLY for this
        # manual face (the auto / confirmed_draft paths keep validity_scope
        # None -> byte-identical rows).
        scope = args.get("scope", "session")

        if not mem_type or not content:
            return json.dumps({"error": "type and content are required"})

        item_id = self._save_memory(content, level=level, source="manual",
                                    validity_scope=scope)

        return json.dumps({"success": True, "id": item_id, "level": level,
                           "scope": scope})

    def _recall_and_format(self, query: str, limit: int, min_score: float,
                           profile_scope: Optional[str],
                           egress_mode: str = "auto", raw: bool = False,
                           cascade: bool = False,
                           window: Optional[Dict[str, Any]] = None,
                           mem_type: Optional[str] = None
                           ) -> "tuple[List[Dict[str, Any]], str]":
        """P0-2: unified recall pipeline — ONE retrieval path for both faces.

        Returns ``(results, hit_pool)``. ``hit_pool`` = the pool that
        ACTUALLY produced the rows: "self" (the profile_scope pool) /
        "all" (the global pool) / "empty" (a cascading call 0-hit both).
        Item-level ``source_profile`` stamps (data lineage) are untouched —
        they stay on the rows; the caller computes the envelope-level
        recall_scope (query semantics) from hit_pool. The two are
        orthogonal.

        Cascade: ``cascade=True`` + the scoped pool 0-hit -> re-query the
        global pool (profile_scope=None) ONCE. The auto face (prefetch)
        runs cascade=False by construction — it never crosses the profile
        line, and its P0-conf wide-pool pipeline stays untouched.
        egress_mode="auto" and not raw: reuse the EXISTING predicates —
        the auto-face ``_egress_cut`` drop, then the injection gate's
        untrusted-origin drop (injection_gate_decision; directive-quote
        rows are kept and already carry their search_memories
        origin_mark stamp — not re-stamped here).
        egress_mode="explicit" or raw=True: no egress — the explicit/
        inspection face returns rows as retrieved (on-disk data is
        rollback-able).
        window/mem_type are threaded into both retrieval calls so the
        explicit face's type-slice / time-window semantics survive the
        pipeline.
        """
        results = self.search_memories(query, limit=limit, min_score=min_score,
                                       profile_scope=profile_scope,
                                       window=window, mem_type=mem_type)
        hit_pool = "self" if profile_scope is not None else "all"
        if cascade and not results:
            results = self.search_memories(query, limit=limit, min_score=min_score,
                                           profile_scope=None,
                                           window=window, mem_type=mem_type)
            hit_pool = "all" if results else "empty"
        if egress_mode == "auto" and not raw:
            _dropped = sum(1 for r in results if self._egress_cut(r))
            results = [r for r in results if not self._egress_cut(r)]
            if _dropped:
                logger.info(
                    f"FileMem: _recall_and_format egress cut {_dropped} item(s)")
            _inj_cfg = self._decay.get("injection") or {}
            _kept: List[Dict] = []
            _dropped_inj = 0
            for r in results:
                try:
                    _act, _mk = injection_gate_decision(r, _inj_cfg)
                except Exception as _ge:  # rule 6: per-row fail-soft
                    logger.warning(
                        f"FileMem: _recall_and_format gate row failed ({_ge}); "
                        f"passing row through (fail-soft)")
                    _kept.append(r)
                    continue
                if _act == "drop":
                    _dropped_inj += 1
                    continue
                _kept.append(r)
            if _dropped_inj:
                logger.info(
                    f"FileMem: _recall_and_format injection gate dropped "
                    f"{_dropped_inj} item(s)")
            results = _kept
        return results, hit_pool

    def _tool_search(self, args: Dict) -> str:
        """Search memories."""
        query = args.get("query")
        limit = args.get("limit", 5)
        # P0-2: unify the explicit face's min_score default to 0.3 —
        # matches the tool schema default (filemem_search.min_score=0.3)
        # and the auto face's self.min_search_score gate. Before: 0.7,
        # which silently diverged from the schema (the explicit gate ran
        # 2.3x tighter than documented).
        min_score = args.get("min_score", 0.3)
        window = args.get("window")  # SA2-2: optional {"since", "until"} ISO-date bounds
        mem_type = args.get("type", "all")  # 统一召回、分类做成参数: type slice of the pool
        raw = args.get("raw", False)  # 人工排查: skip egress (no-op in explicit mode)
        # P0-2: three-valued profile semantics — absent/None = the
        # session's owned profile first, global-pool fallback ONLY on
        # 0-hits (cascade); "ALL" = direct global recall (no cascade);
        # anything else = error.
        profile = args.get("profile")
        if profile is None:
            profile_scope = _resolve_session_profile(
                getattr(self, "source_profile", None))
            cascade = True
        elif profile == "ALL":
            profile_scope = None
            cascade = False
        else:
            return json.dumps({
                "error": (f"invalid profile {profile!r}; "
                          f"use None (session→global cascade) or 'ALL'")})

        results, hit_pool = self._recall_and_format(
            query, limit, min_score, profile_scope,
            egress_mode="explicit", raw=raw, cascade=cascade,
            window=window, mem_type=mem_type)
        # Envelope-level recall_scope (query semantics): computed from the
        # pool that actually hit (hit_pool — NEVER from the input param).
        # Item-level source_profile stamps stay on the rows (data lineage);
        # the two are orthogonal.
        if profile == "ALL":
            recall_scope = "direct_all"
        elif hit_pool == "self":
            recall_scope = "session"
        elif hit_pool == "all":
            recall_scope = "global_fallback"
        else:
            recall_scope = "empty"
        # B-path observability (D2): independent prefix `filemem_search`
        # (NOT `tool_search` — the Hermes built-in deferred-tool list emits 90+
        # `tool_search` INFO lines; that keyword would pollute grep counts).
        # Only logs when B-path is actually used (model invoked the tool).
        _start = time.time()
        logger.debug(
            f"FileMem: filemem_search query={query!r} limit={limit} "
            f"min_score={min_score} window={window!r} profile={profile!r} "
            f"hits={len(results)} recall_scope={recall_scope}"
        )
        _latency_ms = (time.time() - _start) * 1000
        # P2: audit explicit recall event
        self._audit_explicit_search(
            query=query, hit_count=len(results), recall_scope=recall_scope,
            latency_ms=_latency_ms,
            global_fallback_triggered=(recall_scope == "global_fallback"),
        )
        # LLM pass: thread the distill metadata to the model so it can judge
        # value / pick which unconfirmed items to ask the user about
        # (agent-driven clarify push, 不弹窗不轮询). Full content stays in the
        # result (all-in); the summary is a convenience field, never a
        # replacement.
        for r in results:
            _meta = r.get("metadata") or {}
            if _meta.get("summary") is not None:
                r["summary"] = _meta["summary"]
            if _meta.get("value") is not None:
                r["value"] = _meta["value"]
            r["confirmed"] = bool(_meta.get("confirmed", False))
        # P0-2: envelope-level recall_scope (query semantics, 4-valued,
        # computed from the ACTUAL hit pool above — never from the input
        # param). Per-row source_profile stamps (data lineage) ride inside
        # each result item, unchanged; the two are orthogonal and the
        # envelope is the ONLY place recall_scope lives.
        return json.dumps(
            {"recall_scope": recall_scope, "results": results},
            ensure_ascii=False, indent=2)

    def _tool_delete(self, args: Dict) -> str:
        """Delete a memory."""
        mem_id = args.get("id")

        if not mem_id:
            return json.dumps({"error": "id is required"})

        for mem_type in MEMORY_TYPES:
            mem_file = self.memories_dir / f"{mem_type}.json"
            if not mem_file.exists():
                continue
            # T5b: cross-process shard lock — the delete's read, audit
            # snapshot, and rewrite must be one atomic RMW against the
            # shared neutral store.
            with self._shard_lock(mem_file):
                with open(mem_file, "r", encoding="utf-8") as f:
                    items = json.load(f)

                new_items = [item for item in items if item.get("id") != mem_id]

                if len(new_items) < len(items):
                    # T3③: audit snapshot before the destructive write —
                    # an item can be deleted, the audit chain cannot break.
                    _gone = [it for it in items if it.get("id") == mem_id]
                    try:
                        self._append_consolidation_event({
                            "ts": _utcnow().isoformat(),
                            "action": "memory_delete",
                            "id": mem_id,
                            "source_profile": getattr(self, "source_profile", "default"),
                            "snapshot": [
                                {"id": g.get("id"), "type": g.get("type"),
                                 "level": g.get("level"),
                                 "content": g.get("content", "")}
                                for g in _gone
                            ],
                        })
                    except Exception as e:
                        logger.debug(f"FileMem: memory_delete audit write failed: {e}")
                    with open(mem_file, "w", encoding="utf-8") as f:
                        json.dump(new_items, f, ensure_ascii=False, indent=2)
                    # T4①: a discarded L0 row stops re-reporting (its content
                    # is snapshotted in the audit event above — "删得掉
                    # item、删不掉审计链"). Only L0 auto rows are listed in the
                    # pending panel, so a draft delete is a no-op here.
                    self._consume_pending_confirm(
                        self.session_id or "default", ids=[mem_id])
                    return json.dumps({"success": True, "deleted": mem_id})

        return json.dumps({"error": "Memory not found"})

    def _pool_rows_all(self) -> List[Dict[str, Any]]:
        """Option C (t_de0df8b7): a READ-ONLY flat snapshot of every semantic
        shard's pool rows (memories/*.json). The O1-scope clarify lane calls
        this to check whether a standing (permanent / legacy) row about the
        same topic exists in the GLOBAL pool / another profile — the "检查全
        局" half of Option C. Mirrors ``_o1_locate_row``'s read-only posture:
        a bare guarded ``json.load`` per shard, corrupt / unreadable shards
        are SKIPPED (fail-soft, never heal/rotate an unread file, never raise
        to the host turn). Knowledge rows are NOT semantic-shard pool rows and
        are excluded (the "全局" here means the shared neutral store's four
        type shards, i.e. what other profiles' auto-inject would see)."""
        out: List[Dict[str, Any]] = []
        for mem_type in MEMORY_TYPES:
            mem_file = self.memories_dir / f"{mem_type}.json"
            if not mem_file.exists():
                continue
            try:
                with open(mem_file, "r", encoding="utf-8") as f:
                    rows = json.load(f)
            except (OSError, json.JSONDecodeError):
                continue  # corrupt / unreadable shard: skip, keep scanning
            if isinstance(rows, list):
                out.extend(r for r in rows if isinstance(r, dict))
        return out

    def _o1_locate_row(self, row_id: str):
        """O1: locate a stored pool row by EXACT id across the semantic shards.
        Returns (mem_file, row_dict) on a hit, else (None, None). The id prefix
        names the shard, but we scan every shard so a cross-shard row is still
        addressable — the whole point of the explicit entry vs EP-1's
        same-shard-only auto stamp.

        READ-ONLY: this is a bare guarded ``json.load`` per shard, NOT the
        S4-③ self-heal helper — locating an id does not write, so a corrupt
        shard is simply SKIPPED (fail-soft, never rotates/heals an unread
        file, never raises to the host turn). The WRITE RMW below DOES read
        through the S4-③ self-heal helper (a corrupt shard is healed + audited
        before the write appends on the clean shell)."""
        for mem_type in MEMORY_TYPES:
            mem_file = self.memories_dir / f"{mem_type}.json"
            if not mem_file.exists():
                continue
            try:
                with open(mem_file, "r", encoding="utf-8") as f:
                    rows = json.load(f)
            except (OSError, json.JSONDecodeError):
                continue  # corrupt / unreadable shard: skip, keep scanning
            if not isinstance(rows, list):
                continue
            for row in rows:
                if isinstance(row, dict) and str(row.get("id")) == row_id:
                    return mem_file, row
        return None, None

    def _o1_mark_old(self, rows: List[Dict[str, Any]], old_id: str, new_id: str) -> None:
        """O1: stamp the old row superseded + back-linked to the new row (the
        SAME marker the read-side out-pool + EP-2 confirm face key on)."""
        for r in rows:
            if isinstance(r, dict) and str(r.get("id")) == old_id:
                meta = r.setdefault("metadata", {})
                meta["superseded"] = True
                meta["superseded_by"] = new_id
                return

    def _unsettle_by_kanban_id(self, tid: str, source_event: str = "kanban") -> int:
        """重开（unsettle）：某 kanban 卡又活跃 → 清含该卡 t_xxxx 外键的行的
        settled / settled_candidate，让行复活回 auto-inject 池。

        路线①（owner 钉）：全量订阅宿主 lifecycle 事件（completed/blocked/
        updated 任一），callback 收 task_id 后调本方法；不读 status 值（宿主
        payload 只带字段名、不带值）、不碰宿主。

        一步到位（owner 钉）：扫 _SETTLED_SCAN_SHARDS 全四分片（fact/task/
        preference/decision），不留"跑起来不够再加"的后路。

        复活可审计（owner 钉）：行内留 reopened + reopened_at + reopened_by
        痕迹（谁/何时/因何复活，可追溯）；另走 _append_consolidation_event
        落一条 action=kanban_unsettle 到持久 audit 链（fail-soft，复用现有原语，
        不新增日志面）。找不到对应行 / 无 settled 标记 → no-op（零副作用）。

        写回用裸 open+json.dump（全文件写回惯例，无专门 write helper）；
        读走 S4-③ self-heal 的 _read_memories_file，整体包在 _shard_lock 内。
        """
        total = 0
        for mem_type in _SETTLED_SCAN_SHARDS:
            mem_file = self.memories_dir / f"{mem_type}.json"
            if not mem_file.exists():
                continue
            with self._shard_lock(mem_file):
                rows = self._read_memories_file(mem_file)
                hit = 0
                for r in rows:
                    if not isinstance(r, dict):
                        continue
                    # 外键命中 = 该行 content 里带这张卡的 t_xxxx
                    if tid not in (r.get("content") or ""):
                        continue
                    meta = r.setdefault("metadata", {})
                    if not (meta.get("settled") or meta.get("settled_candidate")):
                        continue
                    # 复活：清两个标记 + 行内可审计痕迹
                    meta["settled"] = False
                    meta["settled_candidate"] = False
                    meta["reopened"] = True
                    meta["reopened_at"] = _utcnow().isoformat()
                    meta["reopened_by"] = f"{source_event}:{tid}"
                    hit += 1
                if hit:
                    with open(mem_file, "w", encoding="utf-8") as f:
                        json.dump(rows, f, ensure_ascii=False, indent=2)
                    # 持久 audit 链（fail-soft，不炸宿主 turn）
                    try:
                        self._append_consolidation_event({
                            "ts": _utcnow().isoformat(),
                            "action": "kanban_unsettle",
                            "task_id": tid,
                            "source_event": source_event,
                            "shard": mem_type,
                            "revived": hit,
                            "source_profile": getattr(self, "source_profile", "default"),
                        })
                    except Exception:
                        pass
                    total += hit
                    logger.info(
                        f"FileMem: unsettle kanban {tid} revived {hit} row(s) "
                        f"in {mem_type} (event={source_event})")
        return total

    def _tool_supersede(self, args: Dict) -> str:
        """O1 (t_d552a09f): the explicit supersede LLM face.

        A deterministic write-side stamp that BYPASSES EP-1's 0.5 Jaccard gate
        — the host main-model's authoring intent is the authoritative lineage
        link (the one delta vs the automatic save-door stamp). It (a) writes a
        new correcting row carrying the explicit `supersedes` link + a (b)
        validity window, and (b) marks the old row superseded so it leaves the
        auto-inject pool (it stays on disk, I1 无 DELETE). The candidate then
        confirms through the EXISTING EP-2 flow — O1 feeds that face, it does
        not re-build it. LLM face = 1 schema + 1 dispatch over the shared host
        channel: ZERO new provider / model config / API key / task key. This
        handler is ZERO-LLM pure stdlib + the shared P0-2 origin stamp.
        """
        old_id = str(args.get("old_id") or "").strip()
        new_content = str(args.get("new_content") or "").strip()
        reason = str(args.get("reason") or "").strip()
        if not old_id:
            return json.dumps({"error": "old_id is required"})
        if not new_content:
            return json.dumps({"error": "new_content is required"})
        if not reason:
            return json.dumps({"error": "reason is required"})

        old_file, old_row = self._o1_locate_row(old_id)
        if old_file is None:
            return json.dumps({
                "error": (f"memory {old_id!r} not found in the store; pass an "
                          f"id reported by filemem_search / filemem_read "
                          f"(a pending draft has no linkable pool id — confirm "
                          f"it first)")})
        # O1 1D cross-profile write-face guard (supersedes 356 裁决 3 "drop the
        # cross-profile guard, exact old_id only"): the supersede MARKS the old
        # row + appends a new stamped row in ITS shard — touching another
        # profile's row from this session would leak this profile's lineage
        # stamp into their audit chain. Memory updates are profile (session)
        # isolated BY DEFAULT; a cross-profile override now escalates through an
        # EXPLICIT user confirmation instead of a hard block (the LLM asks via
        # the existing clarify tool, then retries with allow_cross_profile=true
        # + a non-empty user_confirmation). Neutral / unstamped rows stay
        # claimable by any profile; an UNRESOLVED session identity
        # (source_profile None/"") tightens to neutral-rows-only (the P1-4
        # convention: don't know who I am -> never claim a stamped row, and the
        # override flag does NOT relax that). Rejection is BEFORE any write: no
        # marker, no new row, no audit event.
        allow_cross = args.get("allow_cross_profile") is True
        user_conf = str(args.get("user_confirmation") or "").strip()
        row_sp = _row_source_profile(old_row)
        my_sp = getattr(self, "source_profile", None)
        # Stable, LLM-parseable rejection bodies (1D test E pins these key
        # substrings). The cross-profile no-flag rejection carries the old row's
        # owning profile + a content summary + the clarify-then-retry guidance,
        # and it still ENDS WITH "(unstamped) row" so the P0-2 guard's existing
        # tripwire (test_o1_regression_docker_guard case B) stays green.
        _content_sum = " ".join(str(old_row.get("content") or "").split())
        if len(_content_sum) > 60:
            _content_sum = _content_sum[:57] + "..."
        _session_tag = str(my_sp) if my_sp else "unresolved"
        _cross_reject = (
            f"memory {old_id!r} belongs to profile {row_sp!r} "
            f"(content: {_content_sum!r}), which does not match this session "
            f"({_session_tag}); cross-profile supersede is rejected — if the "
            f"user EXPLICITLY asked to override this cross-profile memory, "
            f"first call clarify to get their confirmation; after "
            f"confirmation, retry filemem_supersede with allow_cross_profile="
            f"true and user_confirmation=<the user's confirmation text/"
            f"summary>; if they refuse, do NOT retry and leave the row "
            f"unchanged. Otherwise supersede your own profile's rows, or use a "
            f"neutral (unstamped) row"
        )
        _flag_reject = (
            "allow_cross_profile=true requires a non-empty user_confirmation; "
            "pass the user's confirmation text (or a faithful summary of it) "
            "in user_confirmation, or drop the flag and supersede your own "
            "profile's rows"
        )
        cross_override = False
        if my_sp in (None, ""):
            # P1-4: unresolved session identity -> NEUTRAL-ROWS-ONLY. The
            # cross-profile override flag does NOT relax this: an identity that
            # can't name itself can't safely override another profile's memory.
            claimable = row_sp is None
        elif row_sp is None or row_sp == my_sp:
            # neutral (unstamped) OR own-profile row -> the ORIGINAL RMW path
            # (behavior zero-change; the existing O1 tests are the regression
            # gate). The override flag is a harmless no-op on these rows.
            claimable = True
        elif allow_cross and user_conf:
            # user-confirmed cross-profile override: permitted. The audit row
            # below carries cross_profile_overwrite=true + the confirmation.
            claimable = True
            cross_override = True
        elif allow_cross:
            # flag set but user_confirmation empty -> mechanical block: a cross
            # override with no user confirmation is refused, never bypassed.
            return json.dumps({"error": _flag_reject, "success": False})
        else:
            # no flag (or flag not honored) -> reject with the actionable msg.
            return json.dumps({"error": _cross_reject, "success": False})
        if not claimable:
            # only the unresolved-identity + stamped-row case lands here.
            return json.dumps({"error": _cross_reject, "success": False})
        old_meta = old_row.get("metadata") if isinstance(old_row.get("metadata"), dict) else {}
        old_type = old_row.get("type")
        mem_type = args.get("type") or old_type
        if mem_type not in MEMORY_TYPES:
            mem_type = old_type if old_type in MEMORY_TYPES else "fact"
        level = args.get("level") or old_row.get("level") or "L0"
        if level not in MEMORY_LEVELS:
            level = "L0"
        scope = args.get("validity_scope") or "permanent"
        if scope not in _O1_VALIDITY_SCOPES:
            scope = "permanent"

        now_iso = _utcnow().isoformat()
        target_file = self.memories_dir / f"{mem_type}.json"
        # O1 row id: collision-resistant WITHOUT a pre-lock pool read (a same-
        # second retry must not collide). ms-precision ts + a short content
        # fingerprint keep the id unique and stable; the established
        # `{mem_type}_..._{ts}` shape is preserved (opaque to the read face —
        # search / lineage_of / the fold key only on the exact id string).
        _seq = int(_utcnow().timestamp() * 1000)
        new_id = f"{mem_type}_o1sup_{_seq}"

        # New row's metadata: the explicit lineage link + audit reason + the
        # (b) validity window. origin is stamped through the SHARED P0-2 path
        # (a 'manual' source -> user/high) so the new row is NEVER neutral (hard
        # isolation intact). content_hash reuses the save-door helper (P1-1b).
        new_meta: Dict[str, Any] = {
            "supersedes": [old_id],
            "supersede_state": "candidate",
            "supersede_reason": reason,
            "validity_scope": scope,
            # P0-2 hard isolation: stamp the owning profile (the SAME metadata
            # channel the save door uses via _failure_meta_for) so the new
            # row is NEVER neutral — an unstamped row would leak into other
            # profiles' auto-inject. source_profile absent (default profile)
            # = None -> neutral by design, matching the save door.
            "source_profile": getattr(self, "source_profile", None),
        }
        valid_until = _o1_valid_until_for_scope(scope, now_iso)
        if valid_until:
            new_meta["valid_until"] = valid_until
        _stamp_origin_in_meta(new_meta, "manual")
        new_meta["content_hash"] = self._content_hash(new_content)
        new_row = {
            "id": new_id,
            "type": mem_type,
            "content": new_content,
            "level": level,
            "metadata": new_meta,
            "created_at": now_iso,
            "updated_at": now_iso,
            "occurred_at": extract_occurred_at(new_content),
            "source": "manual",
            "reference_count": 0,
            "salience": 0.5,
            "last_referenced": "",
            "ttl_days": None,
        }

        # RMW under shard lock(s). Same shard (the docker / common case) = ONE
        # atomic region so the pair is a consistent snapshot; cross-shard = two
        # sequential single-file RMWs (no nested lock -> no deadlock with the
        # save door / delete face, which each hold one shard lock at a time).
        # The new row is appended VERBATIM (no content-hash dedup no-op): the
        # correction's content intentionally differs from the old row's, so an
        # upsert collapse would silently drop the correction.
        # RMW under shard lock(s) — the SAME bare-``json.load``-under-lock
        # write-face convention as ``_tool_delete`` (this is a manual LLM-tool
        # write, not a pool read choke): it adds NO new S4-③ self-heal
        # ``_read_memories_file`` call site (the corrupt-file read choke stays
        # bounded to the 5 S4-③ sites). Same shard (the docker / common case) =
        # ONE atomic region so the pair is a consistent snapshot; cross-shard =
        # two sequential single-file RMWs (no nested lock -> no deadlock with
        # the save door / delete face, which each hold one shard lock at a
        # time). A corrupt shard surfaces as a guarded error (caught by the
        # tool dispatcher), never a half-write. The new row is appended
        # VERBATIM (no content-hash dedup no-op): the correction's content
        # intentionally differs from the old row's, so an upsert collapse would
        # silently drop it.
        def _o1_read(path):
            # Missing shard file = an empty pool (a fresh type with no rows yet
            # on the cross-shard path); a corrupt/JSON-bad shard surfaces as a
            # guarded error to the tool dispatcher (never a half-write).
            if not path.exists():
                return []
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
            return data if isinstance(data, list) else []

        if old_file == target_file:
            with self._shard_lock(old_file):
                rows = _o1_read(old_file)
                rows.append(new_row)
                self._o1_mark_old(rows, old_id, new_id)
                with open(old_file, "w", encoding="utf-8") as f:
                    json.dump(rows, f, ensure_ascii=False, indent=2)
        else:
            with self._shard_lock(target_file):
                rows = _o1_read(target_file)
                rows.append(new_row)
                with open(target_file, "w", encoding="utf-8") as f:
                    json.dump(rows, f, ensure_ascii=False, indent=2)
            with self._shard_lock(old_file):
                rows = _o1_read(old_file)
                self._o1_mark_old(rows, old_id, new_id)
                with open(old_file, "w", encoding="utf-8") as f:
                    json.dump(rows, f, ensure_ascii=False, indent=2)

        # audit row on the SAME append-only channel as EP-1/EP-2 (a distinct
        # action=supersede_explicit row, so the supersede_confirm tick can later
        # confirm the candidate without re-judging candidacy).
        _audit = {
            "ts": now_iso,
            "action": "supersede_explicit",
            "old_id": old_id,
            "new_id": new_id,
            "type": mem_type,
            "level": level,
            "reason": reason,
            "validity_scope": scope,
            "valid_until": new_meta.get("valid_until"),
            "source_profile": getattr(self, "source_profile", "default"),
        }
        if cross_override:
            # O1 1D: a user-confirmed cross-profile override is audited on the
            # SAME append-only channel (consolidation_log.jsonl) as EP-1/EP-2,
            # carrying the override flag, the user's confirmation ORIGINAL
            # text, and the session id. The ordinary (own-profile / neutral)
            # path appends the same 10-key row with NONE of these extra fields
            # (behavior zero-change; the existing O1 tests pin that shape).
            _audit["cross_profile_overwrite"] = True
            _audit["user_confirmation"] = user_conf
            _audit["session_id"] = getattr(self, "session_id", None)
        self._append_consolidation_event(_audit)
        return json.dumps({
            "success": True,
            "old_id": old_id,
            "new_id": new_id,
            "type": mem_type,
            "level": level,
            "validity_scope": scope,
            "valid_until": new_meta.get("valid_until"),
            "supersede_state": "candidate",
            "note": ("old row marked superseded (out of the auto-inject pool, "
                     "kept on disk for audit); new correcting row written. "
                     "Confirm the candidate via the usual supersession-"
                     "confirmation flow to finalize."),
        })

    def _tool_review_drafts(self, args: Dict) -> str:
        """Review and handle session drafts.

        Two scopes:
          - current session (no `target`): the in-memory `self._session_drafts`
            for `self.session_id`, persisted to drafts_<sid>.json.
          - historical file (`target`): a drafts_<owner>.json left behind by a
            prior session that ended unconfirmed. Confirm/discard operates on
            that file directly so old drafts can be cleared without resurrecting
            the original session.
        """
        action = args.get("action")
        memory_id = args.get("memory_id")
        target = args.get("target")

        # ── Historical-draft target path ───────────────────────────────────
        if target:
            # Accept either a bare owner id or a full filename.
            t = target if target.startswith("drafts_") else f"drafts_{target}"
            t = t + ".json" if not t.endswith(".json") else t
            tfile = self.storage_dir / t
            owner = (tfile.stem[len("drafts_"):] if tfile.stem.startswith("drafts_")
                     else tfile.stem)
            if not tfile.exists():
                # t_05679311 exposure-surface contract: a fail-soft error must
                # NOT echo an internal filename (drafts_<owner>.json). Report
                # the owner id only.
                return json.dumps({
                    "success": False,
                    "error": f"historical draft target '{owner}' has no pending drafts",
                })

            # T5b: the historical-draft read-modify-write is a single atomic
            # region against the shared neutral store (two processes confirming
            # the same drafts_<owner>.json must not lose each other's writes).
            # One outer shard lock on tfile; _write_draft_file is now a pure
            # leaf, so tfile is flock'd exactly once per path. Cross-file
            # ordering is tfile -> memories pool -> audit (same as _tool_delete),
            # single direction, deadlock-free.
            with self._shard_lock(tfile):
                with open(tfile, "r", encoding="utf-8") as f:
                    raw = json.load(f)
                drafts = [MemoryItem.from_dict(d) for d in raw]

                if action == "preview":
                    # F-site read-only preview: list pending entries by content
                    # + id (+ level) so the model decides confirm/discard on
                    # CONTENT without opening the internal drafts_*.json blobs.
                    # The return body NEVER contains an internal filename.
                    _lim = args.get("limit")
                    if _lim is None:
                        _lim = len(drafts)
                    _shown = max(0, min(len(drafts), _lim))
                    return json.dumps({
                        "success": True,
                        "scope": "historical",
                        "count": len(drafts),
                        "shown": _shown,
                        "items": [
                            {"id": d.id, "type": d.type,
                             "content": d.content, "level": d.level}
                            for d in drafts[:_lim]
                        ],
                    })

                if action == "confirm":
                    saved_ids = []
                    kept = []
                    confirmed_items = []
                    for draft in drafts:
                        if not memory_id or draft.id == memory_id:
                            item_id = self._save_memory(
                                draft.content, level=draft.level, source="confirmed_draft"
                            )
                            saved_ids.append(item_id)
                            confirmed_items.append(draft)
                        else:
                            kept.append(draft)
                    # T3③: audit snapshot BEFORE the destructive write — the
                    # promoted rows are preserved in the append-only chain.
                    self._audit_drafts_review("confirm", owner, confirmed_items, tfile.name)
                    # Drop confirmed rows from the file; keep un-confirmed ones.
                    self._write_draft_file(tfile, kept)
                    return json.dumps({
                        "success": True,
                        "action": "confirm",
                        "target": t,
                        "saved_ids": saved_ids,
                        "count": len(saved_ids),
                    })

                elif action == "discard":
                    kept = [d for d in drafts if memory_id and d.id != memory_id]
                    discarded_items = [d for d in drafts if not (memory_id and d.id != memory_id)]
                    # T3③: snapshot dropped content into the audit chain.
                    self._audit_drafts_review("discard", owner, discarded_items, tfile.name)
                    self._write_draft_file(tfile, kept)
                    discarded = len(drafts) - len(kept)
                    return json.dumps({
                        "success": True,
                        "action": "discard",
                        "target": t,
                        "discarded_count": discarded,
                    })

                return json.dumps({"error": f"Unknown action: {action}"})

        # ── Current-session path (backward-compatible) ──────────────────────
        drafts = self._session_drafts.get(self.session_id, [])

        if action == "preview":
            # F-site read-only preview of the CURRENT session's in-memory
            # drafts (the model never opens the internal drafts_<sid>.json).
            _lim = args.get("limit")
            if _lim is None:
                _lim = len(drafts)
            _shown = max(0, min(len(drafts), _lim))
            return json.dumps({
                "success": True,
                "scope": "current",
                "count": len(drafts),
                "shown": _shown,
                "items": [
                    {"id": d.id, "type": d.type,
                     "content": d.content, "level": d.level}
                    for d in drafts[:_lim]
                ],
            })

        if action == "confirm":
            # Save all drafts as permanent memories
            saved_ids = []
            confirmed_items = []
            for draft in drafts:
                if not memory_id or draft.id == memory_id:
                    item_id = self._save_memory(
                        draft.content,
                        level=draft.level,
                        source="confirmed_draft"
                    )
                    saved_ids.append(item_id)
                    confirmed_items.append(draft)

            # T3③: audit snapshot before the clear (unbreakable chain).
            self._audit_drafts_review(
                "confirm", self.session_id or "default", confirmed_items,
                f"drafts_{self.session_id}.json")

            # Clear drafts (T3②: the empty persist unlinks the shell)
            self._session_drafts[self.session_id] = []
            self._save_session_drafts()
            # T4①: consuming the confirm batch stops it re-reporting. A
            # no-memory_id confirm confirms the WHOLE batch; a memory_id
            # confirm consumes only that item (the rest re-report next turn).
            self._consume_pending_confirm(
                self.session_id or "default",
                ids=[memory_id] if memory_id else None)

            return json.dumps({
                "success": True,
                "action": "confirm",
                "saved_ids": saved_ids,
                "count": len(saved_ids)
            })

        elif action == "discard":
            # T3③: snapshot every discarded draft into the audit chain,
            # then clear (T3②: the empty persist unlinks the shell).
            self._audit_drafts_review(
                "discard", self.session_id or "default", list(drafts),
                f"drafts_{self.session_id}.json")
            # Clear all drafts
            self._session_drafts[self.session_id] = []
            self._save_session_drafts()
            # T4①: consuming the discard batch stops it re-reporting (the
            # discarded content is already snapshotted to the audit chain
            # above — "删得掉 item、删不掉审计链"). No-memory_id discards the
            # whole batch; a memory_id discards only that item.
            self._consume_pending_confirm(
                self.session_id or "default",
                ids=[memory_id] if memory_id else None)

            return json.dumps({
                "success": True,
                "action": "discard",
                "discarded_count": len(drafts)
            })

        return json.dumps({"error": f"Unknown action: {action}"})

    def _write_draft_file(self, tfile, drafts: List[MemoryItem]) -> None:
        """Persist a draft list to a named draft file.

        When the list is empty the file is DELETED — an empty shell would just
        accumulate as junk across sessions (storage/ already holds 25+ draft
        files); the pending-draft notice's `if data:` gate treats a missing
        file as "nothing pending" either way, so deletion is safe and clean.

        LOCKING NOTE (T5b): this helper is a pure leaf — it takes NO lock.
        Its caller wraps the whole read-modify-write region in one
        _shard_lock(tfile) instead, so the same file is never flock'd twice
        in one call path (fcntl.flock is per-open-file-description: a second
        LOCK_EX on the same file from the same thread would self-block).
        """
        if not drafts:
            tfile.unlink()
            return
        with open(tfile, "w", encoding="utf-8") as f:
            json.dump([d.to_dict() for d in drafts], f, ensure_ascii=False, indent=2)

    def _append_consolidation_event(self, event: Dict[str, Any]) -> None:
        """Append one audit row to storage/consolidation_log.jsonl (fail-soft).

        The overflow / queue-audit path uses this so a silent-drop of queue
        items is itself an auditable event (@data-engineer: no silent drop).
        Shared with the LLM-rescore writer's target file — same append-only log.
        """
        try:
            p = self.storage_dir / "consolidation_log.jsonl"
            p.parent.mkdir(parents=True, exist_ok=True)
            # T5b: cross-process lock on the shared audit-log append — the neutral
            # root is written by every profile's gateway process concurrently.
            with self._shard_lock(p):
                with open(p, "a", encoding="utf-8") as f:
                    f.write(json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")
        except Exception as e:
            # Fail-soft contract (SEC-1-3 裁决 4 / T5b, documented on this
            # helper + every call-site): an audit hiccup (unwritable path,
            # IsADirectoryError, disk full, ...) must NEVER propagate to the
            # host — the caller's gate semantics stay unchanged, the row is
            # simply not written (a logged hiccup), not a re-thrown error.
            logger.warning(f"FileMem: consolidation audit row not written: {e}")

    def _append_llm_call_telemetry(self, llm_module: Any, face: str) -> None:
        """epic card 3: one face-level `llm_call` telemetry row per host LLM
        call, appended to the EXISTING consolidation_log.jsonl — reuses the
        _append_consolidation_event append + _shard_lock flock protocol
        (no new log file, no changed existing-row schema, append-only audit
        chain intact). Row shape (new row type, grep-able):
            {ts, action: "llm_call", face: <score_salience|relevance|distill|
             confirm_supersede|suggest_aliases|observe>, model, provider,
             duration_ms, ok, fallback, reason?}
        model/provider/duration_ms/ok/fallback/reason come from the
        llm_caller module object's _last_telemetry seam — the record
        _structured_call / the face's fail-soft handler left for THIS call
        (the module is fresh-exec'd per _load_llm_caller(), so the seam
        holds exactly this call's result; route attribution comes from the
        host call_llm's route_info, else the main_runtime snapshot). An
        empty / whitespace host reply is thereby manifested as a
        fallback=True reason=empty_response row instead of the old silent
        0.5 / medium fall-through (the caller's fail-soft verdict value is
        UNCHANGED — card 2 semantics preserved, only the log row now
        records the fallback). Fail-soft: a missing seam (zero-LLM test
        doubles / CLI paths) or an audit hiccup never disturbs the LLM
        verdict path — the row is simply not written (a logged hiccup)."""
        try:
            tel = getattr(llm_module, "_last_telemetry", None)
            if not isinstance(tel, dict) or "fallback" not in tel:
                return  # zero-host test double / seam unset -> no row (not an error)
            event: Dict[str, Any] = {
                "ts": _utcnow().isoformat(),
                "action": "llm_call",
                "face": face,
                "model": tel.get("model"),
                "provider": tel.get("provider"),
                "duration_ms": int(tel.get("duration_ms") or 0),
                "ok": bool(tel.get("ok")),
                "fallback": bool(tel.get("fallback")),
            }
            if tel.get("reason"):
                event["reason"] = tel["reason"]
            self._append_consolidation_event(event)
        except Exception as e:
            logger.debug(f"FileMem: llm_call telemetry row not written ({face}): {e}")

    def _audit_drafts_review(self, op: str, target_session: str,
                             items: List[MemoryItem], target_file: str) -> None:
        """T3③: append a `drafts_review` audit row WITH a content snapshot.

        `confirm` snapshots the promoted rows, `discard` snapshots the
        dropped ones — either way the disposed content stays recoverable in
        the append-only log ("items can be deleted, the audit chain cannot
        be broken"). Fail-soft: an audit hiccup never blocks the tool.
        """
        try:
            self._append_consolidation_event({
                "ts": _utcnow().isoformat(),
                "action": "drafts_review",
                "op": op,
                "target": target_file,
                "target_session": target_session,
                "count": len(items),
                "snapshot": [d.to_dict() for d in items],
            })
        except Exception as e:
            logger.debug(f"FileMemory: drafts_review audit write failed: {e}")

    def _generate_session_end_prompt(self, session_id: str, drafts: list) -> str:
        """Generate the session-end prompt that lists pending drafts for review.

        Shows the agent its uncommitted L0 drafts so it can trigger
        ``filemem_review_drafts`` itself instead of waiting for a cron tick.
        """
        # Build a compact list for the prompt
        draft_lines = []
        for d in drafts:
            preview = d.get("content", "")[:80]
            draft_lines.append(f"  - [{d.get('id', '?')}] {preview}...")

        prompt = f"""Session end detected. {len(drafts)} draft memory(ies) pending review:

{chr(10).join(draft_lines) if draft_lines else '  (none)'}

💾 **Auto-Confirm**

Call `filemem_review_drafts(action="confirm")` to save these memories permanently.
"""
        logger.info(f"FileMem: session end prompt generated for {len(drafts)} drafts")

        # B4: write episodic summary into sharded JSONL (yyyy/mm), gated by salience_threshold
        # (still INSIDE the drafts branch — only sessions WITH drafts write an
        # episodic summary; S1b F2 moved the tick spawn above the gate but the
        # draft flow is untouched).
        self._write_episodic_entry(session_id, drafts)

        # S1b F2: the D4(a) tick spawn moved ABOVE the `if not drafts` gate
        # (unconditional boundary trigger — see comment there). It no longer
        # rides this drafts branch, so a draft-less session end still fires a
        # consolidation tick; the episodic write above stays drafts-gated.
        return prompt

    # ── D4 (a): LLM offline consolidation — agent hook layer, not the 4h no_agent job ──
    @staticmethod
    def _episodic_pool_id(e: Dict[str, Any], shard_stem: str) -> str:
        """Stable episodic pool id (shared by read-side replay + candidate gathering
        so a rescore event's episodic_id always matches the pool item it rescores)."""
        return e.get("id", f"episodic_{shard_stem}_{e.get('session_id')}")

    def _rescore_events_path(self) -> "Path":
        return self.storage_dir / "consolidated" / "llm_rescore_events.jsonl"

    def _load_rescore_events(self) -> Dict[str, Dict[str, Any]]:
        """Latest LLM rescore per episodic id (last-wins by ts). Empty if no file."""
        p = self._rescore_events_path()
        latest: Dict[str, Dict[str, Any]] = {}
        if not p.exists():
            return latest
        for line in p.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if ev.get("salience_source") != "llm" or not ev.get("episodic_id"):
                continue
            eid, ts = ev["episodic_id"], ev.get("ts", "")
            cur = latest.get(eid)
            if cur is None or ts > cur.get("ts", ""):
                latest[eid] = ev
        return latest

    def _unscored_episodic_candidates(self, scored_ids) -> List[Dict[str, Any]]:
        """Active, non-fixture episodic entries NOT yet LLM-rescored (incremental gate)."""
        cands: List[Dict[str, Any]] = []
        if self.episodic_dir is None or not self.episodic_dir.exists():
            return cands
        for shard in self.episodic_dir.rglob("*.jsonl"):
            try:
                for line in shard.read_text(encoding="utf-8").splitlines():
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        e = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if e.get("fixture") or e.get("status") == "decayed":
                        continue
                    eid = self._episodic_pool_id(e, shard.stem)
                    if eid in scored_ids:
                        continue  # incremental gate: skip already-rescored
                    cands.append({
                        "id": eid,
                        "content": e.get("content", ""),
                        "session_id": e.get("session_id", ""),
                        "salience": e.get("salience", 0.5),
                    })
            except OSError:
                continue
        return cands

    def _llm_consolidate(self) -> None:
        """D4(a): score salience for unscored episodic entries via the host LLM.
        call-level gate (0 candidates -> no LLM call, zero cost) + incremental gate
        (skip scored) + N-cap (consolidation.max_llm_per_tick) + fail-soft (LLM down
        -> llm_caller falls back to 0.5, data never lost). Append-only event rows;
        the read-side replay is what makes the new scores actually rank (precond #6).
        LLM 显式化◆: the salience face runs off the EXPLICIT host main_runtime
        snapshot (provider._main_runtime, epic card 1) — the old _llm_ctx-None
        gate becomes the main_runtime-missing gate, and the audit row's reason
        label follows the face that was cut."""
        if not getattr(self, "_main_runtime", None):
            # S1b F4: the LLM-FACE skip is now a self-provable audit event
            # (throttled by _last_skip_audit_ts / consolidation_interval_min —
            # one row per window, never a per-tick flood). Standalone stays
            # "skip, not an error"; the NON-LLM sections of the SAME tick
            # (C auto-archive + prune layer, which ride this thread AFTER the
            # LLM segments) still run below — the main_runtime-missing skip
            # only cuts the LLM faces, not the deterministic archive/prune work.
            self._audit_tick_skip("main_runtime missing")
            return  # standalone usage (no host main_runtime) — skip, not an error
        if getattr(self, "_llm_consolidating", False):
            logger.debug("FileMem: llm_consolidation already in flight, skipping this spawn")
            return
        self._llm_consolidating = True
        try:
            scored_ids = set(self._load_rescore_events().keys())
            cands = self._unscored_episodic_candidates(scored_ids)
            if not cands:
                logger.debug("FileMem: llm_consolidation no unscored episodic entries, skipping (zero cost)")
                return  # CALL-LEVEL GATE
            n_cap = int((self._decay.get("consolidation") or {}).get("max_llm_per_tick", 10))
            cands = cands[:n_cap]  # N-CAP (burst-bounded; overflow rolls to next boundary)
            llm = _load_llm_caller()
            rpath = self._rescore_events_path()
            rpath.parent.mkdir(parents=True, exist_ok=True)
            log_path = self.storage_dir / "consolidation_log.jsonl"
            sp = getattr(self, "source_profile", "default")
            done = 0
            with open(rpath, "a", encoding="utf-8") as rf, open(log_path, "a", encoding="utf-8") as lf:
                for c in cands:
                    res = llm.score_salience(self._main_runtime, c["content"])  # fail-soft inside
                    self._append_llm_call_telemetry(llm, "score_salience")
                    new_sal = round(float(res["salience"]), 4)
                    ts = _utcnow().isoformat()
                    rf.write(json.dumps({
                        "ts": ts, "episodic_id": c["id"], "session_id": c["session_id"],
                        "salience": new_sal, "salience_source": "llm",
                        "model_used": res.get("model_used", False), "source_profile": sp,
                    }, ensure_ascii=False) + "\n")
                    lf.write(json.dumps({
                        "ts": ts, "action": "llm_rescore", "episodic_id": c["id"],
                        "before": {"salience": c.get("salience")},
                        "after": {"salience": new_sal, "salience_source": "llm",
                                  "model_used": res.get("model_used", False)},
                        "source_profile": sp,
                    }, ensure_ascii=False) + "\n")
                    done += 1
            logger.info(f"FileMem: llm_consolidation scored {done} episodic entr(y/ies) this tick (N-cap={n_cap})")
        except Exception as e:
            logger.warning(f"FileMem: llm_consolidation tick failed (open entries retry next boundary): {e}")
        finally:
            self._llm_consolidating = False

    def _supersede_confirm_candidates(self) -> None:
        """EP-2: LLM-confirmation face for EP-1's supersedes candidates.

        Consumes ONLY EP-1's stamped products (metadata.supersede_state ==
        "candidate" + metadata.supersedes=[old ids]); it flips state, it
        never re-judges candidacy. Same skeleton as _llm_consolidate:
        _llm_ctx None -> skip (standalone, not an error); idempotence /
        concurrency guard; N-cap (consolidation.supersede_max_confirms,
        default 5 — overflow rolls to the next boundary tick); append-only
        consolidation_log.jsonl; fail-soft everywhere (a single bad pair or
        a whole-tick exception leaves the candidates as candidates — they
        retry next boundary, 不吞脏; confirmed=False is a VERDICT, not a
        failure — the candidate just stays unconfirmed).
        The LLM call is consolidation/llm_caller.confirm_supersede — host
        main-model face (explicit main_runtime, no task key), zero hardcoded
        model names, zero custom api/provider config. LLM 显式化◆: the gate
        is the provider's main_runtime snapshot (epic card 1); a missing
        snapshot = standalone skip, not an error. Writes (new-row state flip + every
        superseded target row's superseded_confirmed=True) go through the
        same cross-process _shard_lock RMW as the save door."""
        if not getattr(self, "_main_runtime", None):
            return  # standalone usage (no host main_runtime) — skip, not an error
        if getattr(self, "_supersede_confirming", False):
            logger.debug("FileMem: supersede confirm already in flight, skipping this spawn")
            return
        self._supersede_confirming = True
        try:
            # 3. Scan every semantic shard for candidate rows (read-only
            # pass; state flips happen later under the shard lock).
            cands: List[tuple] = []  # (mem_file, new_row_id)
            for mem_type in MEMORY_TYPES:
                mem_file = self.memories_dir / f"{mem_type}.json"
                if not mem_file.exists():
                    continue
                try:
                    with open(mem_file, "r", encoding="utf-8") as f:
                        items = json.load(f)
                except (OSError, json.JSONDecodeError):
                    continue
                for row in items:
                    if not isinstance(row, dict):
                        continue
                    meta = row.get("metadata")
                    # Idempotence: only "candidate" rows enter the set —
                    # confirmed/rejected rows are already decided.
                    if isinstance(meta, dict) and meta.get("supersede_state") == "candidate":
                        cands.append((mem_file, str(row.get("id") or "")))
            if not cands:
                logger.debug("FileMem: supersede confirm no candidate rows, skipping (zero cost)")
                return  # call-level gate
            # 4. Budget N-cap (parallel to max_llm_per_tick; overflow rolls
            # to the next tick).
            n_cap = int((self._decay.get("consolidation") or {}).get("supersede_max_confirms", 5))
            cands = cands[:n_cap]
            llm = _load_llm_caller()
            log_path = self.storage_dir / "consolidation_log.jsonl"
            log_path.parent.mkdir(parents=True, exist_ok=True)

            def _audit(target_id: str, confirmed: bool, model_used: bool, reason: str, new_id: str = "") -> None:
                # 7. append-only audit row (never rewrite history).
                lf.write(json.dumps({
                    "action": "supersede_confirm", "new_id": new_id,
                    "target_id": target_id, "confirmed": confirmed,
                    "model_used": model_used, "reason": reason,
                    "ts": _utcnow().isoformat(),
                }, ensure_ascii=False) + "\n")

            with open(log_path, "a", encoding="utf-8") as lf:
                for mem_file, new_id in cands:
                    try:
                        # 5. Host-model pair verdict (fail-soft inside: any
                        # exception -> confirmed=False, model_used=False).
                        # Read the shard first to resolve the target pair's
                        # texts (supersedes[0] is the primary target; the
                        # whole target list gets the confirmed marker).
                        try:
                            with open(mem_file, "r", encoding="utf-8") as f:
                                items = json.load(f)
                        except (OSError, json.JSONDecodeError) as e:
                            _audit("", False, False, f"bad_reference: unreadable shard ({e})", new_id)
                            continue
                        new_row = next((r for r in items if isinstance(r, dict)
                                        and str(r.get("id")) == new_id), None)
                        if new_row is None:
                            _audit("", False, False, f"bad_reference: new row {new_id} no longer in shard", new_id)
                            continue
                        # Idempotent re-check under no lock (a concurrent
                        # human CLI confirm may have flipped it already).
                        if (new_row.get("metadata") or {}).get("supersede_state") != "candidate":
                            continue
                        old_ids = [str(x) for x in ((new_row.get("metadata") or {}).get("supersedes") or [])]
                        old_by_id = {str(r.get("id")): r for r in items if isinstance(r, dict)}
                        primary = old_ids[0] if old_ids else ""
                        # 4b. Bad reference: primary target absent from the
                        # shard -> skip WITH a trace (不炸, batch continues).
                        if not primary or primary not in old_by_id:
                            _audit(primary or "<none>", False, False,
                                   f"bad_reference: target {primary or '<none>'} not found in shard {mem_file.stem}",
                                   new_id)
                            continue
                        res = llm.confirm_supersede(
                            self._main_runtime,
                            new_row.get("content") or "",
                            old_by_id[primary].get("content") or "")
                        self._append_llm_call_telemetry(llm, "confirm_supersede")
                        confirmed = bool(res.get("confirmed"))
                        # 6. State flip under the cross-process shard lock:
                        # new row candidate->confirmed + every superseded
                        # target row superseded_confirmed=True (same shard
                        # file, one RMW). Unconfirmed -> row stays
                        # candidate, nothing written.
                        if confirmed:
                            with self._shard_lock(mem_file):
                                with open(mem_file, "r", encoding="utf-8") as f:
                                    fresh = json.load(f)
                                changed = False
                                for r in fresh:
                                    if not isinstance(r, dict):
                                        continue
                                    rid = str(r.get("id"))
                                    if rid == new_id:
                                        r.setdefault("metadata", {})["supersede_state"] = "confirmed"
                                        r["updated_at"] = _utcnow().isoformat()
                                        changed = True
                                    elif rid in old_ids:
                                        r.setdefault("metadata", {})["superseded_confirmed"] = True
                                        # C3 terminal flip (only the NEGATION
                                        # channel defers the old-row invalidation
                                        # to this verdict — its write door extends
                                        # the pool only, 不自动作废旧行). For a
                                        # confirmed candidate the old row is the
                                        # terminal supersession target: mark it
                                        # superseded=True (the read-side out-pool /
                                        # auto-inject fold key) + the superseded_by
                                        # back-link. Idempotent + a no-op for the
                                        # 0.5 / O1 lanes, whose write doors already
                                        # set both — so those lanes' behavior is
                                        # unchanged; it is the REQUIRED flip for
                                        # C3, folding the old row out of auto-inject.
                                        r.setdefault("metadata", {})["superseded"] = True
                                        r["metadata"]["superseded_by"] = new_id
                                        r["updated_at"] = _utcnow().isoformat()
                                        changed = True
                                if changed:
                                    with open(mem_file, "w", encoding="utf-8") as f:
                                        json.dump(fresh, f, ensure_ascii=False, indent=2)
                        _audit(primary, confirmed, res.get("model_used", False),
                               res.get("reason", ""), new_id)
                    except Exception as e:
                        # 8. Single-item failure never breaks the batch —
                        # the candidate stays candidate (retry next tick).
                        logger.warning(f"FileMem: supersede confirm item {new_id} failed (kept candidate): {e}")
            logger.debug(f"FileMem: supersede confirm tick complete (N-cap={n_cap}, {len(cands)} pairs)")
        except Exception as e:
            # Whole-tick fail-soft: candidates stay candidate; they retry at
            # the next consolidation boundary (same posture as rescore).
            logger.warning(f"FileMem: supersede confirm tick failed (candidates kept candidate): {e}")
        finally:
            self._supersede_confirming = False

    def _mine_alias_candidates(self) -> None:
        """EP-3: alias-mining face — mine NEW topics' aliases on the host
        main-model face, into the local {storage}/aliases.json table.

        Same skeleton as _llm_consolidate / _supersede_confirm_candidates:
        _llm_ctx None -> skip (standalone, not an error); idempotence /
        concurrency guard; per-topic LLM budget N-cap
        (aliases.max_topics_per_tick, default 5 — overflow rolls to the next
        boundary tick; a SEPARATE budget from consolidation.max_llm_per_tick
        and EP-2's supersede_max_confirms — no overlap); append-only
        consolidation_log.jsonl audit rows; fail-soft everywhere (a single
        topic's exception never breaks the batch; a whole-tick exception
        leaves existing aliases intact — 不吞脏, new topics retry next
        boundary). The LLM call is consolidation/llm_caller.suggest_aliases
        — host main-model face (explicit main_runtime, no task key), zero
        hardcoded model names, zero custom api/provider config. LLM
        显式化◆: the gate is the provider's main_runtime snapshot (epic
        card 1); a missing snapshot = standalone skip, not an error. Topic
        candidates come from
        the same tokenize pipeline as the BM25 axis (search_index.tokenize
        over the semantic shards' content, word-frequency >=
        aliases.min_term_freq, top-N most frequent, INCREMENTAL: topics
        already in the alias table are never re-mined). Writes to
        aliases.json go through the cross-process _shard_lock RMW, append-
        only per topic (existing topics are preserved verbatim). aliases.json
        is a pure new file — the live memories/ and episodic/ trees are
        never written by this face."""
        if not getattr(self, "_main_runtime", None):
            return  # standalone usage (no host main_runtime) — skip, not an error
        if getattr(self, "_alias_mining_in_flight", False):
            logger.debug("FileMem: alias mining already in flight, skipping this spawn")
            return
        self._alias_mining_in_flight = True
        try:
            alias_cfg = self._decay.get("aliases") or {}
            n_cap = int(alias_cfg.get("max_topics_per_tick", 5))
            llm = _load_llm_caller()
            # Lazy import: search_index.py is pure stdlib; kept inside the
            # fail-soft gate (same posture as the search-side axis build).
            from search_index import tokenize
            # 1. Topical candidates: same tokenize pipeline as the BM25
            # axis (search_index.tokenize over the semantic shards' content,
            # word-frequency >= min_term_freq, top-N most frequent).
            freq = self._alias_topic_frequencies(tokenize)
            known = set((self._load_aliases().get("topics") or {}).keys())
            # INCREMENTAL: only topics NOT already in the alias table are
            # mined; the cap bites the FRESH list, overflow rolls next tick.
            fresh = [w for w, _ in sorted(freq, key=lambda kv: (-kv[1], kv[0]))
                     if w not in known][:n_cap]
            if not fresh:
                logger.debug("FileMem: alias mining no fresh topics, skipping (zero cost)")
                return  # call-level gate
            ts = _utcnow().isoformat()
            # 2. RMW the alias table under the cross-process shard lock
            # (append-only per topic: existing topics preserved verbatim).
            apath = self.storage_dir / "aliases.json"
            with self._shard_lock(apath):
                data = self._load_aliases()
                topics = data.get("topics") if isinstance(data, dict) else None
                if not isinstance(topics, dict):
                    topics = {}
                log_path = self.storage_dir / "consolidation_log.jsonl"
                log_path.parent.mkdir(parents=True, exist_ok=True)
                with open(log_path, "a", encoding="utf-8") as lf:
                    for topic in fresh:
                        try:
                            # Host-model alias suggestion (fail-soft inside:
                            # any exception -> aliases=[], model_used=False —
                            # an empty entry is a VERDICT of no-alias, it
                            # stays and widens nothing; the native keyword
                            # path is unaffected, 不吞脏).
                            res = llm.suggest_aliases(self._main_runtime, topic)
                            self._append_llm_call_telemetry(llm, "suggest_aliases")
                            entry = {
                                "aliases": sorted({a for a in res.get("aliases") or []}),
                                "source": "llm",
                                "ts": ts,
                            }
                            prev = topics.get(topic)
                            if isinstance(prev, dict) and prev.get("aliases"):
                                # Human-added aliases are durable: union, not
                                # overwrite (a deterministic human write is
                                # never clobbered by the LLM face).
                                merged = set(entry["aliases"]) | set(prev.get("aliases") or [])
                                entry["aliases"] = sorted(merged)
                                entry["source"] = "llm+human"
                            topics[topic] = entry
                            data["topics"] = topics
                            data["ts"] = ts
                            with open(apath, "w", encoding="utf-8") as f:
                                json.dump(data, f, ensure_ascii=False, indent=2)
                            lf.write(json.dumps({
                                "ts": ts, "action": "alias_mine", "topic": topic,
                                "aliases_count": len(entry["aliases"]),
                                "model_used": res.get("model_used", False),
                                "source_profile": getattr(self, "source_profile", "default"),
                            }, ensure_ascii=False) + "\n")
                        except Exception as e:
                            # 3. Single-topic failure never breaks the batch —
                            # the topic just isn't recorded; it retries next
                            # tick (incremental diff picks it back up).
                            logger.warning(f"FileMem: alias mining topic {topic} failed (batch continues): {e}")
            logger.info(f"FileMem: alias mining tick complete (N-cap={n_cap}, {len(fresh)} fresh topics)")
        except Exception as e:
            # Whole-tick fail-soft: existing aliases on disk are untouched
            # (the RMW region either committed per-topic or not at all); the
            # fresh topics roll to the next boundary tick (same posture as
            # rescore / confirm).
            logger.warning(f"FileMem: alias mining tick failed (existing aliases intact): {e}")
        finally:
            self._alias_mining_in_flight = False

    def _observe_consolidate(self) -> None:
        """EP-2 T2: observation-synthesis face — the host main model turns a
        topic's raw facts (knowledge/raw_pending.json) into ONE preference-
        neutral observation entry in knowledge/entries.json (kind=observation,
        supported_by + proof_count + value, T1 write contract).

        Same skeleton as _llm_consolidate / _supersede_confirm_candidates /
        _mine_alias_candidates: _llm_ctx None -> skip (standalone, not an
        error); idempotence / concurrency guard (_observing_in_flight);
        N-cap (knowledge.observe_max_per_tick, default 3 — a SEPARATE budget
        from consolidation.max_llm_per_tick / supersede_max_confirms /
        aliases.max_topics_per_tick, no overlap; overflow topics stay
        pending/stale and roll to the next boundary tick).

        INCREMENTAL: topics that already carry an active NON-stale
        observation are never re-synthesized; topics WITH a stale
        observation re-enter the face (rebuild + _mark_stale_observations
        clears the stale flag by superseding the stale entry — T1's I1
        semantics, 不 DELETE). raw facts per topic are capped at N=8
        (knowledge.observe_max_facts_per_topic) so the prompt stays bounded.

        The LLM call is consolidation/llm_caller.observe — host main-model
        face (explicit main_runtime, no task key), zero hardcoded model
        names, zero custom api/provider config. LLM 显式化◆: the gate is
        the provider's main_runtime snapshot (epic card 1); a missing
        snapshot = standalone skip, not an error. fail-soft everywhere: an
        empty observe
        reply (model down / trust gate) writes NOTHING — raw facts stay in
        raw_pending, retry next tick (不吞脏); supported_by bad-reference
        rejection is T1's upsert_observation gate (整条拒写 + 原文降级
        raw_pending, 留痕); a single topic's exception never breaks the
        batch; a whole-tick exception leaves every existing observation on
        disk intact (the RMW region commits per topic or not at all)."""
        if not getattr(self, "_main_runtime", None):
            return  # standalone usage (no host main_runtime) — skip, not an error
        if getattr(self, "_observing_in_flight", False):
            logger.debug("FileMem: observe consolidation already in flight, skipping this spawn")
            return
        self._observing_in_flight = True
        try:
            kcfg = (self._decay.get("knowledge") or {})
            n_cap = int(kcfg.get("observe_max_per_tick", 3))
            max_facts = int(kcfg.get("observe_max_facts_per_topic", 8))
            rp = getattr(self, "knowledge_raw_pending_path", None)
            # 1. Group raw_pending facts by topic (fields: {topic, content,
            # memory_ids, origin, reason, created_ts} — see _quarantine_raw_
            # pending). Deterministic order: topic asc, then (created_ts,
            # content) asc within a topic; facts deduped by memory id.
            raw: List[Dict] = []
            if rp is not None and rp.exists():
                try:
                    with open(rp, encoding="utf-8") as fh:
                        loaded = json.load(fh)
                    if isinstance(loaded, list):
                        raw = [r for r in loaded if isinstance(r, dict)]
                except (json.JSONDecodeError, OSError):
                    raw = []
            by_topic: Dict[str, List[Dict]] = {}
            for r in raw:
                t = str(r.get("topic") or "")
                if t:
                    by_topic.setdefault(t, []).append(r)
            for t in by_topic:
                by_topic[t].sort(key=lambda r: (str(r.get("created_ts") or ""),
                                                str(r.get("content") or "")))
            # 2. Incremental + stale diff over the observation entries.
            entries = self._read_knowledge_entries()
            active_by_topic: Dict[str, List[Dict]] = {}
            for e in entries:
                if e.get("kind") == "observation" and e.get("status") == "active":
                    active_by_topic.setdefault(str(e.get("topic") or ""), []).append(e)
            # Pre-filter (D): a topic enters the synthesis budget ONLY if at
            # least one of its raw rows carries a memory id that RESOLVES to a
            # real memory — membership in _memory_id_set() (the provenance set
            # of memories/*.json), NOT naive truthiness. A row that merely
            # carries a non-empty memory_ids list of dangling ids would slip a
            # truthiness check, burn an N-cap slot, then get I3-rejected by
            # upsert_observation and re-dropped BACK into raw_pending — a
            # circular source=sink self-feed. The membership test kills that
            # at the consumer: unresolved-id rows never enter the LLM budget.
            known_ids = self._memory_id_set()
            resolvable: Dict[str, bool] = {}
            for t, group in by_topic.items():
                resolvable[t] = any(
                    any(m in known_ids for m in (r.get("memory_ids") or []))
                    for r in group)
            jobs: List[str] = []
            stale_rebuild: set = set()
            for t in sorted(by_topic):
                obs = active_by_topic.get(t)
                if obs and not any(o.get("stale") is True for o in obs):
                    continue  # topic already has a fresh active observation — no re-mine
                if not resolvable.get(t):
                    continue  # nothing synthesizable — no budget burn
                jobs.append(t)
                if obs and any(o.get("stale") is True for o in obs):
                    stale_rebuild.add(t)
            # N-cap: overflow topics stay pending/stale -> roll to the next
            # boundary tick (raw_pending untouched, diff picks them back up).
            jobs = jobs[:n_cap]
            if not jobs:
                logger.debug("FileMem: observe consolidation nothing to synthesize, skipping (zero cost)")
                return  # call-level gate
            llm = _load_llm_caller()
            # 3. Per topic: stale topics first feed their merged raw text to
            # _mark_stale_observations (deterministic stale flag, T1) so the
            # search pool down-weights the old entry; observe() then rebuilds
            # the topic and upsert_observation's I1 supersedes the stale one.
            log_path = self.storage_dir / "consolidation_log.jsonl"
            sp = getattr(self, "source_profile", "default")
            successes: List[Dict] = []
            for t in jobs:
                try:
                    group = by_topic[t]
                    facts: List[Dict] = []
                    seen_ids: set = set()
                    # D: only ids that RESOLVE to a real memory back a supported_by
                    # reference; drop dangling ones so the LLM never synthesizes a
                    # supported_by entry that upsert_observation's I3 gate would
                    # reject and re-drop into raw_pending (the circular source=sink).
                    for r in group[:max_facts]:
                        mids = [m for m in (r.get("memory_ids") or [])
                                if m not in seen_ids and m in known_ids]
                        for m in mids:
                            seen_ids.add(m)
                            facts.append({"id": m, "content": str(r.get("content") or "")[:800]})
                        if not mids:
                            # raw row carries no resolvable memory ids (e.g.
                            # quarantined tool-dumps): it cannot back a
                            # supported_by reference, so skip it as a source.
                            continue
                    merged_text = "\n".join(
                        f"{f['id']}: {f['content']}" for f in facts)
                    if not facts:
                        # No raw row in this topic carries a resolvable
                        # memory id (e.g. quarantined tool-dumps): nothing
                        # can back a supported_by reference, so skip the
                        # LLM call for this topic — an empty prompt would
                        # synthesize over nothing. The topic stays in
                        # raw_pending and re-enters the diff next tick (不吞脏).
                        continue
                    if t in stale_rebuild and merged_text:
                        # T1 deterministic stale-marking (token overlap >=
                        # knowledge.stale_min_overlap) — no host save path
                        # is touched; the rebuild below clears the flag.
                        self._mark_stale_observations(t, merged_text)
                    res = llm.observe(self._main_runtime, t, facts)
                    self._append_llm_call_telemetry(llm, "observe")
                    obs_text = str(res.get("observation") or "").strip()
                    if not obs_text:
                        # LLM verdict / failure: write NOTHING. Raw facts
                        # stay in raw_pending — the next tick retries (the
                        # topic is still fresh-or-stale, so it re-enters
                        # the diff). 不吞脏.
                        logger.debug(f"FileMem: observe topic {t} empty "
                                     f"(model_used={res.get('model_used', False)}), "
                                     f"raw facts kept pending")
                        continue
                    oid = self.upsert_observation(
                        topic=t, content=obs_text,
                        supported_by=res.get("supported") or [],
                        value=res.get("value") or "medium",
                        session=getattr(self, "session_id", ""),
                    )
                    if oid is None:
                        # T1 I3 gate: bad supported_by reference -> whole
                        # entry refused + source text quarantined to
                        # raw_pending (origin=obs_unresolved_provenance).
                        # Leave a trace row; the topic retries next tick.
                        try:
                            log_path.parent.mkdir(parents=True, exist_ok=True)
                            with open(log_path, "a", encoding="utf-8") as lf:
                                lf.write(json.dumps({
                                    "ts": _utcnow().isoformat(),
                                    "action": "observe", "topic": t,
                                    "observation_id": None, "proof_count": 0,
                                    "model_used": res.get("model_used", False),
                                    "result": "rejected_bad_reference",
                                    "source_profile": sp,
                                }, ensure_ascii=False) + "\n")
                        except Exception as trace_e:
                            logger.debug(f"FileMem: observe rejection trace "
                                         f"{t} could not be logged: {trace_e}")
                        continue
                    successes.append({
                        "ts": _utcnow().isoformat(),
                        "action": "observe", "topic": t,
                        "observation_id": oid,
                        "proof_count": len(res.get("supported") or []),
                        "model_used": res.get("model_used", False),
                        "source_profile": sp,
                    })
                except Exception as e:
                    # Single-topic failure never breaks the batch — the
                    # topic stays pending/stale and retries next tick
                    # (existing observations on other topics are intact).
                    logger.warning(f"FileMem: observe topic {t} failed (batch continues): {e}")
            if successes:
                log_path.parent.mkdir(parents=True, exist_ok=True)
                with open(log_path, "a", encoding="utf-8") as lf:
                    for row in successes:
                        lf.write(json.dumps(row, ensure_ascii=False) + "\n")
            logger.info(f"FileMem: observe consolidation tick complete "
                       f"(N-cap={n_cap}, {len(jobs)} topics, {len(successes)} written)")
        except Exception as e:
            # Whole-tick fail-soft: existing observations on disk are
            # untouched (per-topic RMW committed or not); overflow + failed
            # topics roll to the next boundary tick (same posture as
            # rescore / confirm / alias mining).
            logger.warning(f"FileMem: observe consolidation tick failed (existing observations intact): {e}")
        finally:
            self._observing_in_flight = False

    def _alias_topic_frequencies(self, tokenize_fn) -> List[tuple]:
        """EP-3: word-frequency over the semantic shards' content using the
        SAME tokenize pipeline as the BM25 axis (search_index.tokenize —
        latin words + CJK n-grams), gated by aliases.min_term_freq.

        A word-token is a topic candidate iff it appears in >= min_term_freq
        DISTINCT items (cross-item frequency, like BM25's df — word-runs
        inside a single item are item-specific, not topical). CJK n-grams are skipped (the 2..4 fan-out inflates
        df of every CJK word; canonical CJK topics are human-mined via the
        CLI, not frequency-mined). Returns [(word, freq), ...] sorted
        freq-desc, word-asc (deterministic), already freq-gated; the caller
        applies the incremental diff + N-cap.

        P3: config-driven noise filter. After the [a-z0-9]+ word gate and
        BEFORE the df accumulation, tokens are dropped when (a) len <
        aliases.topic_min_len (single-char / single-digit junk like 'a', '1')
        or (b) the token is in aliases.topic_stopwords (lowercase exact-match
        English-noise / tech-generic table). FAIL-SOFT + backward-compatible:
        the filter engages ONLY when the decay config CARRIES the knobs — a
        pre-P3 user decay.json whose aliases block predates topic_min_len /
        topic_stopwords (keys absent) keeps today's exact unfiltered
        behavior. The merged/fresh defaults carry the knobs, so a normal
        config filters; only an explicitly key-absent block reverts to the
        legacy path (a corrupt / non-list stopwords table also degrades to
        "no stopword drop", never breaks the mining path)."""
        alias_cfg = self._decay.get("aliases") or {}
        min_freq = int(alias_cfg.get("min_term_freq", 3))
        # P3 noise gate: present-if-keys (fail-soft) — NOT a .get(key, default),
        # so a key-absent aliases block (pre-P3 config) skips filtering
        # entirely. The merged defaults always carry the keys, so a normal
        # config filters with topic_min_len=2 + the default stopword table.
        have_filter = ("topic_min_len" in alias_cfg) or ("topic_stopwords" in alias_cfg)
        topic_min_len = 2
        topic_stopwords: frozenset = frozenset()
        if have_filter:
            try:
                topic_min_len = int(alias_cfg.get("topic_min_len", 2))
            except (TypeError, ValueError):
                topic_min_len = 2
            raw_sw = alias_cfg.get("topic_stopwords", [])
            # tolerate non-list / corrupt shapes fail-soft (a bad table must
            # never break the mining path — degrade to "no stopword drop").
            if isinstance(raw_sw, (list, tuple, set)):
                topic_stopwords = frozenset(str(w).lower() for w in raw_sw if str(w).strip())
        df: Dict[str, int] = {}
        for mem_type in MEMORY_TYPES:
            mem_file = self.memories_dir / f"{mem_type}.json"
            if not mem_file.exists():
                continue
            try:
                with open(mem_file, encoding="utf-8") as f:
                    items = json.load(f)
            except (json.JSONDecodeError, OSError):
                continue
            for it in items:
                if not isinstance(it, dict):
                    continue
                toks = tokenize_fn(it.get("content") or "")
                # Only word-tokens ([a-z0-9]+) are topic candidates — see
                # docstring.
                for w in set(toks):
                    if re.fullmatch(r"[a-z0-9]+", w):
                        # P3 noise gate: drop single-char / short tokens and
                        # config stopwords before counting (only when the
                        # config carries the knobs — fail-soft above).
                        if have_filter and (len(w) < topic_min_len or w in topic_stopwords):
                            continue
                        df[w] = df.get(w, 0) + 1
        return [(w, c) for w, c in df.items() if c >= min_freq]

    # ── S3: dream semantic faces (4 new LLM faces + mixed water-level trigger) ──
    # Closes the blind spot the existing 4 faces leave: "semantically equivalent
    # / reworded / cross-shard" rows the same-shard token-overlap EP-1 gate
    # never sees. Each face follows the EXACT skeleton of the existing faces:
    # main_runtime gate -> in-flight guard -> call-level 0-hit skip ->
    # independent N-cap budget -> per-pair LLM fail-soft -> append-only audit.
    # Zero new provider/model config; zero hardcoded model names; fail-soft
    # everywhere (a broken call never marks/folds anything it shouldn't).

    def _s3_pair_candidates(self, min_overlap: float) -> List[Dict[str, Any]]:
        """S3 coarse filter: cross-shard (or same-shard) row PAIRS whose
        token sets overlap >= min_overlap. Reuses the EP-1 Jaccard primitive
        (_content_overlap_score over _lineage_token_set) so the LLM face
        only ever sees HIGH-similarity pairs (cost control: never feeds the
        host the full pool). Deterministic: pairs sorted by (-overlap, id).

        Excludes already-superseded / already-stale rows (they are out of the
        live pool already — re-folding them is wasted budget). Returns
        [{"a": row, "b": row, "overlap": float}, ...].
        """
        # Flatten the live rows across all shards, keeping the shard label so
        # the caller can decide same-shard vs cross-shard behavior.
        live: List[Dict[str, Any]] = []
        for mem_type in MEMORY_TYPES:
            mem_file = self.memories_dir / f"{mem_type}.json"
            if not mem_file.exists():
                continue
            try:
                with open(mem_file, encoding="utf-8") as fh:
                    rows = json.load(fh)
            except (json.JSONDecodeError, OSError):
                continue
            for r in rows:
                if not isinstance(r, dict) or r.get("id") is None:
                    continue
                meta = r.get("metadata") or {}
                if not isinstance(meta, dict):
                    continue
                if meta.get("superseded") is True or meta.get("stale") is True:
                    continue  # already out of the live pool
                live.append(r)
        toks = {id(r): _lineage_token_set(r.get("content") or "") for r in live}
        cands: List[Dict[str, Any]] = []
        n = len(live)
        for i in range(n):
            for j in range(i + 1, n):
                a, b = live[i], live[j]
                ta, tb = toks.get(id(a), set()), toks.get(id(b), set())
                if not ta or not tb:
                    continue
                ov = len(ta & tb) / len(ta | tb) if (ta | tb) else 0.0
                if ov >= min_overlap:
                    cands.append({"a": a, "b": b, "overlap": ov})
        cands.sort(key=lambda c: (-c["overlap"],
                                  str(c["a"].get("id")), str(c["b"].get("id"))))
        return cands

    def _semantic_merge_consolidate(self) -> None:
        """S3 ①: cross-shard semantic-equivalent merge face.

        Coarse-filter HIGH-overlap row pairs (this-shard OR cross-shard) with
        _s3_pair_candidates, then ask the host LLM whether each pair states
        the SAME fact (reworded / split / cross-category duplicate). A confirmed
        merge marks the loser row superseded=True (soft flag, reversible —
        reuses the EP-2 supersede mechanism, no DELETE). Folded pairs are
        skipped next tick (the loser leaves the live pool -> the coarse filter
        drops it -> idempotent). Independent budget semantic_merge_max_per_tick
        (default 4; overflow rolls to the next boundary tick). Fail-soft:
        ANY exception (model down / bad reference / torn write) leaves the pair
        unmerged — 不吞脏, 不静默; a bad verdict is NEVER auto-applied.
        """
        if not getattr(self, "_main_runtime", None):
            self._audit_tick_skip("main_runtime missing")
            return
        if getattr(self, "_semantic_merging", False):
            logger.debug("FileMem: S3 semantic-merge already in flight, skipping")
            return
        self._semantic_merging = True
        try:
            scfg = (self._decay.get("consolidation") or {})
            n_cap = int(scfg.get("semantic_merge_max_per_tick", 4))
            min_ov = float((self._decay.get("search") or {}).get("supersede_min_overlap", 0.5))
            cands = self._s3_pair_candidates(min_ov)[:n_cap]
            if not cands:
                logger.debug("FileMem: S3 semantic-merge no high-overlap pairs, skipping (zero cost)")
                return
            llm = _load_llm_caller()
            log_path = self.storage_dir / "consolidation_log.jsonl"
            sp = getattr(self, "source_profile", "default")
            # 🟡 cross-face guard: a FRESH per-tick set so the contradiction
            # face (same tick, runs after merge) only skips pairs folded THIS
            # tick — folds from a previous tick already left the live pool
            # (out of _s3_pair_candidates) and don't need the guard.
            self._s3_folds_this_tick = set()
            merged = 0
            with open(log_path, "a", encoding="utf-8") as lf:
                for c in cands:
                    try:
                        a, b = c["a"], c["b"]
                        # Deterministic survivor ordering: newer created_at wins
                        # (same-second tie -> higher id), so the LLM's "keep"
                        # is bounded to this pair's two ids.
                        order = sorted([a, b], key=lambda r: (str(r.get("created_at") or ""),
                                                              str(r.get("id") or "")))
                        new_row, old_row = order[-1], order[0]
                        res = llm.merge_semantic(
                            self._main_runtime,
                            {"id": old_row.get("id"), "content": old_row.get("content"),
                             "created_at": old_row.get("created_at")},
                            {"id": new_row.get("id"), "content": new_row.get("content"),
                             "created_at": new_row.get("created_at")})
                        self._append_llm_call_telemetry(llm, "merge_semantic")
                        if not res.get("same_fact") or not res.get("model_used"):
                            continue  # not the same fact OR model unavailable -> no fold
                        keep_id = res.get("keep") or str(new_row.get("id"))
                        # 🔴 pair-boundary guard: the LLM's "keep" must name a
                        # row that is actually IN THIS PAIR. A hallucinated
                        # out-of-pair id would otherwise flip loser to the
                        # wrong row and point superseded_by at a non-existent
                        # winner (lineage break). Mirrors the contradiction
                        # face's stale_id-in-pair refusal.
                        pair_ids = {str(old_row.get("id")), str(new_row.get("id"))}
                        if keep_id not in pair_ids:
                            logger.warning(f"FileMem: S3 semantic-merge keep={keep_id!r} "
                                           f"outside pair {pair_ids}; fold refused (fail-soft)")
                            continue
                        loser_id = str(old_row.get("id")) if keep_id == str(new_row.get("id")) \
                            else str(new_row.get("id"))
                        winner_id = keep_id
                        # 💭 legacy rows may lack "type" -> "None.json" would crash the
                        # shard path; fall back to "fact" (the default shard).
                        loser_type = str(
                            (old_row.get("type") if keep_id == str(new_row.get("id"))
                             else new_row.get("type")) or "fact")
                        mem_file = self.memories_dir / f"{loser_type}.json"
                        with self._shard_lock(mem_file):
                            items = self._read_memories_file(mem_file)
                            touched = False
                            for it in items:
                                if str(it.get("id")) == loser_id:
                                    m = it.setdefault("metadata", {})
                                    m["superseded"] = True
                                    m["superseded_by"] = winner_id
                                    m["supersede_reason"] = "s3_semantic_merge"
                                    it["updated_at"] = _utcnow().isoformat()
                                    touched = True
                            if touched:
                                with open(mem_file, "w", encoding="utf-8") as f:
                                    json.dump(items, f, ensure_ascii=False, indent=2)
                        if not touched:
                            continue  # bad reference (loser not in shard) -> traced, no fold
                        lf.write(json.dumps({
                            "ts": _utcnow().isoformat(), "action": "semantic_merge",
                            "keep": winner_id, "superseded": loser_id,
                            "overlap": round(c["overlap"], 4),
                            "model_used": True, "source_profile": sp,
                        }, ensure_ascii=False) + "\n")
                        merged += 1
                        # 🟡 cross-face guard: record this pair as folded THIS tick
                        # so the contradiction face (runs after merge, same tick)
                        # does not re-LLM a pair whose loser is already superseded.
                        _folded = getattr(self, "_s3_folds_this_tick", None)
                        if _folded is None:
                            _folded = set()
                            self._s3_folds_this_tick = _folded
                        _folded.add(frozenset((str(a.get("id")), str(b.get("id")))))
                    except Exception as e:
                        logger.warning(f"FileMem: S3 semantic-merge pair failed ({e}); "
                                       f"pair left unmerged (batch continues)")
            logger.info(f"FileMem: S3 semantic-merge folded {merged} pair(s) this tick (N-cap={n_cap})")
        except Exception as e:
            logger.warning(f"FileMem: S3 semantic-merge tick failed (pairs retry next boundary): {e}")
        finally:
            self._semantic_merging = False

    def _contradiction_detect(self) -> None:
        """S3 ②: coexisting-rows contradiction-detection face.

        Coarse-filter HIGH-overlap live row pairs (same topic, so likely about
        the same subject) with _s3_pair_candidates, then ask the host LLM
        whether the two MUTUALLY EXCLUDE (cannot both be true). A confirmed
        contradiction marks the OLDER row metadata.stale=True (the read-side
        down-weight / observe-rebuild path already consumes this flag — reuses
        the existing stale mechanism, no new read-side code). Independent
        budget contradiction_max_per_tick (default 4). Fail-soft: ANY exception
        leaves both rows intact (never mark stale on a broken call — a
        false-positive stale is worse than a missed one); 不吞脏.
        """
        if not getattr(self, "_main_runtime", None):
            self._audit_tick_skip("main_runtime missing")
            return
        if getattr(self, "_contradiction_scanning", False):
            logger.debug("FileMem: S3 contradiction-scan already in flight, skipping")
            return
        self._contradiction_scanning = True
        try:
            scfg = (self._decay.get("consolidation") or {})
            n_cap = int(scfg.get("contradiction_max_per_tick", 4))
            min_ov = float((self._decay.get("search") or {}).get("supersede_min_overlap", 0.5))
            cands = self._s3_pair_candidates(min_ov)[:n_cap]
            if not cands:
                logger.debug("FileMem: S3 contradiction no high-overlap pairs, skipping (zero cost)")
                return
            llm = _load_llm_caller()
            log_path = self.storage_dir / "consolidation_log.jsonl"
            sp = getattr(self, "source_profile", "default")
            marked = 0
            # 🟡 cross-face guard: skip any pair the merge face ALREADY folded
            # this tick (its loser is superseded + out of the live pool) — a
            # re-LLM on the same pair would double-spend budget and fight the
            # merge verdict (superseded vs stale). The set is fresh per tick
            # (the merge face seeds it; absent/empty = no folds, fall through).
            folded_pairs = getattr(self, "_s3_folds_this_tick", set()) or set()
            with open(log_path, "a", encoding="utf-8") as lf:
                for c in cands:
                    try:
                        a, b = c["a"], c["b"]
                        if frozenset((str(a.get("id")), str(b.get("id")))) in folded_pairs:
                            continue  # already folded by the merge face this tick
                        # Older row is the one most likely to be stale.
                        ts_a = str(a.get("created_at") or a.get("updated_at") or "")
                        ts_b = str(b.get("created_at") or b.get("updated_at") or "")
                        older, newer = (a, b) if ts_a <= ts_b else (b, a)
                        res = llm.detect_contradiction(
                            self._main_runtime,
                            {"id": older.get("id"), "content": older.get("content"),
                             "created_at": ts_a if older is a else ts_b},
                            {"id": newer.get("id"), "content": newer.get("content"),
                             "created_at": ts_b if older is a else ts_a})
                        self._append_llm_call_telemetry(llm, "detect_contradiction")
                        if not res.get("contradiction") or not res.get("model_used"):
                            continue  # complementary OR model unavailable -> no mark
                        stale_id = res.get("stale_id")
                        if stale_id not in (str(older.get("id")), str(newer.get("id"))):
                            continue  # LLM named an id outside the pair -> refuse (fail-soft)
                        # 💭 legacy rows may lack "type" -> "None.json" would crash the
                        # shard path; fall back to "fact" (the default shard) so a missing
                        # type degrades to the fact shard instead of a hard error.
                        stale_type = str(
                            (older.get("type") if stale_id == str(older.get("id"))
                             else newer.get("type")) or "fact")
                        mem_file = self.memories_dir / f"{stale_type}.json"
                        with self._shard_lock(mem_file):
                            items = self._read_memories_file(mem_file)
                            touched = False
                            for it in items:
                                if str(it.get("id")) == stale_id:
                                    m = it.setdefault("metadata", {})
                                    m["stale"] = True
                                    m["stale_reason"] = "s3_contradiction"
                                    it["updated_at"] = _utcnow().isoformat()
                                    touched = True
                            if touched:
                                with open(mem_file, "w", encoding="utf-8") as f:
                                    json.dump(items, f, ensure_ascii=False, indent=2)
                        if not touched:
                            continue
                        lf.write(json.dumps({
                            "ts": _utcnow().isoformat(), "action": "contradiction_detect",
                            "stale_id": stale_id, "other_id": (
                                str(newer.get("id")) if stale_id == str(older.get("id"))
                                else str(older.get("id"))),
                            "model_used": True, "source_profile": sp,
                        }, ensure_ascii=False) + "\n")
                        marked += 1
                    except Exception as e:
                        logger.warning(f"FileMem: S3 contradiction pair failed ({e}); "
                                       f"rows left intact (batch continues)")
            logger.info(f"FileMem: S3 contradiction marked {marked} row(s) stale this tick (N-cap={n_cap})")
        except Exception as e:
            logger.warning(f"FileMem: S3 contradiction tick failed (rows retry next boundary): {e}")
        finally:
            self._contradiction_scanning = False

    def _salience_decay_downweight(self) -> None:
        """S3 ③: staleness auto-downweight face (DETERMINISTIC, zero LLM).

        A live row that (a) has been SUPERSEDED by a newer fact (metadata.
        superseded=True) OR is flagged stale, AND (b) is OLD (low /
        long-unreferred) gets its salience pulled DOWN toward the floor so it
        sinks out of the injection hot-zone — old, refuted memories naturally
        stop crowding recall. Pure deterministic rule (no host call): it reads
        the existing reference_count / last_referenced / superseded / stale
        signals. Idempotent (same pool twice -> byte-identical). Never DELETES
        — only lowers a number; the row stays fully readable/audit-able.
        Gated by salience_decay_enabled (default True).
        """
        if getattr(self, "_salience_decay_running", False):
            logger.debug("FileMem: S3 salience-decay already in flight, skipping")
            return
        self._salience_decay_running = True
        try:
            scfg = (self._decay.get("consolidation") or {})
            if scfg.get("salience_decay_enabled", True) is False:
                logger.debug("FileMem: S3 salience-decay disabled by config, skipping")
                return
            floor = float(scfg.get("salience_decay_floor", 0.1))
            now_ts = _utcnow().timestamp()
            # Age gate: only rows whose last reference is > this many days old
            # (or never referenced) are candidates for the sink — active hot
            # rows are left alone regardless of their flags. 🟡 the threshold
            # is now a knob (salience_decay_age_days, default 30) so users who
            # want more aggressive sinking can lower it without a code change.
            try:
                age_days = float(scfg.get("salience_decay_age_days", 30))
            except (TypeError, ValueError):
                age_days = 30.0
            log_path = self.storage_dir / "consolidation_log.jsonl"
            sp = getattr(self, "source_profile", "default")
            changed = 0
            with open(log_path, "a", encoding="utf-8") as lf:
                for mem_type in MEMORY_TYPES:
                    mem_file = self.memories_dir / f"{mem_type}.json"
                    if not mem_file.exists():
                        continue
                    with self._shard_lock(mem_file):
                        items = self._read_memories_file(mem_file)
                        dirty = False
                        for it in items:
                            if not isinstance(it, dict):
                                continue
                            meta = it.get("metadata") or {}
                            flagged = (isinstance(meta, dict) and
                                       (meta.get("superseded") is True or meta.get("stale") is True))
                            if not flagged:
                                continue  # not refuted/stale -> never downweight (conservative)
                            last_ref = it.get("last_referenced") or ""
                            age = 0.0
                            if last_ref:
                                try:
                                    age = (now_ts - datetime.fromisoformat(
                                        last_ref.replace("Z", "+00:00")).timestamp()) / 86400.0
                                except Exception:
                                    age = age_days  # unparseable -> treat as old (still conservative: flagged)
                            if age < age_days:
                                continue  # recently referenced -> still hot, don't sink
                            cur = it.get("salience")
                            if cur is None:
                                continue
                            try:
                                cur = float(cur)
                            except (TypeError, ValueError):
                                continue
                            if cur > floor:
                                it["salience"] = round(floor, 4)
                                it["updated_at"] = _utcnow().isoformat()
                                dirty = True
                                changed += 1
                        if dirty:
                            with open(mem_file, "w", encoding="utf-8") as f:
                                json.dump(items, f, ensure_ascii=False, indent=2)
                    # 🔴 审计行必须写进 with-open 的 lf 块内 — 之前在块外写,
                    # lf 已 close -> "I/O operation on closed file" 被 fail-soft
                    # 吞掉 -> 降权照常但审计行永远丢失 (North Star #1 gap).
                if changed:
                    lf.write(json.dumps({
                        "ts": _utcnow().isoformat(), "action": "salience_decay",
                        "downweighted": changed, "model_used": False,
                        "source_profile": sp,
                    }, ensure_ascii=False) + "\n")
            logger.info(f"FileMem: S3 salience-decay downweighted {changed} row(s) this tick")
        except Exception as e:
            logger.warning(f"FileMem: S3 salience-decay tick failed (rows intact): {e}")
        finally:
            self._salience_decay_running = False

    def _aggregate_consolidate(self) -> None:
        """S3 ④: topic aggregation face — fold a topic's fragmentary facts into
        ONE durable L1/L2-level conclusion, feeding the L0->L1->L2 promotion
        loop. Reuses the observe face's upsert_observation write path (T1
        contract: kind=aggregation, supported_by provenance-gated, I1 no
        DELETE). Coarse source = raw_pending topics (the same provenance pool
        the observe face already reads), grouped + N-capped. Independent
        budget aggregate_max_per_tick (default 2 — aggregation is the most
        expensive face, smallest budget). Fail-soft: ANY exception writes
        nothing; fragments stay in raw_pending, retry next tick (不吞脏).
        """
        if not getattr(self, "_main_runtime", None):
            self._audit_tick_skip("main_runtime missing")
            return
        if getattr(self, "_aggregating", False):
            logger.debug("FileMem: S3 aggregation already in flight, skipping")
            return
        self._aggregating = True
        try:
            kcfg = (self._decay.get("knowledge") or {})
            scfg = (self._decay.get("consolidation") or {})
            n_cap = int(scfg.get("aggregate_max_per_tick", 2))
            rp = getattr(self, "knowledge_raw_pending_path", None)
            raw: List[Dict] = []
            if rp is not None and rp.exists():
                try:
                    with open(rp, encoding="utf-8") as fh:
                        loaded = json.load(fh)
                    if isinstance(loaded, list):
                        raw = [r for r in loaded if isinstance(r, dict)]
                except (json.JSONDecodeError, OSError):
                    raw = []
            by_topic: Dict[str, List[Dict]] = {}
            for r in raw:
                t = str(r.get("topic") or "")
                if t:
                    by_topic.setdefault(t, []).append(r)
            jobs = sorted(by_topic)[:n_cap]  # deterministic topic order
            if not jobs:
                logger.debug("FileMem: S3 aggregation no raw_pending topics, skipping (zero cost)")
                return
            llm = _load_llm_caller()
            log_path = self.storage_dir / "consolidation_log.jsonl"
            sp = getattr(self, "source_profile", "default")
            known_ids = self._memory_id_set()
            made = 0
            for t in jobs:
                try:
                    group = by_topic[t]
                    facts: List[Dict] = []
                    seen: set = set()
                    for r in group[:8]:
                        mids = [m for m in (r.get("memory_ids") or [])
                                if m not in seen and m in known_ids]
                        for m in mids:
                            seen.add(m)
                            facts.append({"id": m, "content": str(r.get("content") or "")[:600]})
                    if not facts:
                        continue  # no resolvable source -> nothing to aggregate (no budget burn)
                    res = llm.aggregate(self._main_runtime, t, facts)
                    self._append_llm_call_telemetry(llm, "aggregate")
                    concl = str(res.get("conclusion") or "").strip()
                    if not concl or not res.get("model_used"):
                        continue  # empty / model unavailable -> nothing written (不吞脏)
                    new_id = self.upsert_observation(
                        topic=t, content=concl,
                        supported_by=[{"id": f["id"], "quote": f["content"][:120]}
                                      for f in facts if f.get("id")],
                        value=res.get("value") or "medium",
                        session=getattr(self, "session_id", ""))
                    if new_id is None:
                        continue  # provenance I3 reject -> source quarantined, retry next tick
                    with open(log_path, "a", encoding="utf-8") as lf:
                        lf.write(json.dumps({
                            "ts": _utcnow().isoformat(), "action": "aggregate_consolidate",
                            "topic": t, "entry_id": new_id, "value": res.get("value") or "medium",
                            "model_used": True, "source_profile": sp,
                        }, ensure_ascii=False) + "\n")
                    made += 1
                except Exception as e:
                    logger.warning(f"FileMem: S3 aggregation topic {t!r} failed ({e}); "
                                   f"fragments kept (batch continues)")
            logger.info(f"FileMem: S3 aggregation synthesized {made} topic(s) this tick (N-cap={n_cap})")
        except Exception as e:
            logger.warning(f"FileMem: S3 aggregation tick failed (fragments intact): {e}")
        finally:
            self._aggregating = False

    def _audit_recall(self, hits: int, reason_trivial: bool,
                      reinforced: Optional[int] = None,
                      durable_hits: Optional[int] = None) -> None:
        """S1b F5: one interval-throttled `recall_audit` row (North Star #3
        self-proof face: _reinforce_recall had 0 production successes, so
        reference_count was pinned at 0 — this row proves WHEN the loop
        finally bumps and whether a recall was trivial / 0-hit).

        Shape: {action: recall_audit, hits, reinforced, reason_trivial,
        durable_hits?, session_id, source_profile}. `reinforced`/
        `durable_hits` default to the _reinforce_recall counters when None.

        Throttle: AT MOST ONE row per `recall_audit_interval_min` window
        (separate decay key, default 60 — a busy recall loop never floods
        consolidation_log). Zero LLM, one jsonl append, fail-soft: an audit
        hiccup must NEVER change the recall outcome (the context is already
        returned regardless)."""
        try:
            cfg = (getattr(self, "_decay", None) or {}).get("consolidation") or {}
            try:
                interval_min = float(cfg.get("recall_audit_interval_min", 60) or 0)
            except (TypeError, ValueError):
                interval_min = 60.0
            now = time.time()
            last = getattr(self, "_last_recall_audit_ts", 0.0) or 0.0
            if interval_min > 0 and (now - last) < interval_min * 60.0:
                return  # throttle: one recall_audit row per window, silent otherwise
            self._last_recall_audit_ts = now
            stats = getattr(self, "_last_recall_stats", None) or {}
            self._append_consolidation_event({
                "ts": _utcnow().isoformat(),
                "action": "recall_audit",
                "hits": int(hits),
                "reinforced": int(reinforced) if reinforced is not None else int(stats.get("reinforced", 0)),
                "reason_trivial": bool(reason_trivial),
                "durable_hits": int(durable_hits) if durable_hits is not None else int(stats.get("durable_hits", 0)),
                "session_id": getattr(self, "session_id", None) or "default",
                "source_profile": getattr(self, "source_profile", "default"),
            })
        except Exception as e:
            # audit hiccup must never change the recall outcome (fail-soft)
            logger.debug(f"FileMem: recall_audit write failed: {e}")


# Step-number / step-list markers: English `Step 1`, CJK `第1步/第1条`,
# inline or line-head numbered items. Both branches cover the full
# closing-punct set (`.` ASCII dot, `)` `、` `．`): the line-head branch
# `\n\s*\d{1,2}\s*[.)、．]\s` and the inline branch
# `\d{1,2}\s*[.)〕、．]\s+\S` (P0-1b: inline now includes the ASCII dot —
# an inlined first step after CJK `。` is no longer a gate bypass).
# Pure stdlib regex.
_TASK_STEP_RE = re.compile(
    r"(?:\bsteps?\s+\d+\b"
    r"|\b第\s*\d+\s*(?:步|条|点|阶段)"
    r"|\n\s*\d{1,2}\s*[.)、．]\s"
    r"|(?<!\d)\d{1,2}\s*[.)〕、．]\s+\S)",
    re.IGNORECASE,
)


def ingress_reject_class(content: Optional[str],
                        decay_cfg: Optional[Dict[str, Any]] = None) -> Optional[str]:
    """P0-1: classify content against the three shared-store contamination
    classes. Returns the reject-class string
    (``host_instruction_block`` / ``raw_tool_output`` / ``whole_task_prompt``)
    when the content must NOT enter the memory pool, else None to pass.
    Order (a)->(b)->(c)->None. Pure rule + stdlib re/len, zero LLM; never
    raises on any input (the caller's fail-open contract is enforced upstream).

    P0-3 (写侧 ingress 切同表): the ``raw_tool_output`` leg (b) is now
    「3 键恒活 (the code default — ``_looks_like_tool_dump`` + the
    ``<untrusted_tool_result`` prefix, ZERO regression) OR the shared
    egress-noise OPENER tables (``egress_noise.tool_dump_openers`` /
    ``egress_noise.fragment_prefixes``, startswith semantics, via the
    single shared ``_noise_table_hit`` helper so the write face and the
    egress cut can never drift apart). ``decay_cfg=None`` (or any
    malformed block) leaves the P0-1 code-only behavior exactly in place —
    the superset gate: every row the P0-1 3-key gate rejected is still
    rejected, and only table-extended rows land additionally. Fail-soft:
    a malformed table degrades to "no table hit" (this leg falls back to
    the code default), never to a raise."""
    s = (content or "").strip()
    if not s:
        return None
    # (a) host / cron instruction-block opener — match the block's OPENING only
    # (a fact that merely QUOTES "[CONTEXT COMPACTION" mid-text stays).
    head = s.lstrip()[:_HOST_INSTRUCTION_WINDOW]
    for pfx in _HOST_INSTRUCTION_PREFIXES:
        if head.startswith(pfx):
            return "host_instruction_block"
    # (b) raw tool output: <untrusted_tool_result framing OR a bare JSON dump
    # (reuses the _looks_like_tool_dump single source of truth — one wiring).
    # P0-3 superset gate: the 3-key code default stays always-live (zero
    # regression) OR the shared egress-noise OPENER tables
    # (tool_dump_openers + fragment_prefixes, startswith — one table wired
    # into BOTH faces via the _noise_table_hit helper; decay_cfg=None / a
    # malformed block degrades this OR-leg to "no table hit", i.e. the
    # P0-1 code-only behavior — fail-soft, never a raise).
    if s.startswith(_TOOL_OUTPUT_PREFIX) or _looks_like_tool_dump(s) \
            or _noise_table_hit(s, decay_cfg):
        return "raw_tool_output"
    # (c) whole task prompt: >=1000 chars AND >=3 step-number / step-list
    # markers (a real *list*, not a single passing "Step 1" mention).
    if len(s) >= _TASK_PROMPT_MIN_CHARS:
        if len(_TASK_STEP_RE.findall(s)) >= _TASK_PROMPT_MIN_STEPS:
            return "whole_task_prompt"
    return None


# ── P0-2 read-side hard isolation (auto-retrieve face) + recall denoise ──────
# Root cause of post-compact task drift: the pre_llm_call auto-recall pulled
# CROSS-PROFILE stale task rows (the 4d cron crawler) into the default
# session. P0-1 fixed the WRITE face (ingress gate); P0-2 fixes the READ face.
# The shared neutral store (~/.hermes/filemem) aggregates every profile + cron,
# and rows are stamped `source_profile` at write time (metadata.source_profile
# for memories/*.json rows, top-level for episodic shard rows). The auto-inject
# face now recalls ONLY:
#   - rows whose effective source_profile == the current session's profile
#   - NEUTRAL unstamped rows (no source_profile key / empty legacy row)
# Cross-profile rows stay on disk AND stay visible to the EXPLICIT
# filemem_search face (a user's deliberate query is never isolation-cut) —
# only the auto-inject face is gated. Pure rule + stdlib, zero LLM; an
# unresolvable session profile FAILS OPEN (full recall, today's behavior) with
# a single INFO log line + the P0-1 _fail_open_count counter — it must never
# lock the host.


def _resolve_session_profile(fallback_profile: Optional[str] = None) -> Optional[str]:
    """P0-2: the CURRENT session's owning profile, provided by the HOST.

    Resolution order (host-provided identity — the plugin NEVER probes home
    itself, 零硬编码路径):
      1. the engine-resolved provider identity (``fallback_profile`` =
         ``self.source_profile``, derived from the host's per-session
         ``hermes_home`` at ``initialize()``). The MOST SPECIFIC signal for the
         current session: it is the exact profile this provider instance was
         initialized for, so it catches the default profile and the
         multiplexed-gateway case where a process-global env var cannot
         represent N served profiles. A bare shell that never ran
         ``initialize()`` has no instance identity and falls through to 2.
      2. the process-global ``HERMES_PROFILE`` env var — the kanban dispatcher /
         TUI pin it on single-profile workers (the same convention
         ``tools/cleanup_raw_pending.py`` reads via ``_caller_profile``).
    Returns the profile name, or None when UNRESOLVABLE (neither source yields
    a name) -> the caller FAILS OPEN (no isolation, full recall = today's
    behavior) + a single warning. A missing identity can never silently drop
    recall; a blank value is None, never a guessed default.

    Instance-before-env is deliberate: the per-session identity (1) is strictly
    more specific than a process-global env hint (2), and it is what keeps the
    recall deterministically self-consistent for a synthetic provider that was
    built as one profile while the process env carries a different one."""
    fb = (fallback_profile or "").strip()
    if fb:
        return fb
    raw = os.environ.get("HERMES_PROFILE", "").strip()
    return raw or None


_HOST_PATH_NOISE = frozenset({"hermes", ".hermes"})


def _normalize_search_text(query: str, extra_noise: Optional[set] = None) -> str:
    """P0-2 denoise ②: strip host-path noise from the auto face's search text
    so a host path token (`<HERMES_HOME>`, `~/.hermes`) and the bare host word
    that only survives inside a path (`hermes`) do NOT take part in matching —
    "hermes" must stop co-occurring with every path row. Pure string/stdlib,
    zero LLM; empty input is returned unchanged (fail-soft). The EXPLICIT face
    passes its raw query and never uses this."""
    s = (query or "").strip()
    if not s:
        return s
    noise = set(_HOST_PATH_NOISE)
    if extra_noise:
        noise.update(t.lower() for t in extra_noise if t)
    kept = []
    for tok in s.split():
        low = tok.lower().strip()
        if not low:
            continue
        # An absolute / home path token never matches (drops the path AND the
        # host word riding in it — "<HERMES_HOME>" takes its "hermes" with it).
        if low.startswith("/") or low.startswith("~"):
            continue
        # A bare host-noise word ("hermes"/".hermes"), or one after stripping a
        # leading ./~ prefix, drops too.
        base = low.lstrip("./")
        if low in noise or base in noise:
            continue
        kept.append(tok)
    return " ".join(kept)


def _row_source_profile(item: Dict[str, Any]) -> Optional[str]:
    """P0-2: a pool row's effective owning-profile stamp, read from EITHER
    location the write faces use — `metadata.source_profile` (memories/*.json
    rows) or top-level `source_profile` (episodic shard rows) — with a missing
    / empty value = NEUTRAL (None). Knowledge rows carry neither -> neutral.
    Never raises on any row shape (fail-soft): a non-dict row or a non-dict
    `metadata` yields None (neutral) instead of an AttributeError — a row-shape
    hiccup must degrade to neutral (kept), never drop recall."""
    if not isinstance(item, dict):
        return None
    meta = item.get("metadata")
    sp = meta.get("source_profile") if isinstance(meta, dict) else None
    if sp in (None, ""):
        sp = item.get("source_profile")
    if sp in (None, ""):
        return None
    return str(sp)


def _auto_recall_eligible(row_sp: Optional[str], session_sp: Optional[str]) -> bool:
    """P0-2 hard-isolation predicate (the auto-inject face ONLY). Keep a row
    iff its effective source_profile (row_sp) EQUALS the session profile
    (session_sp), OR it is NEUTRAL (row_sp is None — no stamp / empty legacy
    row). A cross-profile row (row_sp set, != session_sp) is cut. When
    session_sp is None (host gave no profile identity -> fail-open) EVERY row
    is kept: no isolation, today's full-recall behavior — a missing identity
    can never silently drop recall."""
    if session_sp is None:
        return True
    if row_sp is None:
        return True
    return row_sp == session_sp


def _auto_recall_filter(pool: List[Dict[str, Any]], session_sp: Optional[str]) -> List[Dict[str, Any]]:
    """P0-2: keep the rows eligible for the auto-inject face under hard
    isolation. `session_sp` None = fail-open (no isolation, every row kept);
    else keep rows whose effective source_profile equals `session_sp` or is
    neutral. Never mutates the caller's list, never raises on a bad row
    (a filter bug degrades to the full pool — it must not drop recall)."""
    if session_sp is None:
        return list(pool)
    try:
        return [
            r for r in pool
            if isinstance(r, dict) and _auto_recall_eligible(_row_source_profile(r), session_sp)
        ]
    except Exception:
        return list(pool)


def _noise_table_hit(s: str, decay_cfg: Optional[Dict[str, Any]]) -> bool:
    """P0-3: the shared egress-noise OPENER tables — one table, wired into
    BOTH faces so they can never drift apart (写侧 ingress 切同表):

      - `egress_noise.tool_dump_openers` (leg ③ of _egress_noise_cut)
      - `egress_noise.fragment_prefixes` (leg ⑤, P0-3 new)

    Both are STARTSWITH semantics (a row is hit only when it OPENS the
    anchor — substring matching is deliberately NOT done, 零误杀: a normal
    fact that merely contains the anchor mid-text is never caught). The
    write-side ingress gate uses this helper in its raw_tool_output leg,
    OR-ed with the always-live 3-key code default
    (`_looks_like_tool_dump` + the `<untrusted_tool_result` prefix —
    superset gate: every P0-1 reject stays a reject, zero regression).

    Fail-soft: a missing/malformed block, or a malformed leg shape
    (non-dict table, non-list language row, non-str entry), degrades to
    "no hit" for that leg only — it never raises, never takes down the
    sibling leg. decay_cfg=None behaves exactly like the P0-1 code-only
    gate (no tables consulted). Zero LLM, pure stdlib startswith/len."""
    try:
        en = (decay_cfg or {}).get("egress_noise")
        if not isinstance(en, dict):
            return False
        for table in ("tool_dump_openers", "fragment_prefixes"):
            block = en.get(table)
            if not isinstance(block, dict):
                continue  # malformed leg shape -> fail-soft off for this leg
            for pats in block.values():
                if not isinstance(pats, (list, tuple)):
                    continue
                for pat in pats:
                    if pat and s.startswith(str(pat)):
                        return True
    except Exception:
        return False
    return False


def _egress_noise_cut(content: str, decay_cfg: Optional[Dict[str, Any]]) -> bool:
    """S2 egress-side noise predicate (config-driven, 改表不改码 — the code
    carries zero hardcoded fingerprints; every pattern/length comes from the
    `egress_noise` decay block):

    ① the module-level `_looks_like_tool_dump` single source of truth
       (brace/JSON opener class — one wiring, no new predicate);
    ② oversized STRUCTURAL rows: len > egress_noise.governance.max_chars
       AND first char in egress_noise.structural_opens (the '{[' primitive,
       same frozenset as `_NONPROSE_OPENERS`);
    ③ tool-dump OPENER fingerprints (egress_noise.tool_dump_openers,
       multilingual table, startswith — the task_1 class ('Fetch finished …'
       browser console dump, 47 KB) that misses the '{[' structural classes;
       P0-3 also wires the egress face onto the shared `_noise_table_hit`
       helper so ③ and ⑤ share one table and can never drift apart);
    ④ tool-result ECHO fingerprints (egress_noise.echo_patterns, substring,
       run ONLY on rows <= echo_max_chars so a long log that merely contains
       the phrase is never caught);
    ⑤ process-fragment ANCHORS (egress_noise.fragment_prefixes, startswith
       semantics, P0-3 new leg — same shape as ③, table-driven via the
       shared `_noise_table_hit` helper; a row is cut only when it OPENS
       the anchor, a normal fact that merely CONTAINS the anchor mid-text is
       never caught, 零误杀).

    A missing/malformed block is a fail-soft pass-through for its rules
    (① is always active — it is pure code, not config)."""
    s = (content or "").strip()
    if _looks_like_tool_dump(s):
        return True
    cfg = decay_cfg or {}
    # P0-3 fail-soft hardening: a block shape the legs never agreed on
    # (egress_noise not a dict) must degrade ALL config legs ②-⑤ to
    # pass-through — ① the code-default 3-key opener is always live and
    # never depends on config. (pre-P0-3 a corrupted block could raise
    # inside leg ②; the host's _egress_cut seam swallows it, but a
    # predicate that raises is not a fail-soft predicate.)
    en = cfg.get("egress_noise")
    if not isinstance(en, dict):
        return False
    # ② oversized structural (single key shared with tools/govern_memories.py)
    max_chars = int((en.get("governance") or {}).get("max_chars", 0) or 0)
    opens = en.get("structural_opens") or ""
    if max_chars and opens and s[:1] in opens and len(s) > max_chars:
        return True
    # ③ + ⑤ P0-3: shared OPENER tables (tool_dump_openers + fragment_prefixes,
    #    startswith semantics — one helper wired into BOTH the egress cut and
    #    the write-side ingress gate, so the two faces can never drift apart;
    #    empty/absent/malformed tables = fail-soft pass-through of these legs)
    if _noise_table_hit(s, decay_cfg):
        return True
    # ④ echo fingerprints, length-gated (a 47KB dump containing the phrase
    #    is ②/③'s territory, never ④'s — keep the echo rule surgical)
    max_echo = int(en.get("echo_max_chars", 0) or 0)
    if max_echo and len(s) <= max_echo:
        for pats in (en.get("echo_patterns") or {}).values():
            for pat in (pats or []):
                if pat and pat in s:
                    return True
    return False


def _no_popup_silent_discard(content: str, decay_cfg: Optional[Dict[str, Any]],
                             salience: Optional[float] = None) -> bool:
    """P3-1: the pre-queue conservative low-value DROP decision (1A 保守档,
    钉死, 勿扩大). A row is judged "low-value, drop directly (never let it
    enter the user-visible pending-confirm queue)" if and only if it hits ANY
    ONE of the three config-driven legs:

      1. **egress_noise OPENER table hit** — reuses the P0-3 shared
         `_noise_table_hit` (tool_dump_openers + fragment_prefixes, all
         config-driven). This is the SAME table the egress cut and the
         write-side ingress gate read, so the drop face can never drift apart.
      2. **too short** — `len(normalized content) < no_popup.min_chars`
         (default 40; a new config knob, not a hardcoded constant).
      3. **low salience** — an EXPLICIT `salience` value `< no_popup.
         salience_floor` (default 0.5). A MISSING salience (L0-auto / draft
         rows default to 0.5, i.e. AT the floor) is NOT a hit — the
         conservative posture deliberately does not mis-kill on salience;
         the noise table + short fragment are the main legs.

    No leg hit = high-value → the caller queues the row exactly as today
    (behavior unchanged). 改表不改码: every number comes from the `no_popup`
    decay block — `enable=false` (or a missing/malformed block) turns the gate
    OFF and every row is queued (full legacy rollback). Fail-soft: an
    exception inside the judgment degrades to "not low-value" (queue — 宁多弹
    不可崩, a crashed gate must never take down the host turn). Zero LLM,
    pure stdlib (the P0-3 startswith table + len + float)."""
    try:
        en = (decay_cfg or {}).get("no_popup")
        if not isinstance(en, dict):
            return False  # missing block -> gate off (exact legacy behavior)
        if not en.get("enable", True):
            return False  # enable=false -> fully roll back to legacy queueing
        s = (content or "").strip()
        # leg ①: the shared P0-3 egress-noise OPENER tables (config-driven).
        if _noise_table_hit(s, decay_cfg):
            return True
        # leg ②: too short (normalized length below the config floor).
        try:
            min_chars = int(en.get("min_chars", 40))
        except (TypeError, ValueError):
            min_chars = 40
        if min_chars > 0 and len(s) < min_chars:
            return True
        # leg ③: an EXPLICIT low salience below the config floor (a missing
        # salience is NOT a hit — no salience mis-kill by default).
        if salience is not None:
            try:
                floor = float(en.get("salience_floor", 0.5))
            except (TypeError, ValueError):
                floor = 0.5
            if salience < floor:
                return True
    except Exception:
        return False  # fail-soft: a judgment exception = not low-value (queue)
    return False


def is_foreign_turn_author(author):
    """True if author is bot/peer agent (is_bot or bot: prefix)."""
    if not isinstance(author, dict) or not author:
        return False
    if author.get("is_bot"):
        return True
    return str(author.get("id") or "").startswith("bot:")



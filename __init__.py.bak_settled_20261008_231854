# ── SA2-1: deterministic event-date extraction (occurred_at, zero LLM) ────────
# MemoryItem carries two timestamps: created_at = when the record was WRITTEN;
# occurred_at = when the EVENT the record describes HAPPENED, extracted from
# content with pure stdlib regexes below (CJK-aware: ISO / MM-DD / 年月日 /
# CJK month-day / English month-name forms). Undetectable -> None, and every
# consumer falls back to created_at. Output mirrors the created_at convention
# (naive-UTC ISO string; a date-only hit is stamped at midnight) so plain
# lexicographic comparison works across both fields. Year-less forms (09-30,
# 9月30日) anchor to the current UTC year.
_DATE_RE_ISO = re.compile(r"(?<!\d)(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})(?!\d)")
# Year-less MM-DD (spec form `09-30`): dash-only on purpose — dots hit version
# numbers / decimals. Alphanumeric look-behind so `v3-14` / `build-5` tokens
# don't false-positive (documented heuristic surface: version-looking `2-05`
# fragments can still match — acceptable for a spec-required shorthand form).
# Validated via datetime (month<=12, day range), anchored to the current UTC
# year; an invalid triple yields None, not an error.
_DATE_RE_MD = re.compile(r"(?<![0-9A-Za-z])(\d{1,2})-(\d{1,2})(?!\d)")
_DATE_RE_CJK_FULL = re.compile(r"(?<!\d)(\d{2,4})年(\d{1,2})月(\d{1,2})[日号](?!\d)")
_DATE_RE_CJK_MD = re.compile(r"(?<!\d)(\d{1,2})月(\d{1,2})[日号](?!\d)")
_DATE_RE_EN = re.compile(
    r"\b(Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|"
    r"Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\s+"
    r"(\d{1,2})(?:st|nd|rd|th)?\s*(?!\d)\s*,?\s*(\d{4})?\b",
    re.IGNORECASE,
)
_EN_MONTH_NUM = {
    "jan": 1, "feb": 2, "mar": 3, "apr": 4, "may": 5, "jun": 6,
    "jul": 7, "aug": 8, "sep": 9, "oct": 10, "nov": 11, "dec": 12,
}


def _occurred_at_iso(y: int, m: int, d: int) -> Optional[str]:
    """Validate a (y,m,d) triple; return the naive-UTC midnight ISO string or
    None for impossible dates (2026-13-40, 2026-02-30 — never raise)."""
    try:
        return datetime(y, m, d).date().isoformat() + "T00:00:00"
    except (ValueError, OverflowError):
        return None


def extract_occurred_at(content: Optional[str], now: Optional[datetime] = None) -> Optional[str]:
    """Extract the event date a content string describes (occurred_at).

    Priority: full ISO (2026-09-30 / 2026/09/30) > CJK full year
    (2026年9月30日) > CJK month-day (9月30日, current UTC year) > English
    month name (September 30, 2026 / Sep 30 2026) > year-less MM-DD (09-30,
    current UTC year). Pure regex + datetime — zero LLM, zero I/O; `now` is
    injectable so tests stay deterministic. A hit that fails date validation
    (month 13, 02-30) falls through to the next pattern; all misses -> None.
    Fail-soft contract: always returns, never raises.
    """
    if not content:
        return None
    year = (now or _utcnow()).year
    cands = [
        (_DATE_RE_ISO.search(content), lambda m: (int(m.group(1)), int(m.group(2)), int(m.group(3)))),
        (_DATE_RE_CJK_FULL.search(content), lambda m: (int(m.group(1)), int(m.group(2)), int(m.group(3)))),
        (_DATE_RE_CJK_MD.search(content), lambda m: (year, int(m.group(1)), int(m.group(2)))),
        (_DATE_RE_EN.search(content), lambda m: (
            int(m.group(3)) if m.group(3) else year,
            _EN_MONTH_NUM[m.group(1)[:3].lower()], int(m.group(2)))),
        (_DATE_RE_MD.search(content), lambda m: (year, int(m.group(1)), int(m.group(2)))),
    ]
    for m, triple in cands:
        if not m:
            continue
        out = _occurred_at_iso(*triple(m))
        if out:
            return out
    return None


# ── SA2-2: time-window predicate (pure read-side, zero LLM, zero deps) ─────
# window = {"since": "YYYY-MM-DD", "until": "YYYY-MM-DD"} — strict ISO
# calendar dates, INCLUSIVE [since, until] range. Per-item effective event
# time = occurred_at (SA2-1) when present, else created_at; an item with no
# parseable timestamp cannot prove itself in-window and is dropped (not
# kept, not raised). Fail-soft: malformed `window` ARGS raise ValueError
# (the tool layer converts that to an error JSON; the host turn survives);
# item data can never raise here.
_WINDOW_DATE_RE = re.compile(r"^(\d{4})-(\d{2})-(\d{2})$")


def _window_date(value: Any, label: str) -> date:
    """Parse a strict YYYY-MM-DD bound; ValueError on anything else
    (not-a-date, 2026-02-30 — never a silent pass)."""
    m = _WINDOW_DATE_RE.match(str(value or "").strip())
    if not m:
        raise ValueError(f"window.{label} must be an ISO date YYYY-MM-DD, got {value!r}")
    try:
        return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
    except ValueError:
        raise ValueError(f"window.{label} is not a valid calendar date: {value!r}")


def filter_pool_by_window(pool: List[Dict], window: Any) -> List[Dict]:
    """SA2-2 window filter: keep items whose effective event time
    (occurred_at, falling back to created_at) lies in the INCLUSIVE
    [since, until] calendar range.

    Pure read-side: pool dicts are not mutated and live data is never
    written. `since`/`until` are independently optional (one-sided
    windows); unknown keys are ignored; a window with NO bounds ({} or
    both empty) is a no-op that returns the pool unchanged. Malformed
    bounds / a non-dict window raise ValueError (a tool-arg error,
    surfaced as an error JSON at the tool layer — a retrieval degradation
    must never crash the host turn). Timezone-aware timestamps normalize
    to UTC before the date comparison.
    """
    if not isinstance(window, dict):
        raise ValueError(
            "window must be an object like {'since': 'YYYY-MM-DD', "
            "'until': 'YYYY-MM-DD'}; got " + type(window).__name__)
    since = _window_date(window["since"], "since") if window.get("since") else None
    until = _window_date(window["until"], "until") if window.get("until") else None
    if since is not None and until is not None and since > until:
        raise ValueError(f"window.since ({since}) is after window.until ({until})")
    # No bounds (empty dict {..}): the predicate is a no-op — the pool is
    # returned UNCHANGED (even items with no parseable timestamp stay),
    # so a no-op window never drops data. window=None skips this function
    # entirely; byte-identical by construction.
    if since is None and until is None:
        return pool
    out: List[Dict] = []
    for item in pool:
        ts = item.get("occurred_at") or item.get("created_at") or ""
        try:
            dt = datetime.fromisoformat(str(ts))
        except (TypeError, ValueError):
            # Bounded window: an item that cannot prove its event time
            # cannot be kept in-window -> drop (never raise on item data).
            continue
        if dt.tzinfo is not None:
            dt = dt.astimezone(timezone.utc)
        d = dt.date()
        if (since is not None and d < since) or (until is not None and d > until):
            continue
        out.append(item)
    return out


# ── SEC-1-1: origin trust stamp（确定性映射，零 LLM / deterministic, zero LLM）──
# Every written row carries metadata.origin = {kind, trust}:
#   kind  ∈ {user, model, tool_output, external, unknown}
#   trust ∈ {high, medium, low}
# 映射是 language-agnostic 的 source 值 → kind/trust 枚举（不写任何指令语法
# 特征 —— 那是 SEC-1-2 的 config 驱动模式表）。未知/映射不上 → unknown/low
#（fail-safe 一律取最低信任，不猜高 / lowest trust, never guess high）。
ORIGIN_KINDS = ("user", "model", "tool_output", "external", "unknown")
ORIGIN_TRUSTS = ("high", "medium", "low")
UNKNOWN_TRUST_STAMP = {"kind": "unknown", "trust": "low"}

# source 值 → origin（据活数据实际取值 + 现有写门语义定，2026-10-01 取证：
# live corpus 72 rows: 'auto'×52 / 'confirmed_draft'×17 / 'session:*'×3）:
#   'auto'            → user/medium  自 user 回合的 auto-catch（trigger router +
#                       L0 fallback + rate-limited flush）；纯 tool-dump 已被 G
#                       ingress 门拒（_looks_like_tool_dump @ _save_memory /
#                       _add_draft），所以落盘的 'auto' 行全部是 user-turn 派生
#   'manual'          → user/high    filemem_write 人工写路径
#   'confirmed_draft' → user/high    草稿经 _tool_review_drafts 审阅确认后提升
#   'draft'           → user/medium  未确认草稿（user 回合 auto-catch）
# 前缀规则（deterministic, 未出现的前缀不猜高 / unknown prefixes don't guess high）:
#   'session:<sid>'   → user/medium  _extract_memories 批量抽取自 user 消息
#   'tool:<name>'     → tool_output/low（auto-catch 自 tool-output）
#   'external:<name>' → external/low（外部抓取）
_ORIGIN_MAP_EXACT = {
    "auto": {"kind": "user", "trust": "medium"},
    "manual": {"kind": "user", "trust": "high"},
    "confirmed_draft": {"kind": "user", "trust": "high"},
    "draft": {"kind": "user", "trust": "medium"},
}
_ORIGIN_MAP_PREFIX = {
    "session:": {"kind": "user", "trust": "medium"},
    "tool:": {"kind": "tool_output", "trust": "low"},
    "external:": {"kind": "external", "trust": "low"},
}
# Episodic 写门特例（door-specific 常量，非 source 值）：_write_episodic_entry 只
# 聚合本会话 user 回合的 drafts（G2 跳过 foreign author、G 门拒 tool-dump）→
# 语义 = auto-catch 自 user 回合 → user/medium（确定性门规则，不猜 content）。
_EPISODIC_ORIGIN_STAMP = {"kind": "user", "trust": "medium"}


def _origin_is_wellformed(v) -> bool:
    """True iff v is a {kind,trust} dict on the enums (the idempotency test
    backfill + the malformed-degrade rule in from_dict both use this)."""
    return (isinstance(v, dict)
            and v.get("kind") in ORIGIN_KINDS
            and v.get("trust") in ORIGIN_TRUSTS)


def origin_stamp_for_source(source) -> Dict[str, str]:
    """SEC-1-1: deterministic source → origin mapping (zero LLM, fail-safe
    unknown/low for anything un-mappable — 不猜高 / never guess high)."""
    if isinstance(source, str):
        s = source.strip()
        if s in _ORIGIN_MAP_EXACT:
            return dict(_ORIGIN_MAP_EXACT[s])
        for prefix, stamp in _ORIGIN_MAP_PREFIX.items():
            if s.startswith(prefix):
                return dict(stamp)
    return dict(UNKNOWN_TRUST_STAMP)


def _stamp_origin_in_meta(meta: Dict[str, Any], source) -> None:
    """SEC-1-1: stamp the deterministic origin trust dict into a metadata dict;
    a well-formed origin (e.g. manually corrected, or a prior backfill run) is
    kept verbatim. Never raises — a corrupt meta degrades to the fresh stamp."""
    if _origin_is_wellformed(meta.get("origin")):
        return
    meta["origin"] = origin_stamp_for_source(source)


# EP-1: 谱系字段（lineage schema, deterministic zero-LLM candidate layer）──
# Data contract (data-engineer): every row's lineage lives in `metadata` —
#   * metadata.supersedes   : List[str]  candidate supersession LINKS this row
#     may supersede (older same-type rows with high content overlap, newer
#     timestamp). CANDIDATE only — EP-2 confirms before any status flip;
#     this layer writes links, never verdicts.
#   * metadata.related_to   : List[str]  sibling links (same-type, semantic
#     neighbours) — also candidate-grade, confirmed by EP-2.
#   * metadata.superseded   : bool marker written by the deterministic save
#     door when a NEW row supersedes this old one — read-side (search pool)
#     drops it from the RRF main pool; the row stays on disk (I1 无 DELETE,
#     full 谱系留存, lineage expansion only).
#   * metadata.superseded_by: the newer row id that superseded this one
#     (symmetric link for 谱系展开, expansion only).
#   * metadata.supersede_state: "candidate" (this EP-1 layer) -> "confirmed"
#     (EP-2's confirmation face). Candidate links are never auto-acted-on.
# Legacy rows carry NONE of these keys — readers must treat absence as an
# empty list / un-superseded (backward compat, regression gate locked by
# tests/test_ep_1_lineage.py). All stamping is pure stdlib, zero LLM.
EP_SUPERSEDE_CANDIDATES = "supersede_candidates"


def _lineage_token_set(text: str) -> set:
    """EP-1 deterministic token set for content-overlap scoring. Same
    tokenizer family as search_index.tokenize (latin words + CJK 2..4-grams)
    via lazy import; a missing/broken search_index degrades to a latin-only
    regex so stamping NEVER fails (fail-soft, host turn 不炸)."""
    s = (text or "").lower()
    try:
        from search_index import tokenize
        return set(t for t in tokenize(s) if t)
    except Exception:  # pragma: no cover - fail-soft gate
        return set(re.findall(r"[a-z0-9\u4e00-\u9fff]+", s))


def _content_overlap_score(new_content: str, old_content: str) -> float:
    """Deterministic Jaccard overlap between two rows' content token sets
    (symmetric, in [0,1]). 1.0 = identical token sets; 0.0 = disjoint.
    Pure function — diff-able across processes, zero LLM."""
    a = _lineage_token_set(new_content)
    b = _lineage_token_set(old_content)
    if not a or not b:
        return 0.0
    union = a | b
    return len(a & b) / len(union)


def lineage_of(item_dict: Dict[str, Any]) -> Dict[str, Any]:
    """EP-1: read-side lineage view of a stored row (legacy rows -> empty
    lists, never KeyError)."""
    meta = item_dict.get("metadata") or {}
    return {
        "supersedes": list(meta.get("supersedes") or []),
        "related_to": list(meta.get("related_to") or []),
        "superseded": bool(meta.get("superseded", False)),
        "superseded_by": meta.get("superseded_by"),
        "supersede_state": meta.get("supersede_state"),  # None=unlinked, "candidate"/"confirmed"
    }


def _stamp_lineage_candidates(new_row: Dict[str, Any],
                              existing_rows: List[Dict[str, Any]],
                              decay: Optional[Dict[str, Any]] = None) -> List[Dict[str, Any]]:
    """EP-1: deterministic supersedes-candidate stamp at the save door
    (ZERO LLM — the candidate layer; EP-2's confirmation is the only
    decision face, spec EP-1 acceptance #4).

    Rule (data-engineer 拍板, 确定性可 diff):
      * same type (the mem_type shard the new row lands in);
      * STRICTLY older: created_at before the new row's (unparseable old ts
        = treat as oldest, deterministic);
      * content Jaccard overlap >= supersede_min_overlap (default 0.5);
      * ranked overlap-desc / id-asc (ties deterministic, diff-able across
        processes) and capped at supersede_max_candidates (default 2).
    Writes:
      * new_row metadata.supersedes = [old ids] (CANDIDATE links, recorded
        per the EP-1 data contract as `metadata.supersedes: [id]`;
        metadata.supersede_state="candidate" marks them unconfirmed — EP-2
        flips to "confirmed"; this layer never verdicts).
      * each capped candidate row's metadata.superseded = True (+
        superseded_by = new row id) — the search pool drops superseded rows
        from the RRF main pool (谱系展开面 only; I1 无 DELETE, the row stays
        on disk).
    Fail-soft: every read of an old row is guarded — a corrupt row is
    skipped, the save door never raises. Returns the stamped candidate rows
    (their dicts, for the caller to persist alongside the new row)."""
    decay = decay or {}
    search_cfg = decay.get("search") or {}
    try:
        min_overlap = float(search_cfg.get("supersede_min_overlap", 0.5))
    except (TypeError, ValueError):
        min_overlap = 0.5
    try:
        max_candidates = int(search_cfg.get("supersede_max_candidates", 2))
    except (TypeError, ValueError):
        max_candidates = 2

    new_ts = str(new_row.get("created_at") or new_row.get("updated_at") or "")
    new_id = str(new_row.get("id") or "")
    new_content = new_row.get("content") or ""

    scored: List[tuple] = []  # (overlap, id, row)
    for row in existing_rows or []:
        try:
            if not isinstance(row, dict) or row.get("id") is None:
                continue
            # corrupt shape: a non-dict metadata means the old row cannot be
            # back-linked (superseded marker) — skip it as a candidate rather
            # than emit a one-sided link (不吞脏, fail-soft: no broken lineage).
            _old_meta = row.get("metadata")
            if _old_meta is not None and not isinstance(_old_meta, dict):
                continue
            if new_id and str(row.get("id")) == new_id:
                continue  # never self-supersede
            ts_raw = str(row.get("created_at") or row.get("updated_at") or "")
            # strictly older: an old row born in the same second as the new
            # one is NOT a candidate; empty old ts = oldest = candidate
            # (deterministic, diff-able across processes).
            if ts_raw and new_ts and ts_raw >= new_ts:
                continue
            overlap = _content_overlap_score(new_content, row.get("content") or "")
            if overlap < min_overlap:
                continue
            scored.append((overlap, str(row.get("id")), row))
        except Exception:  # pragma: no cover - fail-soft: corrupt row skipped
            continue

    # deterministic ranking: overlap desc, id asc — diff-able across runs.
    scored.sort(key=lambda t: (-t[0], t[1]))
    candidates = scored[:max(0, max_candidates)]
    if not candidates:
        return []
    meta = new_row.setdefault("metadata", {})
    # Candidate links per the EP-1 data contract (metadata.supersedes: [id])
    # + supersede_state="candidate" — EP-2's confirmation face flips the
    # state to "confirmed"; the candidate layer only ever appends links.
    # setdefault: an existing stamp (a richer/confirmed link from a prior
    # save door) wins — this layer never clobbers (same posture as SEC-1-1).
    cand_ids = [c[2].get("id") for c in candidates]
    appended = meta.setdefault("supersedes", cand_ids)
    # supersede_state follows the LINKS: a row that already carried a
    # confirmed (EP-2) link keeps its richer state — the candidate layer
    # only stamps state when IT wrote the link (never clobbers).
    if appended is cand_ids:
        meta["supersede_state"] = "candidate"
    for _ov, _cid, row in candidates:
        try:
            row.setdefault("metadata", {})["superseded"] = True
            row["metadata"]["superseded_by"] = new_id
        except Exception:  # pragma: no cover - fail-soft
            continue
    return [c[2] for c in candidates]


# ---------------------------------------------------------------------------
# C3 (t_03a0c213): write-time negation candidate-pool extension.
#
# The docker-contradiction gap (O1 memo L48-52): a NEGATION correction
# ("部署时用 docker" -> "今天不用 docker") misses EP-1's deterministic 0.5-
# Jaccard save-door gate — the negation words 不/没/no/stop are EXACTLY the
# delta that LOWERS the raw token overlap, so the old row stays in the RRF
# main pool and auto-inject recalls both competing memories. O1's explicit
# tool catches it when the host model remembers; C3 is the WRITE-SIDE AUTO
# backstop: when the host model writes a negation correction and does NOT
# call filemem_supersede, the save door still extends the supersedes
# candidate pool, and the EXISTING EP-2 confirmation gate makes the verdict.
#
# Safety red line (owner 10-07 钉死): this channel ONLY extends the
# candidate pool — it NEVER auto-invalidates an old row. The candidate links
# + a c3 mark are written on the NEW row; the old row is flipped
# superseded=True only by EP-2's LLM confirm verdict (host shared main-model
# channel, budget-gated, fail-soft). EP-2 hang/timeout/budget-out = the
# candidate stays in the audit surface (consolidation_log), no stamp, no
# old-row touch. EP-1's 0.5 pure-content channel is a PARALLEL lane,
# byte-identical (its gate threshold / candidate cap / stamping logic are
# untouched). All write-side code here is pure stdlib, zero LLM; the
# decision face is EP-2's existing host-LLM confirmation. No cron / timer /
# cross-profile.
# ---------------------------------------------------------------------------

# Negation / premise-change signals, bilingual. The DETECTOR + wordlist are a
# coder-level implementation detail (the card leaves the table to the coder):
# a compact bilingual trigger gate — Chinese negation / stop-using / switch
# substring markers + an English word-boundary negation / stop-using table.
# Temporal qualifiers are stripped from the key-concept set so "今天不用 docker"
# and "部署时用 docker" both reduce to the SAME key concept "docker".
_C3_NEG_ZH_SUBSTR = ("不", "没", "没有", "不再", "停用", "停止", "取消", "改用",
                    "换成", "切换", "弃用", "移除", "删除", "禁止", "避免",
                    "别", "勿", "不用")
_C3_TEMP_ZH_SUBSTR = ("今天", "今日", "现在", "目前", "当前", "刚", "最近",
                     "立刻", "马上")
_C3_NEG_EN_WORDS = ("no", "not", "never", "stop", "stopped", "stopping",
                    "switch", "switched", "switching", "replace", "replaced",
                    "replacing", "discontinue", "discontinued", "abandon",
                    "abandoned", "deprecat", "drop", "dropped", "remove",
                    "removed")
_C3_TEMP_EN_WORDS = ("today", "now", "currently", "recently", "instead",
                     "anymore", "longer")
_C3_STOP_EN_WORDS = ("the", "a", "an", "and", "or", "but", "for", "to", "of",
                     "in", "on", "at", "by", "with", "we", "our", "you", "is",
                     "are", "has", "have", "this", "that", "i", "it")
_C3_STRIP_EN = frozenset(
    _C3_NEG_EN_WORDS + _C3_TEMP_EN_WORDS + _C3_STOP_EN_WORDS)
_C3_STRIP_ZH = tuple(_C3_NEG_ZH_SUBSTR + _C3_TEMP_ZH_SUBSTR)
_C3_NEG_EN_RE = re.compile(
    r"\b(?:" + "|".join(re.escape(w) for w in _C3_NEG_EN_WORDS) + r")\b")


def _c3_has_negation_signal(text: str) -> bool:
    """C3 write-side negation detector (bilingual, zero LLM, fail-soft).

    TRUE iff the content carries a negation / stop-using / switch / premise-
    change marker. Chinese = substring match over the compact marker table
    (不/没/停用/切换/弃用…); English = word-boundary match over the negation /
    stop-using word table. An empty / None content is False. This is the
    TRIGGER gate for the channel: a plain (no-negation) save never enters it,
    so that path is byte-identical to the 0.5 channel alone."""
    s = (text or "").lower()
    if not s:
        return False
    for m in _C3_NEG_ZH_SUBSTR:
        if m in s:
            return True
    return bool(_C3_NEG_EN_RE.search(s))


def _c3_key_concepts(text: str) -> set:
    """C3: the key-concept token set AFTER stripping negation words, temporal
    qualifiers, and English stopwords — the "去否定词后的关键概念" retrieval
    tokens. Same tokenizer family as EP-1 / search_index (latin words + CJK
    2..4-grams). CJK stripping is substring-based on the pre-token text
    (negation / temporal markers are CJK-substring units); English stripping
    is whole-word (the tokenizer's latin tokens match the strip table)."""
    s = (text or "").lower()
    for m in _C3_STRIP_ZH:
        s = s.replace(m, " ")
    toks = [t for t in _lineage_token_set(s) if t]
    return {t for t in toks if t not in _C3_STRIP_EN}


def _c3_concept_recall(new_content: str, old_content: str) -> float:
    """C3: recall of the NEW row's key concepts in the OLD row
    (denominator on the NEW side: |new ∩ old| / |new|, in [0,1]). High = the
    negation correction is about the SAME thing as the old row (the key
    concepts survive the negation strip) = a genuine correction the 0.5 gate
    missed. Pure function — diff-able across processes, zero LLM."""
    nk = _c3_key_concepts(new_content)
    ok = _c3_key_concepts(old_content)
    if not nk or not ok:
        return 0.0
    return len(nk & ok) / len(nk)


def _c3_stamp_negation_candidates(new_row: Dict[str, Any],
                                  existing_rows: List[Dict[str, Any]],
                                  decay: Optional[Dict[str, Any]] = None) -> List[Dict[str, Any]]:
    """C3: negation channel — a PARALLEL second supersedes-candidate stamp at
    the save door (ZERO LLM — extends the EP-1 candidate pool; EP-2 is the
    only decision face, per the owner's safety red line).

    Trigger: the NEW row's content carries a negation / premise-change signal
    (_c3_has_negation_signal). When it does, recall the NEW row's key
    concepts (negation/temporal/stopword-stripped, _c3_concept_recall) against
    the same shard's STRICTLY-OLDER, SAME-PROFILE-OR-NEUTRAL rows; a row whose
    key-concept recall is >= c3_negation_min_recall (default 0.5) becomes a
    supersedes CANDIDATE. This is the docker-contradiction backstop: a
    negation correction that misses EP-1's 0.5 raw-Jaccard gate still lands
    in the candidate pool, and the existing EP-2 confirm face makes the
    verdict.

    Safety red line (只扩池、不自动作废旧行): this lane ONLY extends the
    pool. It writes candidate links + the c3 mark on the NEW row and a
    ``superseded_by`` back-link HINT on the old rows — it NEVER sets
    ``superseded=True`` (the auto-inject fold-out marker). The old row is
    flipped ``superseded=True`` only by EP-2's LLM confirm verdict
    (_supersede_confirm_candidates), which is why this lane is safe to run at
    every save door: a negation candidate that EP-2 vetoes or never reaches
    (hang / budget-out) leaves the old row in the RRF main pool exactly as
    before.

    Parallel to EP-1's 0.5 pure-content channel: intended to run AFTER
    _stamp_lineage_candidates, APPENDS to (never clobbers) its supersedes
    list, and leaves its stamps untouched — a no-negation save returns []
    immediately (byte-identical to the 0.5 channel alone). Pure stdlib, zero
    LLM, fail-soft (a corrupt row is skipped, the save door never raises).
    Returns the C3-candidate rows (their dicts, for the caller's audit)."""
    decay = decay or {}
    search_cfg = decay.get("search") or {}
    try:
        min_recall = float(search_cfg.get("c3_negation_min_recall", 0.5))
    except (TypeError, ValueError):
        min_recall = 0.5
    try:
        max_candidates = int(search_cfg.get("supersede_max_candidates", 2))
    except (TypeError, ValueError):
        max_candidates = 2

    new_content = new_row.get("content") or ""
    # TRIGGER gate: a plain (no-negation) save never enters this lane —
    # that path is byte-identical to the 0.5 channel alone.
    if not _c3_has_negation_signal(new_content):
        return []
    new_ts = str(new_row.get("created_at") or new_row.get("updated_at") or "")
    new_id = str(new_row.get("id") or "")
    new_sp = _row_source_profile(new_row)

    scored: List[tuple] = []  # (recall, id, row)
    for row in existing_rows or []:
        try:
            if not isinstance(row, dict) or row.get("id") is None:
                continue
            # corrupt shape: a non-dict metadata cannot carry a back-link —
            # skip it as a candidate (不吞脏, fail-soft: no broken lineage).
            _old_meta = row.get("metadata")
            if _old_meta is not None and not isinstance(_old_meta, dict):
                continue
            if new_id and str(row.get("id")) == new_id:
                continue  # never self-supersede
            ts_raw = str(row.get("created_at") or row.get("updated_at") or "")
            # strictly older (same rule as the 0.5 channel): an old row born in
            # the same second is NOT a candidate; empty old ts = oldest.
            if ts_raw and new_ts and ts_raw >= new_ts:
                continue
            # same-profile-or-neutral isolation (O1 1D default): a row stamped
            # by ANOTHER profile is never a candidate for this profile's
            # negation correction (the shared pool must not let profile A's
            # negation clobber profile B's fact). A neutral (unstamped) row is
            # claimable by any profile, as with the 0.5 channel's stamping.
            old_sp = _row_source_profile(row)
            if old_sp is not None and new_sp is not None and old_sp != new_sp:
                continue
            recall = _c3_concept_recall(new_content, row.get("content") or "")
            if recall < min_recall:
                continue
            scored.append((recall, str(row.get("id")), row))
        except Exception:  # pragma: no cover - fail-soft: corrupt row skipped
            continue

    # deterministic ranking: recall desc, id asc — diff-able across runs.
    scored.sort(key=lambda t: (-t[0], t[1]))
    candidates = scored[:max(0, max_candidates)]
    if not candidates:
        return []
    meta = new_row.setdefault("metadata", {})
    # APPEND to the 0.5 channel's supersedes list (never clobber): the union
    # of the existing links + this lane's hits. The c3 mark is authoritative
    # for "this row entered the negation channel" (EP-2 / audit distinguish).
    existing_links = list(meta.get("supersedes") or [])
    for c in candidates:
        _cid = c[2].get("id")
        if _cid is not None and _cid not in existing_links:
            existing_links.append(_cid)
    meta["supersedes"] = existing_links
    meta["c3_negation"] = True
    # supersede_state follows the LINKS: a richer confirmed state from a prior
    # lane wins; otherwise this lane makes the row a candidate (EP-2's only
    # decision face). Never clobber a confirmed state.
    if meta.get("supersede_state") != "confirmed":
        meta["supersede_state"] = "candidate"
    # RED LINE (只扩池、不自动作废旧行): the C3 write door touches ONLY the
    # NEW row. It does NOT set superseded=True on the old rows and does not
    # write a superseded_by back-link into them — the old rows are left
    # byte-identical at write time, so an EP-2 hang / budget-out leaves recall
    # untouched. The old-row flip (superseded=True + superseded_by +
    # superseded_confirmed) happens ONLY in EP-2's terminal verdict
    # (_supersede_confirm_candidates), which is what keeps this auto lane safe.
    # The candidate dicts are returned for the caller's audit, unmutated.
    return [c[2] for c in candidates]


def _o1_scope_stamp_clarify_candidates(new_row: Dict[str, Any],
                                       existing_rows: List[Dict[str, Any]],
                                       decay: Optional[Dict[str, Any]] = None
                                       ) -> List[Dict[str, Any]]:
    """Option C (t_de0df8b7) clarify-candidate hook — the THIRD parallel
    supersedes-candidate lane at the save door, running AFTER EP-1 (0.5
    Jaccard) and C3 (negation) and APPENDING to their links.

    A promote/override candidate is produced ONLY when BOTH conditions hold:

      (a) the NEW row is a TEMPORARY exception — it carries a short validity
          scope (``validity_scope`` in {session, day}) or a negation /
          premise-change signal (_c3_has_negation_signal). A permanent /
          standing fact is not a temporary exception and never triggers.

      (b) the SAME topic exists as a LONG-LIVED row the exception may
          conflict with — a STRICTLY-OLDER, same-shard row whose key-concept
          recall is >= c3_negation_min_recall, that is standing (its
          validity_scope is 'permanent' or it is a legacy row with no
          validity window at all) AND is cross-profile or neutral-global
          (stamped by another profile, or unstamped so it is claimable
          globally). A same-profile standing row is the owner's own fact,
          not a "global" conflict, and is not a candidate.

    On a hit: extend the candidate pool with the long-lived target(s) —
    APPEND their ids to ``supersedes``, set ``supersede_state=candidate``
    (unless already confirmed), and stamp ``o1_scope_clarify=True`` so the
    existing EP-2 confirm gate + the owner's clarify nod are the terminal.
    只扩池、不自动作废旧行: this lane NEVER sets ``superseded=True`` on the
    old rows (same structure as C3) — the promote/override happens only when
    the owner confirms through the C3/EP-2 gate, never automatically.

    On a miss (no negation / short scope, or no global standing conflict):
    returns [] and mutates NOTHING — byte-identical to the pure-session path.
    Pure stdlib, zero LLM, fail-soft (a corrupt row is skipped, the save door
    never raises). Locked by tests/test_o1_scope_clarify.py."""
    decay = decay or {}
    try:
        search_cfg = decay.get("search") or {}
        min_recall = float(search_cfg.get("c3_negation_min_recall", 0.5))
    except (TypeError, ValueError):
        min_recall = 0.5
    try:
        max_candidates = int(search_cfg.get("supersede_max_candidates", 2))
    except (TypeError, ValueError):
        max_candidates = 2

    meta = new_row.get("metadata")
    if not isinstance(meta, dict):
        return []
    new_content = new_row.get("content") or ""
    new_ts = str(new_row.get("created_at") or new_row.get("updated_at") or "")
    new_id = str(new_row.get("id") or "")
    new_sp = _row_source_profile(new_row)

    # (a) temporary-exception gate: a short validity scope OR a negation /
    # premise-change signal. A permanent / plain standing row is NOT a
    # temporary exception -> no candidate (byte-identical to the pure path).
    is_short_scope = meta.get("validity_scope") in ("session", "day")
    if not (is_short_scope or _c3_has_negation_signal(new_content)):
        return []

    scored: List[tuple] = []  # (recall, id, row)
    seen_ids: set = set()  # dedupe: the save-door feeds same-shard + global,
    # so an old row can appear in both lists; score each target ONCE.
    for row in existing_rows or []:
        try:
            if not isinstance(row, dict) or row.get("id") is None:
                continue
            _rid = str(row.get("id"))
            if _rid in seen_ids:
                continue
            if _rid == new_id:
                continue  # never self-reference
            seen_ids.add(_rid)
            ts_raw = str(row.get("created_at") or row.get("updated_at") or "")
            # strictly older (same rule as EP-1 / C3): an old row born in the
            # same second is not a candidate; empty old ts = oldest.
            if ts_raw and new_ts and ts_raw >= new_ts:
                continue
            om = row.get("metadata")
            if om is not None and not isinstance(om, dict):
                continue  # corrupt shape: skip, fail-soft
            oscope = om.get("validity_scope")
            # (b-1) long-lived standing row: permanent scope OR a legacy row
            # with no validity window at all (legacy rows never lapse). A
            # short-scope old row is itself temporary, not a standing fact.
            if oscope not in ("permanent", None):
                continue
            # (b-2) global / other-profile presence: stamped by ANOTHER
            # profile, or neutral-global (unstamped -> claimable by anyone).
            # A same-profile standing row is the owner's own fact, not a
            # "global" conflict -> not a candidate.
            old_sp = _row_source_profile(row)
            cross_or_global = (old_sp is None) or \
                (new_sp is not None and old_sp != new_sp)
            if not cross_or_global:
                continue
            recall = _c3_concept_recall(new_content, row.get("content") or "")
            if recall < min_recall:
                continue
            scored.append((recall, str(row.get("id")), row))
        except Exception:  # pragma: no cover - fail-soft: corrupt row skipped
            continue

    if not scored:
        return []
    # deterministic ranking: recall desc, id asc — diff-able across runs.
    scored.sort(key=lambda t: (-t[0], t[1]))
    candidates = scored[:max(0, max_candidates)]
    if not candidates:
        return []

    # APPEND to the existing supersedes list (never clobber EP-1 / C3 links).
    existing_links = list(meta.get("supersedes") or [])
    for c in candidates:
        _cid = c[2].get("id")
        if _cid is not None and _cid not in existing_links:
            existing_links.append(_cid)
    meta["supersedes"] = existing_links
    meta["o1_scope_clarify"] = True
    if meta.get("supersede_state") != "confirmed":
        meta["supersede_state"] = "candidate"
    # RED LINE (只扩池、不自动作废旧行): the old rows are left byte-identical
    # here — superseded=True is flipped ONLY by EP-2's terminal confirm
    # verdict + the owner's clarify nod. Returning the candidate dicts
    # (unmutated) lets the caller's audit log them.
    return [c[2] for c in candidates]



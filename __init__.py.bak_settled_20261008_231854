    def is_available(self) -> bool:
        """Runtime preconditions only — NOT activation state.

        Base contract (agent/memory_provider.py): is_available gates
        ACTIVATION — it must answer "can this provider run if selected?",
        never "am I currently selected?". Keying availability off
        ``memory.provider == self.name`` deadlocks the WebUI switch flow:
        PUT /api/memory/provider calls _require_memory_provider_ready()
        BEFORE writing memory.provider, so an "inactive == unavailable"
        provider could never be reached through the dashboard.

        filemem has no hard external dependencies (no pip deps, no
        required env, no API keys) and creates its storage dirs in
        initialize(), so it is always available.
        """
        return True

    def initialize(self, session_id: str, **kwargs) -> None:
        """Initialize the provider."""
        self.session_id = session_id
        self.hermetis_home = Path(kwargs.get("hermes_home", Path.home() / ".hermes"))

        # Setup directories — T5b config tier: auto-resolves to the shared
        # neutral root (<base>/filemem) unless an explicit storage_root
        # override says otherwise (see _resolve_storage_root). Loud, never silent.
        self.storage_dir = self._resolve_storage_root()
        self.memories_dir = self.storage_dir / "memories"

        # B4: raw-trace (sessions/) + episodic sharded (episodic/xxx) dirs
        self.sessions_dir = self.storage_dir / "sessions"
        self.episodic_dir = self.storage_dir / "episodic"
        for d in [self.storage_dir, self.memories_dir, self.sessions_dir, self.episodic_dir]:
            d.mkdir(parents=True, exist_ok=True)
        # Gold 知识层（@data-engineer 数据契约 · 切片② 建）：JSON 唯一 source of
        # truth，单向导出器渲染。落桌面 store（@devops O2 guard 认定的 source of
        # truth，O2 双源守卫对 knowledge/ 同样生效，build 侧不落 CLI 路径）。
        # - entries.json   Gold 本体（active + superseded 全谱系，I1 无 DELETE）
        # - raw_pending.json LLM 失败 / I3 拒写原文降级池（不静默丢，origin=llm_failed_raw）
        # - archive/       种子 + 月度归档留痕（I5 16/16 可追溯）
        # - export/*.md    人读面（Should，derived view，零回写）
        self.knowledge_dir = self.storage_dir / "knowledge"
        self.knowledge_entries_path = self.knowledge_dir / "entries.json"
        self.knowledge_raw_pending_path = self.knowledge_dir / "raw_pending.json"
        self.knowledge_archive_dir = self.knowledge_dir / "archive"
        self.knowledge_export_dir = self.knowledge_dir / "export"
        for d in [self.knowledge_dir, self.knowledge_archive_dir, self.knowledge_export_dir]:
            d.mkdir(parents=True, exist_ok=True)

        # M6 Plan A: resolve this provider's OWN profile from the engine-injected
        # profile-scoped hermes_home (memory_provider.initialize docs: hermes_home
        # is "profile-scoped storage; never hardcode ~/.hermes"). NOT probing, NOT
        # hardcoded — we read the home the engine already passes, then stamp it as
        # source_profile on every entry we write (data-engineer: stamp at write,
        # decision level only propagates). Layout: <base>/profiles/<name> -> <name>;
        # a base home with no profiles/ segment is the default profile.
        self.source_profile = self._resolve_profile_name(self.hermetis_home)

        # M6 Plan A skill isolation: procedural entries land in the GLOBAL
        # local_semantic layer (never auto-written into a per-profile skill).
        self.local_semantic_dir = self.storage_dir / "local_semantic"
        self.local_semantic_dir.mkdir(parents=True, exist_ok=True)
        # M6 queue: consolidated/pending_upgrades.jsonl (append-only event log)
        self.pending_queue_path = self.storage_dir / "consolidated" / "pending_upgrades.jsonl"
        self.pending_queue_path.parent.mkdir(parents=True, exist_ok=True)

        # Load config
        self._load_config(kwargs)

        # Load externalized decay params (TTL/salience/lambda) — full param surface kept on provider
        self._decay = load_decay_config(self.hermetis_home)

        # t_090d6f3d: apply the decay memory_type block to the LLM reclassify
        # budget knobs set in __init__ (default 5) — a user-tunable llm_per_
        # session overrides it; enable is read live at call time (clean off).
        _mt = self._decay.get("memory_type") or {}
        _lps = _mt.get("llm_per_session")
        if isinstance(_lps, int) and _lps >= 0:
            self._type_classify_limit = _lps

        # Ensure base files exist
        self._ensure_base_files()

        # Factory seed: a fresh store ships the L2 task-priority meta-rule
        # (idempotent — re-init / post --central relocation of a non-empty
        # store both no-op cleanly). Placed after _ensure_base_files so the
        # memories/ shard dir is guaranteed to exist.
        self._seed_factory_rules()

        # Load session drafts
        self._load_session_drafts()

        # Ops guard (117 incident 2026-09-27): stale backup dirs left in the
        # plugin discovery root all carry plugin.yaml, so the engine
        # auto-registers each as a second filemem provider. Backups belong
        # in ~/.hermes/archive/, never under plugins/ — log it loud, don't
        # silently degrade.
        _dup_dirs = self._warn_duplicate_plugin_dirs()
        if _dup_dirs:
            logger.warning(
                "FileMem: duplicate filemem plugin dir(s) under %s will be "
                "auto-registered by the engine: %s — move them to ~/.hermes/archive/ "
                "(stale path detected LOUD, per ops invariant)",
                self.storage_dir.parent.parent, [d.name for d in _dup_dirs],
            )

        logger.info(f"FileMem: initialized for session {session_id}")

    @staticmethod
    def _resolve_profile_name(hermes_home: Path) -> str:
        """Derive the owning profile from a profile-scoped home path."""
        parts = [p for p in hermes_home.parts if p]
        if "profiles" in parts:
            idx = parts.index("profiles")
            if idx + 1 < len(parts):
                return parts[idx + 1]
        return "default"

    def _warn_duplicate_plugin_dirs(self) -> List[Path]:
        """117 incident 2026-09-27 ops guard (researcher invariant: stale paths
        must be LOUD, never a silent no-op).

        The engine auto-discovers ANY dir under plugins/ carrying a
        plugin.yaml. Leftover backup dirs (.old / .backup-* / .pre-*) all carry
        one, so EVERY sibling gets instantiated as a file-memory provider and a
        stale instance steals the memory slot, silently degrading the live code
        path. Detect duplicates by NAME (not a hardcoded dir name): read the
        live install's own plugin.yaml `name:` as the source of truth for
        provider identity, then flag any OTHER sibling under the discovery root
        whose plugin.yaml declares the SAME name. The caller logs a WARNING
        telling the operator to move them to ~/.hermes/archive/. Fail-soft: a
        disk hiccup returns [], never blocks.
        """
        plugins_dir = self.storage_dir.parent.parent
        live_dir = self.storage_dir.parent
        dups: List[Path] = []

        def _declared_name(manifest: Path) -> str:
            # Single source of provider identity: the `name:` value in a
            # plugin.yaml. "" on any hiccup (missing / unreadable / no name:).
            try:
                if not manifest.exists():
                    return ""
                for line in manifest.read_text(encoding="utf-8").splitlines():
                    s = line.strip()
                    if s.startswith("name:"):
                        return s.split(":", 1)[1].strip()
            except Exception:
                return ""
            return ""

        try:
            if plugins_dir and plugins_dir.exists():
                live_name = _declared_name(live_dir / "plugin.yaml")
                if live_name:
                    for d in sorted(plugins_dir.iterdir()):
                        if not d.is_dir() or d == live_dir:
                            continue  # skip the live install itself (by path)
                        if _declared_name(d / "plugin.yaml") == live_name:
                            dups.append(d)
        except Exception:
            return []
        return dups

    def on_session_end(self, messages: List[Dict[str, Any]]) -> Optional[str]:
        """Called when session ends - draft confirmation.

        NOTE: the engine (agent/memory_manager._each_provider) DISCARDS the
        return value of on_session_end (base contract is -> None), so the
        prompt built here is logged but never shown to the user. The actual
        user-visible confirmation surface is the [未决草稿] notice injected by
        _pending_draft_notice() on the next session's first pre_llm_call,
        disposed of via file_memory_review_drafts(target=...). This method is
        kept for the episodic + consolidation side-effects (B4/D4), which DO
        run.
        """
        # Safety: ensure _session_drafts is a dict and value is a list
        if not isinstance(self._session_drafts, dict):
            logger.warning("FileMemory: _session_drafts is not a dict, resetting")
            self._session_drafts = {}

        session_id = getattr(self, 'session_id', '')
        if not session_id:
            logger.warning("FileMemory: no session_id available, skipping")
            return None

        drafts = self._session_drafts.get(session_id, [])

        # Safety: ensure drafts is a list
        if not isinstance(drafts, list):
            logger.warning(f"FileMemory: session_id {session_id} has non-list drafts ({type(drafts).__name__}), clearing")
            self._session_drafts[session_id] = []
            return None

        # D4(a)/F2 (S1b): the consolidation tick is an UNCONDITIONAL boundary
        # trigger — spawn it BEFORE the drafts gate so a zero-draft session
        # (the common production case) still fires the tick. The episodic /
        # draft flow below stays drafts-gated (a draft-less session has
        # nothing to summarize). Locked order: spawn, then episodic.
        self._spawn_llm_consolidation()

        if not drafts:
            return None

        # Format drafts for display
        draft_summaries = []
        for draft in drafts:
            draft_summaries.append(f"- [{draft.level}] {draft.content[:80]}...")

        # New: Auto-confirm prompt - instructs LLM to call the tool
        prompt = f"\n\n**Session Summary**\n\nFound {len(drafts)} memory(s) to save:\n" + "\n".join(draft_summaries) + """

---
💾 **Auto-Confirm**

Call `file_memory_review_drafts(action="confirm")` to save these memories permanently.
"""
        logger.info(f"FileMemory: session end prompt generated for {len(drafts)} drafts")

        # B4: write episodic summary into sharded JSONL (yyyy/mm), gated by salience_threshold
        self._write_episodic_entry(session_id, drafts)

        # D4(a): the consolidation tick spawn was relocated to BEFORE the
        # drafts gate (the unconditional boundary trigger, F2/S1b) so a
        # zero-draft session still fires it. Only ONE spawn call remains in
        # on_session_end — the pre-gate one above.
        return prompt

    def _probe_storage_root_override(self) -> str:
        """T5b: explicit ``storage_root`` override from
        ``plugins.entries.filemem``. Returns "" (none → auto), the literal
        string "per_profile" (explicit isolation), or an absolute path.

        Isolation must be OPT-IN and loud (a silent default shared store is the
        accident class this tier eliminates); the override is read straight from
        the config so it never depends on initialize() ordering."""
        try:
            from hermes_cli.config import load_config
            entries = load_config().get("plugins", {}).get("entries", {})
            val = (entries.get("filemem") or {}).get("storage_root", "")
            return str(val or "")
        except Exception:
            return ""

    def _resolve_storage_root(self) -> Path:
        """T5b: config-tier storage root. Loud, never silent.

        - auto (no override): the shared neutral root ``<base>/filemem`` where
          ``base`` is hermes_home with a trailing ``profiles/<name>`` segment
          stripped and canonicalized — every profile converges on ONE tree.
        - override "per_profile": legacy ``<hermes_home>/plugins/filemem/storage``
          (explicit isolation).
        - override <path>: that exact root.

        Dual-root defense (@data-engineer ②): the auto base must EXIST and be
        canonical after ``Path.resolve()``; otherwise (an unresolved symlink
        home that would compute the wrong base) we fall back to the per-profile
        path with a WARNING rather than silently writing a shared store to an
        unexpected location. Relocation (auto/explicit differs from legacy) is
        logged so a switch is never a silent re-target."""
        legacy = Path(self.hermetis_home or Path.home() / ".hermes") / "plugins" / "filemem" / "storage"
        override = self._probe_storage_root_override()

        if override == "per_profile":
            self.storage_root_mode = "per_profile"
            self.storage_dir = legacy
            return legacy

        if override:
            self.storage_root_mode = f"explicit:{override}"
            self.storage_dir = Path(override).expanduser()
            self._log_storage_relocation(legacy, self.storage_dir)
            return self.storage_dir

        # auto → neutral root
        home = Path(self.hermetis_home or Path.home() / ".hermes")
        parts = [p for p in home.parts if p]
        if "profiles" in parts:
            idx = parts.index("profiles")
            base = Path(*parts[:idx]) if idx > 0 else None
        else:
            base = Path(*parts) if parts else None
        if base is None:
            base = Path.cwd()
        try:
            base_resolved = base.resolve()
            ok = base_resolved.is_dir()
        except OSError:
            base_resolved, ok = base, False
        if not ok:
            logger.warning(
                f"FileMem: storage-root auto-parse failed ({base_resolved} does not "
                f"exist / not canonical) — falling back to per-profile storage (loud, not silent)")
            self.storage_root_mode = "auto_fallback_per_profile"
            self.storage_dir = legacy
            return legacy

        self.storage_root_mode = "auto"
        self.storage_dir = base_resolved / "filemem"
        self._log_storage_relocation(legacy, self.storage_dir)
        return self.storage_dir

    def _log_storage_relocation(self, legacy: Path, new: Path) -> None:
        """Loud relocation marker (@data-engineer no-dual-write gate): when the
        store physically moves off the legacy per-profile path, the switch is
        logged so a new write landing on the old tree is instantly visible."""
        if new != legacy:
            logger.info(f"FileMem: storage root relocated: {legacy} -> {new}")

    @contextmanager
    def _shard_lock(self, path: Path):
        """Cross-process lock for one storage file via ``<path>.lock``.

        The instance ``self._lock`` only serializes ONE process. On 117 the
        gateway co-writes one shared neutral store from ~10 profiles, so every
        read-modify-write on a shared pool file must ALSO serialize across
        processes (fcntl on the 117 Linux target / msvcrt on Windows). This is
        the gate behind @data-engineer's "N processes, 0 lost updates" test.
        On a host with neither primitive it degrades to a loud no-op (the
        content dedup gate remains the backstop)."""
        lock_path = path.with_name(path.name + ".lock")
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        if fcntl is not None:
            fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o644)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX)
                yield
            finally:
                fcntl.flock(fd, fcntl.LOCK_UN)
                os.close(fd)
        elif msvcrt is not None:
            lock_path.touch(exist_ok=True)
            fh = open(lock_path, "a+b")
            try:
                fh.seek(0)
                if fh.tell() == 0:
                    # Windows locking() fails beyond EOF — reserve byte 0
                    fh.write(b"0")
                    fh.seek(0)
                msvcrt.locking(fh.fileno(), msvcrt.LK_LOCK, 1)
                yield
            finally:
                try:
                    msvcrt.locking(fh.fileno(), msvcrt.LK_UNLCK, 1)
                except Exception:  # pragma: no cover - already released
                    pass
                fh.close()
        else:  # pragma: no cover - exotic host
            logger.warning(
                f"FileMem: no cross-process lock primitive (fcntl/msvcrt) for "
                f"{lock_path.name} — relying on the in-process lock + dedup gate")
            yield

    # ────────────────────────────────────────────────────────────────────────
    #  Native-md drain (t_db244983 · PRD §3 D1-D10, §4 component spec)
    #
    #  drain_native_md() runs on the pre_llm_call (turn_start) face, piggybacked
    #  on the SAME hook that drives filemem_auto_retrieve (D1: zero new hook
    #  registration). It moves this profile's MEMORY.md / USER.md §-entries into
    #  the shared filemem pool, then cleanly removes them from the md, so the md
    #  stays near-empty in the steady state. One-directional + idempotent (D8).
    #
    #  The drain only CALLS the host's public surface (load_on_disk_store /
    #  get_memory_dir); it NEVER imports a host private symbol and NEVER writes
    #  outside the whitelist (pool tree + memories/{MEMORY,USER}.md deletion).
    # ────────────────────────────────────────────────────────────────────────

    def drain_native_md(self, session_id: str = "") -> Dict[str, Any]:
        """Drain the host's native per-profile MEMORY.md / USER.md into the
        shared filemem pool, then cleanly remove the drained entries from the md.

        Called from the pre_llm_call hook (turn_start). Returns a small summary
        dict (entries moved / kept / which path). NEVER raises to the host turn
        (fail-soft, like filemem_auto_retrieve): any hiccup is logged and the
        turn proceeds unchanged (D8: a failed write keeps the md entry and the
        next turn retries)."""
        sid = session_id or getattr(self, "_turn_active_sid", None) or self.session_id
        summary: Dict[str, Any] = {"moved": 0, "kept": 0, "path": {}}
        for target in ("memory", "user"):            # D9: two files, one call
            try:
                res = self._drain_one_target(target, sid, summary)
                summary["path"][target] = res
            except Exception as e:                   # fail-soft: never wedge the turn
                logger.warning(f"FileMem: drain[{target}] failed (md kept): {e}")
                summary["path"][target] = "error"
        if summary["moved"] or summary["kept"]:
            logger.info(
                f"FileMem: native-md drain sid={sid} moved={summary['moved']} "
                f"kept(write-fail)={summary['kept']} path={summary['path']}")
        return summary

    def _drain_one_target(self, target: str, sid: str,
                          summary: Dict[str, Any]) -> str:
        """Drain one md file (target in {"memory","user"}). Returns the delete
        path taken ("host-api" | "bare-write" | "noop") for observability."""
        fname = "USER.md" if target == "user" else "MEMORY.md"
        md_path = self._drain_memories_dir() / fname
        try:
            st = md_path.stat()
        except (FileNotFoundError, OSError):
            # No md on disk -> nothing to drain; drop any stale D2 cache so a
            # re-created file is re-read next turn (not a stale no-op).
            seen = getattr(self, "_drain_seen", None)
            if seen is not None:
                seen.pop(target, None)
            return "noop"

        # D2 short-circuit: cache per-target (mtime_ns, size, last-parsed
        # entries). An UNCHANGED md (same mtime+size) reuses the last parse
        # without re-reading / re-hashing -> steady-state drain is a stat
        # compare (<1ms, no pool write, no LLM). Undrained entries left by a
        # prior WRITE FAILURE stay in `entries` and are retried below, so the
        # fast path only fires when the md is genuinely empty of work.
        seen = getattr(self, "_drain_seen", None)
        if seen is None:
            seen = self._drain_seen = {}
        last = seen.get(target)
        if (last is not None and last.get("mtime_ns") == st.st_mtime_ns
                and last.get("size") == st.st_size):
            entries = list(last.get("entries") or [])
        else:
            raw = md_path.read_text(encoding="utf-8-sig")     # utf-8-sig strips a BOM
            entries = [e for e in (x.strip() for x in raw.split(NATIVE_MD_ENTRY_SEP)) if e]
            seen[target] = {"mtime_ns": st.st_mtime_ns, "size": st.st_size, "entries": entries}
        if not entries:
            return "noop"                                      # D2 steady state

        # D3/D4/D5/D8: for each md entry, land it in the pool (profile-scoped
        # dedup) and track which are safe to delete. Dedup ONLY gates the WRITE;
        # it never gates the delete. A write FAILURE keeps the md entry (retry
        # next turn) — the one-directional invariant.
        to_delete: List[str] = []
        kept = 0
        for entry in entries:
            try:
                res = self._drain_write_native(entry, target, sid)
            except Exception as e:
                logger.warning(f"FileMem: drain write failed for {entry[:30]!r}: {e}")
                res = "failed"
            if res == "failed":
                kept += 1                                       # D8: keep md, retry next turn
                continue
            to_delete.append(entry)
            summary["moved"] += 1
        summary["kept"] += kept

        if not to_delete:
            return "noop"     # every entry's write failed (md unchanged) OR all deduped+nothing pending
        # D6 (host API) preferred; D7 (bare-write) fallback. Both serialize
        # against the host's own turn_end write window (same .lock) -> acc #2.
        _delete_path = self._drain_delete_md(target, to_delete, entries)
        if _delete_path in ("host-api", "bare-write"):
            # Refresh the D2 cache to the POST-DELETE on-disk state by
            # re-reading the file (NOT assuming it's empty). This matters for
            # D8: when some pool writes failed, those entries were KEPT in the
            # md and survived the delete — the cache must track them so the
            # next turn RETRIES them (the "write-fail keep + next-turn retry"
            # invariant). An empty survivors list is the steady state.
            try:
                st2 = md_path.stat()
                raw2 = md_path.read_text(encoding="utf-8-sig")
                _survivors = [e for e in (x.strip() for x in raw2.split(NATIVE_MD_ENTRY_SEP)) if e]
                seen[target] = {"mtime_ns": st2.st_mtime_ns, "size": st2.st_size, "entries": _survivors}
            except OSError:
                # Post-delete stat/read failed (odd host) -> drop the cache
                # entry so the NEXT drain does a full re-read (never
                # short-circuit off a possibly-stale entry).
                seen.pop(target, None)
        # delete took host-api or bare-write -> report the actual path; a
        # failed delete -> md kept as-is, do NOT refresh the cache (the
        # entries are still there and must be retried next turn, not
        # short-circuited).
        return _delete_path

    def _drain_write_native(self, entry: str, target: str, sid: str) -> str:
        """Land one drained entry in the pool (L0, source=auto, D5 category
        stamp, source_profile stamp). Profile-scoped dedup (D4): a row already
        present under THIS profile + THIS content-fp -> "dup" (safe to delete,
        no new row). Otherwise write a NEW row -> "written". Any write failure
        -> "failed" (caller keeps the md entry). Never touches _detect_type
        (calls it) — red line."""
        content = entry.strip()
        if not content:
            return "dup"                     # empty -> nothing to pool, safe to delete
        category = NATIVE_DRAIN_CATEGORIES.get(target, "native-memory")
        source = NATIVE_DRAIN_SOURCE         # "auto" (D5): auto-enters distill gate
        level = "L0"
        mem_type = self._detect_type(content)    # deterministic, zero LLM (red line: don't modify)
        mem_file = self.memories_dir / f"{mem_type}.json"
        fp = self._drain_fingerprint(content)    # D3: normalized content fingerprint
        sp = getattr(self, "source_profile", "default")
        with self._lock:
            with self._shard_lock(mem_file):
                items = self._read_memories_file(mem_file)
                # D4: dedup key = (source_profile, content-fp). A row under
                # ANOTHER profile does NOT block this write (the shared central
                # pool must not let profile A clobber profile B).
                for it in items:
                    if (self._drain_row_profile(it) == sp
                            and self._drain_fingerprint(it.get("content", "")) == fp):
                        return "dup"
                # NEW row — mirror the _save_memory auto-row stamping EXACTLY
                # (so the rest of the pipeline treats it uniformly) + the D5
                # drain category + an audit drain_fp.
                _meta = self._failure_meta_for(sid, {"source_profile": sp})
                _meta = self._self_test_meta(_meta)
                _meta["marker_count"] = 1
                _meta["drain_fp"] = fp
                _meta["drain_source"] = f"native-{target}"
                _stamp_origin_in_meta(_meta, source)
                item = MemoryItem(
                    id=f"{mem_type}_drain_{len(items)}_{_utcnow().timestamp():.0f}",
                    type=mem_type,
                    content=content,
                    category=category,
                    level=level,
                    source=source,
                    created_at=_utcnow().isoformat(),
                    updated_at=_utcnow().isoformat(),
                    occurred_at=extract_occurred_at(content),
                    metadata=_meta,
                )
                row = item.to_dict()
                _stamp_lineage_candidates(row, items, getattr(self, "_decay", None) or {})
                items.append(row)
                with open(mem_file, "w", encoding="utf-8") as f:
                    json.dump(items, f, ensure_ascii=False, indent=2)
                new_id = item.id
        # Post-write: feed the row into the EXISTING auto-row pipeline (D5
        # "auto 自动接入既有 distill 门，零改动"). Fail-soft + guarded so a
        # partial provider (tests via __new__) never breaks the drain.
        try:
            self._push_pending_confirm(sid, new_id, level, content, kind="l0")
        except Exception as e:
            logger.debug(f"FileMem: drain pending-confirm push skipped: {e}")
        try:
            self._distill_item(mem_type, new_id, content, session_id=sid)
        except Exception as e:
            logger.debug(f"FileMem: drain distill skipped: {e}")
        return "written"

    def _drain_delete_md(self, target: str, to_delete: List[str],
                         all_entries: List[str]) -> str:
        """Remove the drained entries from the md. D6 (host store API, same
        .lock + drift guard -> structurally zero drift) preferred; D7 bare-write
        fallback when the host API is absent or a hard delete fails. Returns the
        path that ACTUALLY performed the delete ("host-api" | "bare-write" |
        "noop") so the caller's observability label is accurate even when D6
        hard-fails and D7 runs instead.

        D6 uses per-entry `store.remove(target, entry)` (NOT apply_batch):
        remove re-reads the live file under the host's own .lock, so it is
        correct even when the host wrote to the md at turn_end between store
        creation and this drain (acc #2: drain-turn_start and native-write-
        turn_end serialize on the SAME .lock). The drained entry's FULL text is
        the old_text -> whole-entry exact match (the host's _find_unique_match),
        so a sibling entry can never be clobbered."""
        to_delete_set = set(to_delete)
        host_store = self._drain_host_store()
        if host_store is not None:
            ok = True
            for entry in to_delete:
                res = host_store.remove(target, entry)
                if isinstance(res, dict) and res.get("success"):
                    continue
                # "No entry matched" = already gone (a concurrent host delete or
                # an idempotent re-drain) -> treat as deleted, keep going.
                _err = (res or {}).get("error", "") if isinstance(res, dict) else ""
                if ("No entry matched" in _err) or (not _err):
                    continue
                # A hard failure (drift_error / unreadable file) -> bail to D7.
                logger.warning(
                    f"FileMem: drain D6 remove({entry[:30]!r}) not applied "
                    f"({_err}) — falling back to D7 bare-write")
                ok = False
                break
            if ok:
                return "host-api"
        # D7: bare-write fallback contract (PRD D7): exclusive .lock -> read §
        # list -> drop targets -> temp + atomic rename write the clean § list
        # (no BOM / no free text / single entry <= limit -> round-trip clean).
        if self._drain_bare_write(target, to_delete_set, all_entries):
            return "bare-write"
        return "noop"

    def _drain_bare_write(self, target: str, to_delete_set: set,
                          all_entries: List[str]) -> bool:
        """D7 bare-write delete. Reproduces the host's own .lock + atomic
        temp+rename contract so the md stays a clean round-trip-able §-list
        (no external drift / no .bak snapshot on the host's next write)."""
        fname = "USER.md" if target == "user" else "MEMORY.md"
        md_path = self._drain_memories_dir() / fname
        lock_path = md_path.with_suffix(md_path.suffix + ".lock")
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        if fcntl is not None:
            fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o644)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX)
                return self._drain_bare_write_locked(md_path, to_delete_set)
            finally:
                fcntl.flock(fd, fcntl.LOCK_UN)
                os.close(fd)
        elif msvcrt is not None:
            lock_path.touch(exist_ok=True)
            fh = open(str(lock_path), "a+b")
            try:
                fh.seek(0)
                if fh.tell() == 0:
                    fh.write(b"0")
                    fh.seek(0)
                msvcrt.locking(fh.fileno(), msvcrt.LK_LOCK, 1)
                return self._drain_bare_write_locked(md_path, to_delete_set)
            finally:
                try:
                    msvcrt.locking(fh.fileno(), msvcrt.LK_UNLCK, 1)
                except Exception:
                    pass
                fh.close()
        else:  # pragma: no cover - exotic host (loud no-op, dedup is backstop)
            logger.warning(f"FileMem: drain D7 has no flock primitive; bare write unlocked")
            return self._drain_bare_write_locked(md_path, to_delete_set)

    def _drain_bare_write_locked(self, md_path: Path, to_delete_set: set) -> bool:
        """The read->filter->atomic-rewrite core (called under the .lock)."""
        raw = md_path.read_text(encoding="utf-8-sig")
        entries = [e for e in (x.strip() for x in raw.split(NATIVE_MD_ENTRY_SEP)) if e]
        survivors = [e for e in entries if e not in to_delete_set]
        if survivors == entries:
            return True                       # nothing left to delete (already clean)
        # Atomic temp+rename: readers never see a truncated/partial file, and
        # the written bytes are exactly the clean §-list (no BOM, no free text).
        tmp = md_path.with_name(md_path.name + ".memdrain_tmp")
        tmp.write_text(NATIVE_MD_ENTRY_SEP.join(survivors), encoding="utf-8")
        os.replace(str(tmp), str(md_path))    # atomic rename (same filesystem)
        return True

    # ── drain seams (overridable in tests; host-public in production) ────────

    def _drain_enabled(self) -> bool:
        """Config gate for the native-md drain: ``plugins.entries.filemem.
        native_drain`` (default ON — the PRD's purpose is to enable it; a flip
        to false is the rollback switch, no code change). A partial provider
        (tests via __new__) with no loaded config falls back to ON."""
        if getattr(self, "_drain_disabled", False):
            return False
        if hasattr(self, "_native_drain"):
            return bool(self._native_drain)
        try:
            from hermes_cli.config import load_config
            entries = load_config().get("plugins", {}).get("entries", {})
            return bool((entries.get("filemem") or {}).get("native_drain", True))
        except Exception:
            return True

    def _drain_memories_dir(self) -> Path:
        """The on-disk dir of the native MEMORY.md / USER.md the drain consumes.
        Production: the host's public get_memory_dir() (the SAME dir the host
        writes at turn_end, so the delete always matches the writer). A test
        seam (`_drain_memories_dir_fn`) can point it at a tmp dir."""
        seam = getattr(self, "_drain_memories_dir_fn", None)
        if seam is not None:
            return Path(seam())
        try:
            from tools.memory_tool import get_memory_dir
            return Path(get_memory_dir())
        except Exception:
            return Path(self.hermetis_home or Path.home() / ".hermes") / "memories"

    def _drain_host_store(self):
        """D6 seam: a host `MemoryStore` bound to the live memories dir (its
        public delete API: remove/apply_batch under the host's own .lock + drift
        guard), or None when the host public API is unavailable -> the drain
        uses the D7 bare-write fallback. Production probes load_on_disk_store()
        once per instance and caches the verdict; a test seam
        (`self._drain_host_store_fn`, a callable or a fixed value) overrides the
        probe so a test can bind a tmp-bound store or force the D7 path."""
        override = getattr(self, "_drain_host_store_fn", None)
        if override is not None:
            return override() if callable(override) else override
        if not hasattr(self, "_drain_host_cache"):
            self._drain_host_cache = self._probe_drain_host_store()
        return self._drain_host_cache

    def _probe_drain_host_store(self):
        """Probe the host PUBLIC delete API once. Never raises (absent host /
        older build -> None -> the D7 bare-write path). Public symbol only."""
        try:
            from tools.memory_tool import load_on_disk_store
            store = load_on_disk_store()
            # Only trust a store that actually exposes the public delete API.
            if hasattr(store, "apply_batch") and hasattr(store, "remove"):
                return store
            logger.warning("FileMem: load_on_disk_store lacks public delete API -> D7")
            return None
        except Exception as e:
            logger.info(f"FileMem: host drain store unavailable ({e}) -> D7 bare-write path")
            return None

    @staticmethod
    def _drain_fingerprint(content: str) -> str:
        """D3: the normalized content fingerprint (whitespace-collapsed + lower
        case + sha256[:16]). Deterministic, zero LLM. The dedup gate keys on
        (source_profile, this-fp) so a per-profile stamp never clobbers a
        sibling profile's identical content (D4 / acc #4)."""
        norm = " ".join((content or "").split()).lower()
        return hashlib.sha256(norm.encode("utf-8")).hexdigest()[:16]

    @staticmethod
    def _content_hash(content: str) -> str:
        """P1-1b: deterministic sha256 of raw content for idempotent upsert.
        Keys on raw bytes — no normalization — so the hash is stable across
        re-saves and distinguishes content that differs only in whitespace
        from content that is truly the same (whitespace dedup is handled by
        _drain_fingerprint for the drain path; this is the _save_memory gate)."""
        return hashlib.sha256((content or "").encode("utf-8")).hexdigest()

    @staticmethod
    def _drain_row_profile(row: Dict[str, Any]) -> Optional[str]:
        """A pool row's owning-profile stamp (memories rows carry it in
        metadata.source_profile). Mirrors the P0-2 read so the drain's dedup
        sees the SAME stamp the read face uses (no stamp -> None = neutral)."""
        meta = row.get("metadata") if isinstance(row, dict) else None
        sp = meta.get("source_profile") if isinstance(meta, dict) else None
        if sp in (None, ""):
            sp = row.get("source_profile") if isinstance(row, dict) else None
        return None if sp in (None, "") else str(sp)

    def _load_config(self, kwargs: Dict[str, Any]) -> None:
        """Load configuration."""

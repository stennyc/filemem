    def _audit_tick_skip(self, reason: str) -> None:
        """S1b F4: one throttled `tick_skip` audit row (North Star #1
        self-proof face): the skip CLASS (in-flight / interval / llm_ctx
        None) is exactly the paper capability that was missing — every
        skipped tick now leaves a bounded, reasoned trail instead of a
        silent 3-day silence.

        Throttle: AT MOST ONE row per `consolidation_interval_min` window
        (shares _last_skip_audit_ts with the LLM-face ctx-None skip, so a
        busy turn loop never floods consolidation_log — the event write
        itself is fail-soft and must not break the tick path that
        scheduled it). interval 0 (disabled) => every skip is auditable."""
        try:
            cfg = (getattr(self, "_decay", None) or {}).get("consolidation") or {}
            try:
                interval_min = float(cfg.get("consolidation_interval_min", 30) or 0)
            except (TypeError, ValueError):
                interval_min = 30.0
            now = time.time()
            last = getattr(self, "_last_skip_audit_ts", 0.0) or 0.0
            if interval_min > 0 and (now - last) < interval_min * 60.0:
                return  # throttle: one tick_skip row per window, silent otherwise
            self._last_skip_audit_ts = now
            self._append_consolidation_event({
                "ts": _utcnow().isoformat(),
                "action": "tick_skip",
                "reason": reason,
                "session_id": getattr(self, "session_id", None) or "default",
                "source_profile": getattr(self, "source_profile", "default"),
            })
        except Exception as e:
            # audit hiccup must never break the tick path that scheduled it
            logger.debug(f"FileMem: tick_skip audit write failed: {e}")

    def _rebind_main_runtime(self) -> None:
        """Per-tick live rebind of the host main_runtime snapshot (4d LLM 面 fix).

        register() captures _HOST_MAIN_RUNTIME once at boot, OUTSIDE any host
        turn: on a gateway/api_server-driven profile (4d) the boot-time
        contextvar _RUNTIME_MAIN_CONTEXT is empty, so the boot capture stays
        None forever while every tick dead-skips the LLM faces
        (`tick_skip: main_runtime missing` in the live 4d consolidation_log).

        The tick daemon thread, however, runs under the spawner's contextvars
        (host spawn_context_thread -> ctx_bound copies the spawner context;
        the fallback bare thread gets an empty context — both are handled),
        so when the host PUBLISHED the live main runtime for the turn that
        spawned this tick (build_turn_context -> _publish_runtime_main on
        the executor thread, visible to the post_llm_call hook face), the
        host helper `_normalize_main_runtime(None)` read LIVE on the tick
        thread resolves it. Ladder (all via the host helper — zero hardcoded
        model names / zero custom provider config):

          a. live tick-thread read -> tick_live;
          b. module-level _HOST_MAIN_RUNTIME captured at boot/lazy ->
             module_fallback;
          c. else None — the LLM faces keep today's exact skip semantics
             (the existing `main_runtime missing` tick_skip audit still
             fires; a rebind row with source=none is written for
             self-provability but deliberately does NOT consume the shared
             throttle slot, so it can never starve the skip row).

        No-clobber: a current non-None value is kept (nothing is ever
        clobbered to None). Audit: one `main_runtime_rebind` row per
        outcome, throttled to the same window as tick_skip
        (_last_skip_audit_ts / consolidation_interval_min — never a
        per-tick flood); successful binds stamp the window, the none
        outcome only READS it. provider/model are NAMES ONLY: the host
        helper's api_key may be a callable (Entra token provider) — it is
        never referenced in the row (zero disk落盘).
        Standalone (host helper unimportable, L51 fallback None) -> ladder
        fully empty -> keep current value, today's semantics, never a crash.
        """
        current = getattr(self, "_main_runtime", None)
        if current is not None:
            return  # no-clobber: a live snapshot is already bound (register/
            # module inheritance reached this instance) — keep it.
        resolved = None
        if _normalize_main_runtime is not None:
            try:
                # Ladder a: read the contextvar LIVE on the tick thread.
                # The host helper returns {} (never None) for an empty
                # contextvar; `or None` keeps today's exact
                # "None = no snapshot" semantics ({} -> None).
                resolved = _normalize_main_runtime(None) or None
            except Exception as e:
                # helper hiccup (old host build mid-upgrade, ...) -> fall
                # through to the module fallback; never break the tick.
                logger.debug(f"FileMem: tick main_runtime rebind read failed: {e}")
                resolved = None
        if resolved is not None:
            source = "tick_live"
        elif _HOST_MAIN_RUNTIME is not None:
            resolved = _HOST_MAIN_RUNTIME
            source = "module_fallback"
        else:
            source = "none"
        if resolved is not None:
            self._main_runtime = resolved
        # One audit row per outcome (overwrite / fallback / keep-None),
        # throttled to the tick_skip window. Success stamps the slot;
        # none leaves it free so the `main_runtime missing` tick_skip row
        # written moments later by the LLM faces still lands. provider/
        # model are NAMES ONLY (api_key is never referenced — it may be
        # a callable, and zero disk落盘 is the hard constraint).
        try:
            last = getattr(self, "_last_skip_audit_ts", 0.0) or 0.0
            try:
                interval_min = float(((getattr(self, "_decay", None) or {}).get("consolidation") or {}).get("consolidation_interval_min", 30) or 0)
            except (TypeError, ValueError):
                interval_min = 30.0
            now = time.time()
            if interval_min <= 0 or (now - last) >= interval_min * 60.0:
                if resolved is not None:
                    self._last_skip_audit_ts = now
                row = {
                    "ts": _utcnow().isoformat(),
                    "action": "main_runtime_rebind",
                    "source": source,
                    "session_id": getattr(self, "session_id", None) or "default",
                    "source_profile": getattr(self, "source_profile", "default"),
                }
                if resolved is not None:
                    row["provider"] = resolved.get("provider") or None
                    row["model"] = resolved.get("model") or None
                self._append_consolidation_event(row)
        except Exception as e:
            # audit hiccup must never change the tick outcome (fail-soft)
            logger.debug(f"FileMem: main_runtime_rebind audit write failed: {e}")

    def _s3_water_level(self) -> int:
        """S3 mixed-trigger water-level counter: the number of UNPROCESSED
        work items that justify an early (override) consolidation tick before
        the 30-minute interval elapses. Sums three backlog markers:
          * unconfirmed supersede candidates (EP-1 stamped, awaiting EP-2)
          * unscored episodic entries (rescore not yet run)
          * un-synthesized raw_pending topics (observe not yet run)

        The actual O(pool) scan lives in _s3_water_level_rescan. THIS method
        fronts it with a provider-side TTL cache (_s3_wl_cache /
        _s3_wl_cache_ts, default 60s, knob water_level_cache_ttl_s) so the
        hot post_llm_call path pays at most ONE full read per TTL window
        instead of one per host turn — the "hot path never rescans the full
        pool more than ~1/min" posture the 60-min trigger cooldown alone
        does not guarantee (the cooldown caps TRIGGER frequency, not the
        counter's read frequency). 0 / cache miss / a read hiccup all
        degrade to "no early trigger" — fail-soft, never a full rescan on
        the hot turn beyond the TTL-bound one."""
        # ── TTL cache (provider attr): one full read per water_level_cache_ttl_s ──
        try:
            ttl = float((self._decay.get("consolidation") or {}).get(
                "water_level_cache_ttl_s", 60) or 0)
        except (TypeError, ValueError):
            ttl = 60.0
        cache_ts = getattr(self, "_s3_wl_cache_ts", 0.0) or 0.0
        now = time.time()
        if ttl > 0 and (now - cache_ts) < ttl:
            return int(getattr(self, "_s3_wl_cache", 0) or 0)
        total = self._s3_water_level_rescan()
        self._s3_wl_cache = total
        self._s3_wl_cache_ts = now
        return total

    def _s3_water_level_rescan(self) -> int:
        """The actual O(pool) scan behind the _s3_water_level TTL cache."""
        try:
            total = 0
            # (a) unconfirmed supersede candidates across the 4 semantic shards
            for mem_type in MEMORY_TYPES:
                mem_file = self.memories_dir / f"{mem_type}.json"
                if not mem_file.exists():
                    continue
                try:
                    with open(mem_file, encoding="utf-8") as fh:
                        items = json.load(fh)
                except (json.JSONDecodeError, OSError):
                    continue
                for it in items:
                    meta = it.get("metadata") if isinstance(it, dict) else None
                    if isinstance(meta, dict) and meta.get("supersede_state") == "candidate":
                        total += 1
            # (b) unscored episodic entries (reuses the existing incremental helper)
            try:
                total += len(self._unscored_episodic_candidates(
                    set(self._load_rescore_events().keys())))
            except Exception:
                pass
            # (c) un-synthesized raw_pending topics (the observe face's input pool)
            rp = getattr(self, "knowledge_raw_pending_path", None)
            if rp is not None and rp.exists():
                try:
                    with open(rp, encoding="utf-8") as fh:
                        loaded = json.load(fh)
                    if isinstance(loaded, list):
                        topics = {str(r.get("topic")) for r in loaded
                                  if isinstance(r, dict) and str(r.get("topic") or "")}
                        active_obs = set()
                        entries = self._read_knowledge_entries()
                        for e in entries:
                            if e.get("kind") in ("observation", "aggregation") \
                                    and e.get("status") == "active" \
                                    and not e.get("stale"):
                                active_obs.add(str(e.get("topic") or ""))
                        total += len([t for t in topics if t and t not in active_obs])
                except (json.JSONDecodeError, OSError):
                    pass
            return total
        except Exception:
            return 0  # a read hiccup must never trigger a full rescan on the hot path

    def _maybe_spawn_consolidation_tick(self) -> None:
        """S1b F1 + S3 mixed trigger: the post_llm_call trigger face.

        S1b (unchanged): interval-throttled consolidation tick spawn
        (root-cause fix #1: the tick previously only reached via the RARE
        on_pre_compress face + the drafts-gated on_session_end face =>
        3 production days, 0 ticks, C 段 never ran).

        S3 addition (mixed trigger, preserves the timer baseline): the timer
        (consolidation_interval_min, default 30) remains the smoothing gate —
        when the pool has no work the 0-hit faces self-skip at near-zero cost.
        On top, a WATER-LEVEL OVERRIDE: when the unprocessed-work backlog
        (_s3_water_level) reaches water_level_threshold (default 3), a tick is
        triggered EARLY even inside the 30-minute window (low latency for a
        burst of new memories). A COOLDOWN (water_level_cooldown_min, default
        60) then suppresses repeated water-level triggers for that many
        minutes after one fires — this is the anti-storm bound that a pure
        water-level trigger would lack (a retry-loop flooding the pool would
        otherwise trigger a tick every turn). The timer still runs in
        parallel; the water level only PULLS AHEAD, it never disables the
        30-minute rhythm.

        Water-level is an O(1) cached counter (_s3_water_level) — NOT a full
        pool rescan — so it is safe to call on every host turn.

        Runs SYNCHRONOUSLY on the host turn but is O(1): attribute reads +
        time.time() + (skip path) one throttled jsonl append. The tick ITSELF
        is the pre-existing daemon thread (_spawn_llm_consolidation,
        L-structure unchanged) — host turn stays zero-blocking. All skips are
        auditable via F4 (_audit_tick_skip); a spawn is not a failure and
        needs no audit.
        """
        try:
            cfg = (getattr(self, "_decay", None) or {}).get("consolidation") or {}
            try:
                interval_min = float(cfg.get("consolidation_interval_min", 30) or 0)
            except (TypeError, ValueError):
                interval_min = 30.0
            # In-flight guard (reused, first check): a tick already running
            # on the consolidation thread wins — the running tick's C/prune
            # sections will finish the work a new spawn would duplicate.
            if getattr(self, "_llm_consolidating", False):
                self._audit_tick_skip("in_flight")
                return
            last = getattr(self, "_last_consolidation_ts", 0.0) or 0.0

            # ── S3: water-level override (only engages when the knob is ON) ──
            # water_level_override (default False => legacy timer-only
            # behavior, byte-identical for pre-S3 configs). When ON and the
            # backlog has crossed the threshold AND we are inside the cooldown
            # window, we let the timer gate PASS (early trigger). The cooldown
            # marker is stamped by the water-level override itself, so a
            # repeated high backlog cannot re-trigger every turn.
            wl_override = bool(cfg.get("water_level_override", False))
            in_window = interval_min > 0 and (time.time() - last) < interval_min * 60.0
            early_trigger = False
            if wl_override and in_window:
                try:
                    threshold = int(cfg.get("water_level_threshold", 3) or 0)
                    cooldown_min = float(cfg.get("water_level_cooldown_min", 60) or 0)
                except (TypeError, ValueError):
                    threshold, cooldown_min = 3, 60.0
                backlog = self._s3_water_level()
                now = time.time()
                since_last_wl = now - (getattr(self, "_last_water_level_ts", 0.0) or 0.0)
                if threshold > 0 and backlog >= threshold \
                        and (cooldown_min <= 0 or since_last_wl >= cooldown_min * 60.0):
                    early_trigger = True
                    self._last_water_level_ts = now  # stamp the cooldown anchor

            if early_trigger:
                self._spawn_llm_consolidation()
                return

            # ── S1b timer baseline (unchanged path) ──
            if in_window:
                self._audit_tick_skip("interval")
                return
            self._spawn_llm_consolidation()
        except Exception as e:
            # The gate is a best-effort face: a config/attr hiccup degrades
            # to "no tick this turn" (retry next turn), never blocks the host.
            logger.debug(f"FileMem: consolidation tick gate failed: {e}")

    def _spawn_llm_consolidation(self) -> None:
        """D4(a): run LLM consolidation off the hook thread (non-blocking) at the
        human 'sleep / context-switch' moment (on_session_end / on_pre_compress)."""
        # S1b F1: stamp the interval slot on EVERY trigger face (gate + boundary
        # faces all funnel here) so the post_llm_call interval gate and the
        # boundary faces share one tick slot per window.
        try:
            self._last_consolidation_ts = time.time()
        except Exception:
            pass
        try:
            from agent.memory_provider import spawn_context_thread
        except Exception:
            spawn_context_thread = None
        def _run():
            # P2: refresh THIS instance's host LLM ctx from the module-level
            # _HOST_LLM_CTX before the 4 LLM segments run. A boundary-face
            # tick (on_pre_compress / on_session_end) that spawns a provider
            # created/cached BEFORE register() would otherwise run the whole
            # tick with a stale/None _llm_ctx and self-skip all 4 LLM faces
            # (rescore/confirm/mine/observe) until the next post_llm_call
            # tick re-refreshes it — a bounded-window loss. The refresh is a
            # module-level O(1) no-op when _HOST_LLM_CTX is None (standalone)
            # and runs on the daemon thread, so the host turn stays
            # zero-blocking (one call, before the 4 LLM faces).
            _refresh_provider_llm_ctx(self)
            # 4d LLM 面 (per-tick live rebind, this card): register-time
            # capture is out-of-turn (boot contextvar empty -> None) on
            # gateway/api_server-driven profiles, so re-resolve the host
            # main_runtime LIVE on the tick thread before the LLM segments
            # run (ladder a: tick-thread live read via the host helper, b:
            # module fallback, c: keep None — the LLM faces' existing
            # `main_runtime missing` skip semantics stay untouched; the
            # rebind never clobbers a bound value and leaves one
            # throttled audit row per outcome). Runs on the daemon thread
            # -> host turn stays zero-blocking.
            self._rebind_main_runtime()
            self._llm_consolidate()
            # EP-2: supersede-candidate confirmation rides the same async
            # consolidation thread (rescore first, then confirm; host turn
            # stays zero-blocking). Fail-soft: any exception here keeps
            # candidates as candidates (retry next boundary) and must never
            # break the rescore's already-done work.
            try:
                self._supersede_confirm_candidates()
            except Exception as e:
                logger.warning(f"FileMem: supersede confirm spawn failed (candidates kept candidate): {e}")
            # EP-3: alias mining rides the same async consolidation thread
            # (rescore -> confirm -> mine; host turn stays zero-blocking).
            # Fail-soft: any exception keeps existing aliases intact (new
            # topics retry next boundary) and must never break the
            # already-done rescore/confirm work.
            try:
                self._mine_alias_candidates()
            except Exception as e:
                logger.warning(f"FileMem: alias mining spawn failed (existing aliases intact): {e}")
            # EP-2 T2: observation synthesis rides the same async
            # consolidation thread (rescore -> confirm -> mine -> observe;
            # host turn stays zero-blocking). Fail-soft: any exception
            # leaves existing observations on disk intact (pending/stale
            # topics retry next boundary) and must never break the
            # already-done rescore/confirm/mine work.
            try:
                self._observe_consolidate()
            except Exception as e:
                logger.warning(f"FileMem: observe spawn failed (existing observations intact): {e}")
            # S3: semantic-merge face (cross-shard same-fact fold, LLM #5 in
            # the 7-segment body). Rides the same async consolidation thread
            # (rescore -> confirm -> mine -> observe -> S3 merge/contradiction/
            # decay/aggregate; host turn stays zero-blocking). Fail-soft: any
            # exception leaves the pool untouched (folded pairs / stale marks
            # retry next boundary); the 4 S3 faces are independent of each
            # other — one's failure never breaks the others or the C sections.
            try:
                self._semantic_merge_consolidate()
            except Exception as e:
                logger.warning(f"FileMem: S3 semantic-merge spawn failed (pairs intact): {e}")
            try:
                self._contradiction_detect()
            except Exception as e:
                logger.warning(f"FileMem: S3 contradiction spawn failed (rows intact): {e}")
            try:
                self._salience_decay_downweight()
            except Exception as e:
                logger.warning(f"FileMem: S3 salience-decay spawn failed (rows intact): {e}")
            try:
                self._aggregate_consolidate()
            except Exception as e:
                logger.warning(f"FileMem: S3 aggregation spawn failed (fragments intact): {e}")
            # EP-2 C slice: bounded auto-archive of the raw_pending quarantine
            # pool (deterministic, zero LLM; out of both the search face and
            # the observe face so nothing synthesizable is lost — the D
            # prefilter already reads only the surviving raw_pending). Fail-soft:
            # any hiccup leaves the pool intact (archive is append-only; auto-
            # archive files are knowledge/archive/raw_pending_auto_* — distinct
            # from cleanup_raw_pending.py's --restore source, so manual recovery).
            try:
                self._auto_archive_raw_pending()
            except Exception as e:
                logger.warning(f"FileMem: raw_pending auto-archive failed (pool intact): {e}")
            # EP-2 prune layer: FIFO retention sweep over the C-slice
            # raw_pending auto-archive (knowledge.archive_prune_days, default
            # 90). Deterministic, zero LLM, pure file ops — it runs even when
            # _llm_ctx is None (the prune is decoupled from the LLM face).
            # Fail-soft: any exception leaves the surviving archive files
            # intact (each pruned file's rows are manifest-appended BEFORE the
            # unlink, so the permanent pruned_index.jsonl is the backstop).
            try:
                self._auto_prune_raw_pending_archive()
            except Exception as e:
                logger.warning(f"FileMem: raw_pending auto-prune failed (archive intact): {e}")
            # S4-T1 ①: physical sweep of EXPIRED auto-cleanup rows out of
            # memories/*.json (O7 bounded-growth countermeasure). The 4h
            # sweeper concept, realized as "run idempotently once per
            # consolidation tick": the active-file > memories_rotate_mb
            # threshold gate makes it a no-op when there is nothing to sweep
            # (idempotent — after a sweep the active file is smaller).
            # Deterministic, zero LLM, pure file ops — rides the daemon
            # thread so the host turn stays zero-blocking. Fail-soft, same
            # segment isolation as the other C sections: any exception here
            # does not break the already-done rescore/confirm/mine/observe/
            # archive/prune work.
            try:
                self.sweep_memories_expired()
            except Exception as e:
                logger.warning(f"FileMem: memories expired-sweep failed (memories intact): {e}")
            # S4-T1 ②: consolidation_log line-cap rotation (deterministic,
            # zero LLM): when the active log exceeds
            # consolidation.log_rotate_lines, the front N-k lines MOVE to
            # consolidation_log.<UTC-ts>.jsonl (move, not delete — the audit
            # chain stays unbroken) and the active file keeps the most
            # recent k lines (consolidation.log_keep_tail_lines). Same flock
            # protocol as the appender -> no torn lines across processes.
            # 0/absent key = rotation disabled (fail-soft: never lose rows).
            try:
                self._rotate_consolidation_log()
            except Exception as e:
                logger.warning(f"FileMem: consolidation log rotation failed (log intact): {e}")
            # S4-T1 ④: episodic shard + sessions/<sid>.jsonl age-cap
            # (deterministic, zero LLM): shards whose month stamp is older
            # than episodic.max_age_days and session traces not written for
            # sessions.max_age_days move to knowledge/archive/ (recoverable —
            # "忘掉≠抹掉"; a manifest row is recorded BEFORE the move).
            # 0/absent = that direction disabled. Bounded-glob: ONLY the
            # episodic/ and sessions/ prefixes are ever touched —
            # knowledge/archive/, memories/, consolidated/ are never
            # touched (same discipline as the prune layer).
            try:
                self._cap_episodic_sessions()
            except Exception as e:
                logger.warning(f"FileMem: episodic/sessions age-cap failed (files intact): {e}")
        if spawn_context_thread is not None:
            # S1b F1 (deepest root cause): spawn_context_thread returns an
            # UNSTARTED thread (host contract — the caller starts it; see the
            # engine's own callers, e.g. agent/credits_tracker.py
            # `spawn_context_thread(...).start()` and memory_manager's
            # `thread = spawn_context_thread(...) ... .start()`). The legacy
            # line created the thread but never started it: a thread that is
            # never .start()ed NEVER runs, so the consolidation tick body
            # (all 7 LLM faces + the C auto-archive/prune sections) never
            # executed in production — the true "3 天 0 tick" root cause.
            # Even a *triggered* spawn (on_pre_compress / on_session_end) was
            # a silent no-op for that reason. .start() is what makes the tick
            # REAL; it is still host-zero-blocking (the body runs on the
            # daemon thread, not the turn thread).
            spawn_context_thread(_run, name=f"filemem-llm-consolidation-{self.session_id}").start()
        else:  # pragma: no cover
            import threading as _th
            _th.Thread(target=_run, daemon=True).start()

    def _write_episodic_entry(self, session_id: str, drafts: list) -> None:
        """B4: shard episodic summaries into episodic/yyyy/mm/{session_id}.jsonl.

        An entry is written only if its salience meets decay.json's
        salience_threshold (B2) — below that it decays away, mirroring
        the human "forgettable" middle layer.
        """
        if not isinstance(self.episodic_dir, Path):
            return
        threshold = float(self._decay.get("salience_threshold", 0.5))
        now = _utcnow()
        shard = self.episodic_dir / now.strftime("%Y") / now.strftime("%m")
        try:
            shard.mkdir(parents=True, exist_ok=True)
            max_sal = max((d.salience for d in drafts), default=0.0)
            entry_content = " | ".join(d.content[:200] for d in drafts[:20])
            # SA2-1: episodic entry carries the event-date stamp extracted from
            # its pooled content (first date wins — entries aggregate up to 20
            # drafts, so this is a best-effort single timestamp; pure regex,
            # zero LLM). Key absent from pre-backfill lines -> pool falls
            # back to created_at (ts).
            entry = {
                "session_id": session_id,
                "ts": now.isoformat(),
                "drafts": len(drafts),
                "max_salience": max_sal,
                "content": entry_content,
                # M4: real per-session salience (was a hardcoded 0.5 stub) so the
                # decay formula has a genuine salience gradient to measure against.
                "salience": round(max_sal, 4) if drafts else 0.0,
                "status": "active",
                # M6 Plan A: source_profile stamped AT WRITE TIME (data-engineer:
                # the decision-level no_agent runner has no ctx, so it can only
                # PROPAGATE this field — it cannot probe or hardcode it). This is
                # the field each profile's consumer hook filters on to consume only
                # its own pending upgrades.
                "source_profile": getattr(self, "source_profile", "default"),
                # SEC-1-1: episodic rows are session-end summaries of THIS
                # session's user-turn drafts (G2 skips foreign authors, the G
                # ingress gate rejects tool-dumps at capture) -> auto-catch
                # 自 user 回合 → user/medium (deterministic door rule, zero
                # LLM). Uniform shape: metadata.origin, like memories rows —
                # consumers (SEC-1-2 gate / backfill) read one field.
                "metadata": {"origin": dict(_EPISODIC_ORIGIN_STAMP)},
            }
            occurred = extract_occurred_at(entry_content) if drafts else None
            if occurred:
                entry["occurred_at"] = occurred
            if drafts and entry["salience"] < threshold:
                entry["status"] = "decayed"
            ep_shard_file = shard / f"{session_id}.jsonl"
            # T5b: shard lock on the episodic append (cross-process consistency
            # for the shared neutral store; single-writer in the common case).
            with self._shard_lock(ep_shard_file):
                with open(ep_shard_file, "a", encoding="utf-8") as f:
                    f.write(json.dumps(entry, ensure_ascii=False) + "\n")
            logger.info(f"FileMem: episodic entry written for {session_id} ({len(drafts)} drafts, status={entry['status']})")
        except Exception as e:
            logger.warning(f"FileMem: episodic write failed: {e}")


# ── Auto-Retrieve Hook ───────────────────────────────────────────────────────────

def _get_cached_provider(session_id: str) -> FileMemProvider:
    """Get or create a cached provider instance for the session."""
    with _cache_lock:
        if session_id not in _provider_cache:
            provider = FileMemProvider()
            # O6 forward-fix: resolve the CURRENT profile's home from the engine's
            # context-local get_hermes_home() (set per-profile via HERMES_HOME
            # override at session start), NOT the hardcoded desktop/default
            # Path.home()/.hermes (which froze source_profile to the launch
            # profile under multiplex). Forward-only: only new instances get the
            # corrected home; no historical memories/*.json row is re-stamped.
            # Graceful fallback: standalone/older interpreters without
            # hermes_constants keep the legacy desktop home (zero-dep, no crash).
            hermes_home = Path.home() / ".hermes"
            try:
                from hermes_constants import get_hermes_home
                resolved = get_hermes_home()
                if resolved:
                    hermes_home = Path(resolved)
            except Exception:
                pass
            provider.initialize(session_id, hermes_home=hermes_home)
            # S1b F3: propagate the module-level host LLM ctx (set at
            # register() time) to the NEW instance — before S1b, every
            # session instance built here kept _llm_ctx None forever, so
            # even a triggered consolidation tick skipped all 7 LLM faces.
            # When _HOST_LLM_CTX is None (standalone, pre-register) this is
            # a no-op: the instance keeps today's exact _llm_ctx-None
            # behavior (7 segments skip, not error).
            provider._llm_ctx = _HOST_LLM_CTX
            # LLM 显式化◎: propagate the host main_runtime snapshot the same
            # way (None in standalone -> instances keep their default None;
            # the LLM faces keep today's exact skip semantics).
            provider._main_runtime = _HOST_MAIN_RUNTIME
            _provider_cache[session_id] = provider
        return _provider_cache[session_id]


def _refresh_provider_llm_ctx(provider: "FileMemProvider") -> None:
    """S1b F3: refresh an instance's host LLM ctx from the module-level
    _HOST_LLM_CTX (set at register() time) — WITHOUT clobbering an already
    bound ctx when the module value is not yet set (standalone / pre-register
    keeps today's exact _llm_ctx=None behavior; the 7 LLM segments skip,
    never error). Call it at each hook face so a ctx bound LATER in the
    process lifetime reaches instances cached before register().

    LLM 显式化◎: the same no-clobber-when-None refresh is applied to the
    host main_runtime snapshot (_HOST_MAIN_RUNTIME -> provider._main_runtime)
    so the runtime face closes the same P2 boundary-face window."""
    host_ctx = _HOST_LLM_CTX
    if host_ctx is not None:
        provider._llm_ctx = host_ctx
    host_runtime = _HOST_MAIN_RUNTIME
    if host_runtime is not None:
        provider._main_runtime = host_runtime


def filemem_auto_retrieve(session_id: str, user_message: str, conversation_history: list,
                              is_first_turn: bool, model: str, platform: str, **kwargs) -> Optional[Dict]:
    """Auto-retrieve relevant memories before LLM call.

    D1 (t_db244983): the native-md drain fires on this SAME pre_llm_call face,
    BEFORE the retrieve — so entries just moved out of MEMORY.md/USER.md into
    the pool are already available to this turn's auto-retrieval (turn_start
    drain -> same-turn recall). The drain is fail-soft and D2-short-circuits to
    a <1ms stat no-op once the md is steady-empty, so it never wedges the
    pre_llm_call host-timeout boundary. Zero NEW hook registration (piggyback)."""
    try:
        # Use cached provider instance (solution 2)
        provider = _get_cached_provider(session_id)
        _refresh_provider_llm_ctx(provider)  # S1b F3

        # Native-md drain first (turn_start): move this profile's native
        # MEMORY.md/USER.md §-entries into the shared pool, then cleanly delete
        # them from the md (D1-D10). Config-gated (native_drain, default on),
        # fail-soft, and D2-short-circuiting — it runs on the hot path only as
        # a cheap stat compare when the md is unchanged.
        if provider._drain_enabled():
            provider.drain_native_md(session_id=session_id)

        context = provider.prefetch(user_message, session_id=session_id)
        if context:
            line_count = len(context.split("\n"))
            logger.info(f"FileMem: injected {line_count} memories for session={session_id}")
            return {"context": f"[记忆上下文]\n{context}\n"}
    except Exception as e:
        logger.debug(f"FileMem: pre_llm_call hook failed: {e}")
    return None


# ── Auto-Catch Hook ──────────────────────────────────────────────────────────────

def filemem_auto_catch(session_id: str, user_message: str, assistant_response: str,
                           conversation_history: list, model: str, platform: str, **kwargs) -> None:
    """Auto-save memories after LLM call."""
    logger.info(f"FileMem: auto_catch fired sid={session_id}")
    try:
        # Use cached provider instance (solution 2)
        provider = _get_cached_provider(session_id)
        _refresh_provider_llm_ctx(provider)  # S1b F3

        # Use last few messages for catch
        messages = conversation_history[-6:] if conversation_history else []
        provider.sync_turn(user_message, assistant_response or "", session_id=session_id, messages=messages)
    except Exception as e:
        logger.warning(f"FileMem: post_llm_call hook failed: {e}")


# ── Plugin Registration ──────────────────────────────────────────────────────────

def register(ctx) -> None:
    """Register filemem as a memory provider with hooks."""
    global _HOST_LLM_CTX
    # Use cached provider for consistency (solution 2)
    provider = _get_cached_provider("default")

    # B3: expose host-owned LLM access to the provider so search mode "model"
    # can route through ctx.llm on the host main-model path (no task key) —
    # kwarg-safe when the provider is used standalone (ctx stays None, model
    # mode degrades to keyword ranking automatically).
    provider._llm_ctx = ctx

    # S1b F3: ALSO record the host ctx at module scope so every session
    # instance newly created by _get_cached_provider (the production trigger
    # face: post_llm_call -> filemem_auto_catch -> _get_cached_provider)
    # inherits it — not just the 'default' instance. This is the fix for the
    # "LLM 绑定断链" root cause (#2): pre-S1b the 'default' instance alone was
    # ever bound, so per-session instances kept _llm_ctx None and all 7 LLM
    # faces silently skipped even when a tick ran. The hooks additionally
    # _refresh_provider_llm_ctx() on every fire (covers instances cached
    # BEFORE register()).
    _HOST_LLM_CTX = ctx

    # LLM 显式化◎ (t_32980f71): capture the host main_runtime snapshot at
    # register time (inside a host turn: the main runtime is already set in
    # the contextvar _RUNTIME_MAIN_CONTEXT). _normalize_main_runtime(None)
    # resolves it -> dict{model, provider, base_url, api_key, api_mode}.
    # Fail-soft: a standalone / non-host environment yields None or an
    # empty dict -> keep _HOST_MAIN_RUNTIME None (the LLM faces keep
    # today's exact _llm_ctx-None skip semantics; nothing errors), and an
    # absent host helper (older build) is a no-op.
    global _HOST_MAIN_RUNTIME
    _HOST_MAIN_RUNTIME = None
    if _normalize_main_runtime is not None:
        try:
            _HOST_MAIN_RUNTIME = _normalize_main_runtime(None) or None
            if _HOST_MAIN_RUNTIME is not None:
                logger.info(
                    "FileMem: captured host main_runtime snapshot "
                    f"(provider={_HOST_MAIN_RUNTIME.get('provider')!r}, "
                    f"model={_HOST_MAIN_RUNTIME.get('model')!r})")
            else:
                logger.info("FileMem: no host main_runtime snapshot "
                            "(standalone / pre-turn) -> LLM faces keep "
                            "skip semantics")
        except Exception as e:
            logger.warning(f"FileMem: main_runtime snapshot failed: {e}")

    # Mirror the B3 _llm_ctx binding: the 'default' instance may have been
    # created/cached BEFORE the snapshot (e.g. an earlier hook face in this
    # process) — it would otherwise keep _main_runtime None. New instances
    # pick the snapshot up in _get_cached_provider; pre-cached ones are
    # covered by the hooks' _refresh_provider_llm_ctx refresh face.
    provider._main_runtime = _HOST_MAIN_RUNTIME

    # P0-1: log source_profile at register time for observability
    sp = getattr(provider, "source_profile", None)
    logger.info(f"FileMem: register() source_profile={sp!r} (hermes_home={getattr(provider, 'hermetis_home', None)!r})")

    # Register as memory provider
    ctx.register_memory_provider(provider)
    logger.info("FileMem: registered memory provider")

    # Register hooks
    ctx.register_hook("pre_llm_call", filemem_auto_retrieve)
    logger.info("Registered pre_llm_call hook (FileMem Auto-Retrieve)")

    ctx.register_hook("post_llm_call", filemem_auto_catch)
    logger.info("Registered post_llm_call hook (FileMem Auto-Catch)")

    # No auxiliary task slot: the host main-model face (agent/auxiliary_client.
    # call_llm) is driven by the explicit main_runtime snapshot captured at
    # register() time (epic card 1) with no task key anywhere -> host main-model
    # route, aligned with the built-in compressor / supercompress pattern
    # (shared host runtime, zero independent provider/model config).

    logger.info("FileMem plugin registered successfully")

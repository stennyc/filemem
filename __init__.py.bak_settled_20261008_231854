    Fails soft: missing/invalid file falls back to hardcoded defaults so a
    bad config never breaks the plugin.
    """
    import json as _json
    global TTL_CONFIG
    path = None
    if hermes_home:
        path = Path(hermes_home) / "plugins" / "filemem" / "decay.json"
    if path is None or not path.exists():
        path = Path(__file__).parent / "decay.json"
    try:
        with open(path, encoding="utf-8") as f:
            data = _json.load(f)
    except Exception as e:
        logger.warning(f"FileMem: decay.json load failed ({e}), using defaults")
        data = {}
    # apply TTL overrides in-place so MemoryItem reads pick them up
    for level, cfg in TTL_CONFIG.items():
        if level in data.get("ttl_days", {}):
            cfg["ttl_days"] = data["ttl_days"][level]
    # merge with defaults so consumers never hit missing keys
    from consolidation import DECAY_DEFAULTS
    merged = dict(DECAY_DEFAULTS)
    for k, v in (data or {}).items():
        merged[k] = v
    return merged


